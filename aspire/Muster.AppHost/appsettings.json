{
  "Azure": {
    "Location": "southcentralus"
  },
  "PersistenceOptions": {
    "UseExisting": false,
    "DatabaseName": "MusterBot",
    "SkuName": "Basic",
    "SkuTier": "Basic",
    "SkuCapacity": 5,
    "BackupStorageRedundancy": "Zone"
  },
  "AppConfigurationOptions": {
    "UseExisting": false,
    "SkuName": "Free",
    "DisableLocalAuth": true,
    "PublicNetworkAccess": "Enabled"
  },
  "AppContainerEnvironmentOptions": {
    "UseExisting": false,
    "PeerTrafficEncryptionEnabled": true,
    "PublicNetworkAccess": "Enabled"
  },
  "ContainerRegistryOptions": {
    "UseExisting": false,
    "Sku": "Basic",
    "IsAnonymousPullEnabled": false,
    "NetworkRuleBypassOption": "AzureServices",
    "PublicNetworkAccess": "Enabled"
  },
  "MessagingOptions": {
    "UseExisting": false,
    "IsZoneRedundant": true,
    "DisableLocalAuth": true,
    "PublicNetworkAccess": "Enabled"
  },
  "KeyVaultOptions": {
    "UseExisting": false,
    "EnableRbacAuthorization": true,
    "EnableSoftDelete": true,
    "SoftDeleteRetentionInDays": 7,
    "EnablePurgeProtection": true,
    "PublicNetworkAccess": "Enabled"
  },
  "StorageOptions": {
    "UseExisting": false,
    "Sku": "StandardGrs",
    "AllowBlobPublicAccess": false,
    "AllowSharedKeyAccess": false,
    "EnableHttpsTrafficOnly": true,
    "MinimumTlsVersion": "TLS1_2",
    "PublicNetworkAccess": "Enabled"
  },
  "ApplicationInsightsOptions": {
    "UseExisting": false
  },
  "LogAnalyticsOptions": {
    "UseExisting": false,
    "Sku": "PerGB2018",
    "RetentionInDays": 30,
    "PublicNetworkAccessForIngestion": "Enabled",
    "PublicNetworkAccessForQuery": "Enabled"
  },
  "SignalROptions": {
    "UseExisting": false,
    "SkuName": "Free_F1",
    "Capacity": 1,
    "PublicNetworkAccess": "Enabled"
  },
  "WebContainerOptions": {
    "Cpu": 0.5,
    "Memory": "1.0Gi",
    "MinReplicas": 1,
    "MaxReplicas": 1,
    "HttpScaleConcurrentRequests": 100,
    "TerminationGracePeriodSeconds": 30
  },
  "BotContainerOptions": {
    "Cpu": 0.25,
    "Memory": "0.5Gi",
    "TerminationGracePeriodSeconds": 60
  },
  "WebCustomDomainOptions": {
    "Domain": "musterbot.com"
  }
}