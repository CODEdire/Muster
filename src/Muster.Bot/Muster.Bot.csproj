<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <UserSecretsId>muster-bot</UserSecretsId>
    <!-- Required for `azd up` / `dotnet publish /t:PublishContainer` to build the bot's image —
         Microsoft.NET.Sdk.Worker doesn't enable the SDK container targets by default the way
         Microsoft.NET.Sdk.Web does. -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetCord" />
    <PackageReference Include="NetCord.Hosting" />
    <PackageReference Include="NetCord.Services" />
    <PackageReference Include="NetCord.Hosting.Services" />
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\aspire\Muster.ServiceDefaults\Muster.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Muster.Infrastructure\Muster.Infrastructure.csproj" />
  </ItemGroup>

</Project>
