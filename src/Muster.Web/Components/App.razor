<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Muster</title>
    <meta name="description" content="Muster — participation tracking for Discord communities." />
    <meta name="theme-color" content="#0b1f48" />
    <link rel="icon" type="image/svg+xml" href="img/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="img/brand/favicon/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="img/brand/favicon/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="img/brand/favicon/favicon-180.png" />
    <link rel="manifest" href="site.webmanifest" />
    <meta property="og:title" content="Muster" />
    <meta property="og:description" content="Participation tracking for Discord communities." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="img/brand/social/og-image-1200.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="img/brand/social/og-image-1200.png" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Muster.Web.styles.css" /> @* Blazor scoped component CSS (*.razor.css bundle) *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/lib/codemirror.min.css" />
    <!-- Apply the saved theme before first paint to avoid a flash of the wrong theme. -->
    <script>
        (function () {
            try {
                var t = localStorage.getItem("muster-theme");
                if (t === "light" || t === "dark") {
                    document.documentElement.setAttribute("data-theme", t);
                }
            } catch (e) { }
        })();
    </script>
    <!-- Browser-zone detector, defined inline (part of the document, never cached as a separate file) so
         interactive components can always localize displayed times to where the viewer actually is. -->
    <script>
        window.musterBrowserTimeZone = function () {
            try { return Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (e) { return ""; }
        };
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes />

    <!-- Interactive-circuit reconnect overlay. blazor.web.js toggles the components-reconnect-* classes on this
         element; the CSS in app.css shows the matching message. Inert for static SSR pages (no circuit). -->
    <div id="components-reconnect-modal" class="reconnect-modal">
        <div class="reconnect-card glass">
            <div class="reconnect-spinner" aria-hidden="true"></div>
            <p class="reconnect-text reconnect-text-show">Connection lost. Reconnecting…</p>
            <p class="reconnect-text reconnect-text-failed">
                Couldn't reconnect.
                <button type="button" class="btn btn-sm" onclick="window.Blazor.reconnect()">Retry</button>
            </p>
            <p class="reconnect-text reconnect-text-rejected">
                This session has expired.
                <button type="button" class="btn btn-sm" onclick="location.reload()">Reload</button>
            </p>
        </div>
    </div>

    <!-- Enhanced navigation/forms over plain HTTP, plus the InteractiveServer circuit (SignalR) for interactive pages. -->
    <script src="_framework/blazor.web.js"></script>
    <script src="js/theme.js"></script>
    <script src="js/timezone.js"></script>
    <script src="js/dialog.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
    <script src="js/quest-form.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/lib/codemirror.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/mode/javascript/javascript.min.js"></script>
    <script src="js/connector-form.js"></script>
    <!-- Re-run the progressive-enhancement scripts after each enhanced navigation. -->
    <script src="js/enhanced-init.js"></script>
</body>

</html>
