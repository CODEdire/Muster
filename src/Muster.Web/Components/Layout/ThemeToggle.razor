<div class="theme-toggle" role="group" aria-label="Theme">
    <button type="button" data-theme-option="system" onclick="musterSetTheme('system')">System</button>
    <button type="button" data-theme-option="light" onclick="musterSetTheme('light')">Light</button>
    <button type="button" data-theme-option="dark" onclick="musterSetTheme('dark')">Dark</button>
</div>
