<div class="theme-toggle" role="group" aria-label="Theme">
    <button type="button" data-theme-option="system" title="System" aria-label="System theme" onclick="musterSetTheme('system')"><span class="material-symbols-outlined">computer</span></button>
    <button type="button" data-theme-option="light" title="Light" aria-label="Light theme" onclick="musterSetTheme('light')"><span class="material-symbols-outlined">light_mode</span></button>
    <button type="button" data-theme-option="dark" title="Dark" aria-label="Dark theme" onclick="musterSetTheme('dark')"><span class="material-symbols-outlined">dark_mode</span></button>
</div>
