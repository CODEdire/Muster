@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IServiceScopeFactory ScopeFactory
@using Microsoft.Extensions.DependencyInjection
@using Muster.Infrastructure.Services.Web

@* Guild-scoped shell: a persistent left sidebar on desktop, a bottom tab bar on mobile.
   Guild id is read from the route URI (layouts don't receive route params); name + admin
   come from the user's guild list. Pages render into the .app-main content column. *@
<div class="guild-shell">
    <aside class="sidebar glass">
        <a class="brand" href="/guilds" aria-label="Muster — all servers">
            <img class="brand-mark-img" src="img/brand/mark/muster-mark.svg" alt="" width="32" height="32" />
            <span class="brand-wordmark">Muster</span>
        </a>

        <div class="nav-label">Server</div>
        <a class="server-card" href="/guilds/@_guildId">
            <span class="server-avatar">@_initials</span>
            <span class="server-name">@_guildName</span>
        </a>

        @foreach (var grp in NavSections)
        {
            <div class="nav-label">@grp.Label</div>
            <nav class="side-nav">
                @foreach (var item in grp.Items)
                {
                    if (item.Href is { } href)
                    {
                        <a href="@href" class="@(IsActive(item.Match) ? "active" : "")">
                            <span class="nav-ico material-symbols-outlined">@item.Icon</span>@item.Label
                        </a>
                    }
                    else
                    {
                        <span class="nav-soon" title="Coming soon">
                            <span class="nav-ico material-symbols-outlined">@item.Icon</span>@item.Label<span class="pill">soon</span>
                        </span>
                    }
                }
            </nav>
        }

        <div class="sidebar-foot">
            <div class="me-card">
                <UserChip Name="@_userName" Handle="@_userHandle" AvatarUrl="@_userAvatar" />
            </div>
            <div class="foot-row"><ThemeToggle /></div>
            <a class="btn btn-ghost btn-sm btn-block" href="/account/logout">Log out</a>
        </div>
    </aside>

    <main class="app-main">
        @Body
    </main>

    <nav class="bottom-tabs glass">
        @foreach (var tab in BottomTabs)
        {
            <a href="@(tab.Href ?? "#")" class="@(tab.Href is not null && IsActive(tab.Match) ? "active" : "") @(tab.Href is null ? "disabled" : "")">
                <span class="tab-ico material-symbols-outlined">@tab.Icon</span>
                <span class="tab-label">@tab.Label</span>
            </a>
        }
    </nav>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ulong _guildId;
    private string _guildName = "Server";
    private string _initials = "··";
    private string _userName = "You";
    private string? _userHandle;
    private string? _userAvatar;

    private sealed record NavItem(string Label, string Icon, string? Href, string Match);
    private sealed record NavSection(string Label, IReadOnlyList<NavItem> Items);

    private IReadOnlyList<NavSection> NavSections
    {
        get
        {
            if (_guildId == 0)
            {
                return [];
            }

            // Three groups: your own surfaces, the shared/community surfaces (with two admin-only views), and the
            // admin tooling/config. Admin-only items render gated as null Href in their natural section so the section
            // collapses cleanly for non-admins.
            var personal = new List<NavItem>
            {
                new("Me", "person", $"/guilds/{_guildId}/me", "/me"),
                new("Wallet", "account_balance_wallet", $"/guilds/{_guildId}/wallet", "/wallet"),
                new("Settings", "settings", $"/guilds/{_guildId}/settings", "/settings"),
            };

            var guild = new List<NavItem>
            {
                new("Leaderboard", "leaderboard", $"/guilds/{_guildId}", "$"),
            };
            // Quests + Shop entries only when the feature gate says they're on for this guild (platform + plan + toggle).
            if (_questsEnabled)
            {
                guild.Add(new("Quests", "swords", $"/guilds/{_guildId}/quests", "/quests"));
            }
            if (_shopEnabled)
            {
                guild.Add(new("Shop", "storefront", $"/guilds/{_guildId}/shop", "/shop"));
            }
            guild.Add(new("Sessions", "schedule", $"/guilds/{_guildId}/guild/tracking/sessions", "/guild/tracking/sessions"));
            // Musters are participant-facing — only show the entry to members who can take part.
            if (_isParticipant)
            {
                guild.Add(new("Musters", "groups", $"/guilds/{_guildId}/guild/musters", "/guild/musters"));
            }
            // Treasury + Participation are read-mostly: economy managers (full) and auditors (ledger only) both qualify.
            if (_isStaff)
            {
                guild.Add(new("Treasury", "account_balance", $"/guilds/{_guildId}/treasury", "/treasury"));
                guild.Add(new("Participation", "trophy", $"/guilds/{_guildId}/participation", "/participation"));
            }

            var management = new List<NavItem>();
            if (_isAdmin)
            {
                management.Add(new("Members", "group", $"/guilds/{_guildId}/members", "/members"));
                management.Add(new("Audit log", "receipt_long", $"/guilds/{_guildId}/audit", "/audit"));
                management.Add(new("Admin", "shield_person", $"/guilds/{_guildId}/admin", "/admin"));
            }

            var sections = new List<NavSection>
            {
                new("Personal", personal),
                new("Guild", guild),
            };
            if (management.Count > 0)
            {
                sections.Add(new("Management", management));
            }

            return sections;
        }
    }

    private IReadOnlyList<NavItem> BottomTabs
    {
        get
        {
            if (_guildId == 0)
            {
                return [];
            }

            var tabs = new List<NavItem> { new("Home", "home", $"/guilds/{_guildId}", "$") };
            if (_questsEnabled)
            {
                tabs.Add(new("Quests", "swords", $"/guilds/{_guildId}/quests", "/quests"));
            }
            tabs.Add(new("Sessions", "schedule", $"/guilds/{_guildId}/guild/tracking/sessions", "/guild/tracking/sessions"));
            tabs.Add(new("You", "person", $"/guilds/{_guildId}/me", "/me"));
            return tabs;
        }
    }

    private bool _isAdmin;
    private bool _isStaff;   // any staff tier (auditor-implied) — may read Treasury / Participation ledgers
    private bool _isParticipant;
    private bool _shopEnabled;
    private bool _questsEnabled;

    protected override async Task OnParametersSetAsync()
    {
        _guildId = ParseGuildId(Nav.Uri);
        if (_guildId == 0 || AuthState is null)
        {
            return;
        }

        var principal = (await AuthState).User;
        var userId = principal.GetDiscordUserId();
        if (userId is null)
        {
            return;
        }

        // Claims always carry the username; the DB profile adds the avatar (and a nicer global name) once synced.
        _userName = principal.DisplayName();

        // Own DI scope so the layout's lookup never contends with the page on the request-scoped DbContext.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var web = scope.ServiceProvider.GetRequiredService<WebGuildService>();

        var guilds = await web.GetGuildsForUserAsync(userId.Value);
        var g = guilds.FirstOrDefault(x => x.GuildId == _guildId);
        if (g is not null)
        {
            _guildName = g.Name;
            _isAdmin = g.IsAdmin;
            _initials = Initials(g.Name);

            var auth = scope.ServiceProvider.GetRequiredService<Muster.Infrastructure.Services.Membership.GuildAuthorizationService>();
            _isParticipant = await auth.IsParticipantAsync(_guildId, userId.Value);
            _isStaff = _isAdmin || await auth.IsAuditorAsync(_guildId, userId.Value);

            var gate = scope.ServiceProvider.GetRequiredService<Muster.Infrastructure.Services.Platform.IFeatureGate>();
            _shopEnabled = await gate.IsEnabledAsync(_guildId, Muster.Contracts.PlatformFeature.Shop);
            _questsEnabled = await gate.IsEnabledAsync(_guildId, Muster.Contracts.PlatformFeature.Quests);
        }

        var profile = await web.GetUserProfileAsync(userId.Value);
        if (profile is not null)
        {
            _userName = profile.Name;
            _userHandle = profile.Username;
            _userAvatar = profile.AvatarUrl;
        }

        // Fall back to the avatar carried on the user's own login claims when the DB row hasn't been synced yet.
        _userAvatar ??= Muster.Infrastructure.Discord.DiscordCdn.AvatarUrl(
            userId.Value, principal.FindFirst("urn:discord:avatar")?.Value);
    }

    /// <summary>Extracts the guild id from a /guilds/{id}/… path; 0 when not on a guild page.</summary>
    private ulong ParseGuildId(string uri)
    {
        var path = new Uri(uri).AbsolutePath.Trim('/');
        var segs = path.Split('/');
        if (segs.Length >= 2 && segs[0] == "guilds" && ulong.TryParse(segs[1], out var id))
        {
            return id;
        }

        return 0;
    }

    /// <summary>"$" matches the guild root exactly; otherwise a trailing path segment match.</summary>
    private bool IsActive(string match)
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        var root = $"/guilds/{_guildId}";
        return match == "$" ? path == root : path.StartsWith(root + match, StringComparison.Ordinal);
    }

    private static string Initials(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0)
        {
            return "··";
        }

        return words.Length == 1
            ? words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant()
            : $"{words[0][0]}{words[1][0]}".ToUpperInvariant();
    }
}
