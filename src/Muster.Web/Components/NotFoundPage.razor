@* Rendered by the Router for unmatched routes. Sets a real 404 status when possible. *@
@using Microsoft.AspNetCore.Http

<PageTitle>Not found — Muster</PageTitle>

<div class="panel glass empty">
    <h1>Page not found</h1>
    <p>That page doesn't exist or has moved.</p>
    <p><a class="btn" href="/">Back to home</a></p>
</div>

@code {
    [CascadingParameter] public HttpContext? Http { get; set; }

    protected override void OnInitialized()
    {
        if (Http is { Response.HasStarted: false } http)
        {
            http.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}
