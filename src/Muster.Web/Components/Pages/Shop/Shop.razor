@page "/guilds/{GuildIdRaw}/shop"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildMemberComponentBase
@implements IDisposable
@inject IServiceScopeFactory Scopes
@using Muster.Contracts
@using Muster.Domain.Entities.Shops
@using Muster.Infrastructure.Commands
@using Muster.Infrastructure.Commands.Shops
@using Muster.Infrastructure.Services.Shops
@using static Muster.Web.Components.Pages.Shop.Core.ShopPresentation

<PageTitle>Shop — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    @if (Message is not null)
    {
        <div class="notice" role="status">
            <span class="material-symbols-outlined notice-icon">info</span>
            <span class="notice-text">@Message</span>
            <button type="button" class="icon-btn notice-close" title="Dismiss" @onclick="() => Message = null"><span class="material-symbols-outlined">close</span></button>
        </div>
    }

    @if (!_shopGate.IsEnabled)
    {
        <FeatureGateNotice Verdict="_shopGate" Feature="The shop" />
    }
    else
    {
    <PageHeader Crumbs="@(new PageHeader.Crumb[] { new("Shop") })">
        <Toolbar>
            <a class="btn btn-ghost btn-sm" href="/guilds/@GuildId/shop/orders?tab=purchases">
                <span class="material-symbols-outlined">shopping_bag</span> Orders
            </a>
            @if (_ownsStore)
            {
                <a class="btn btn-ghost btn-sm" href="/guilds/@GuildId/shop/orders?tab=sales">
                    <span class="material-symbols-outlined">sell</span> Sales
                </a>
            }
            @if (_isManager)
            {
                <a class="btn btn-ghost btn-sm" href="/guilds/@GuildId/shop/orders?tab=disputes">
                    <span class="material-symbols-outlined">gavel</span> Disputes
                </a>
            }
        </Toolbar>
    </PageHeader>

    <TabFrame ActiveId="@CurTab" ActiveIdChanged="OnTab">
        <TabPane Id="listings" Label="Listings" Icon="sell">
            <div class="dg-toolbar">
                <div class="dg-filters">
                    <input type="search" class="dg-search" placeholder="Search items…" @bind="_lSearchBox" @bind:event="oninput" @bind:after="DebouncedListingSearchAsync" />
                    <select class="dg-select" value="@(LCat ?? "")" @onchange="OnListingCategory">
                        <option value="">All categories</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Id">@(ShopIcons.Emoji(cat.Icon) is { } e ? e + " " : "")@cat.Name</option>
                        }
                    </select>
                    @if (_currencies.Count > 1)
                    {
                        <select class="dg-select" value="@(LCur ?? "")" @onchange="OnListingCurrency">
                            <option value="">Any currency</option>
                            @foreach (var c in _currencies) { <option value="@c.Id">@c.Code</option> }
                        </select>
                    }
                    <input type="number" class="dg-search" style="max-width:5.5rem" min="0" placeholder="min" @bind="_lMinBox" @bind:event="oninput" @bind:after="DebouncedPriceAsync" />
                    <input type="number" class="dg-search" style="max-width:5.5rem" min="0" placeholder="max" @bind="_lMaxBox" @bind:event="oninput" @bind:after="DebouncedPriceAsync" />
                    <input type="search" class="dg-search" style="max-width:8rem" placeholder="#tag" @bind="_lTagBox" @bind:event="oninput" @bind:after="DebouncedTagAsync" />
                    <label class="chip" style="display:inline-flex;align-items:center;gap:.35rem;cursor:pointer"><input type="checkbox" checked="@LStock" @onchange="OnListingStock" /> In stock</label>
                    <select class="dg-select" value="@CurLSort" @onchange="OnListingSort">
                        <option value="">Newest</option>
                        <option value="price-asc">Price · low → high</option>
                        <option value="price-desc">Price · high → low</option>
                        <option value="stock">Most stock</option>
                        <option value="name">Name · A → Z</option>
                    </select>
                </div>
                <div class="dg-actions">
                    @ViewToggle(CurLView, v => Go(("lview", v == "tiles" ? null : v)))
                </div>
            </div>

            @if (HasListingFilters)
            {
                <div class="filter-summary">
                    @if (LCat is { Length: > 0 } && CategoryName(LCat) is { } catName) { @FilterChip(catName, () => Go(("lcat", null), ("lpage", null))) }
                    @if (!string.IsNullOrEmpty(LQ)) { @FilterChip($"\"{LQ}\"", () => Go(("lq", null), ("lpage", null))) }
                    @if (!string.IsNullOrEmpty(LTag)) { @FilterChip($"#{LTag}", () => Go(("ltag", null), ("lpage", null))) }
                    @if (LCur is { Length: > 0 } && CurrencyCode(LCur) is { } curCode) { @FilterChip(curCode, () => Go(("lcur", null), ("lpage", null))) }
                    @if (LMin is not null || LMax is not null) { @FilterChip(PriceRangeLabel(LMin, LMax), () => Go(("lmin", null), ("lmax", null), ("lpage", null))) }
                    @if (LStock) { @FilterChip("In stock", () => Go(("lstock", null), ("lpage", null))) }
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearListingFilters">Clear all</button>
                </div>
            }

            @if (CurLView == "grid")
            {
                <div class="dg-scroll">
                    <table class="dg-table">
                        <thead><tr><th>Item</th><th>Store</th><th class="num">Price</th><th>Category</th><th>Seller</th></tr></thead>
                        <tbody>
                            @if (_listings is null || _listings.Items.Count == 0)
                            {
                                <tr class="dg-empty"><td colspan="5">@(_listings is null ? "Loading…" : "No items for sale.")</td></tr>
                            }
                            else
                            {
                                @foreach (var l in _listings.Items)
                                {
                                    <tr>
                                        <td>
                                            <span style="display:inline-flex;align-items:center;gap:.5rem">
                                                @if (l.ThumbKey is { } tk)
                                                {
                                                    <img src="/shop-image/@tk" alt="" style="width:24px;height:24px;border-radius:6px;object-fit:cover;flex:0 0 auto" />
                                                }
                                                else if (ShopIcons.Material(l.CategoryIcon) is { } cmi)
                                                {
                                                    <span class="material-symbols-outlined" style="font-size:20px;opacity:.7">@cmi</span>
                                                }
                                                else
                                                {
                                                    <span class="material-symbols-outlined" style="font-size:20px;opacity:.5">image</span>
                                                }
                                                <a href="@BuildUrl(("item", l.Id.ToString()))">@l.Name</a>
                                            </span>
                                        </td>
                                        <td><a class="chip chip-quest" href="/guilds/@GuildId/shop/store/@l.StoreSlug">@l.StoreName</a></td>
                                        <td class="num">@l.Price @l.CurrencyCode</td>
                                        <td>
                                            @if (l.CategoryName is { } cn)
                                            {
                                                @if (ShopIcons.Material(l.CategoryIcon) is { } cmi) { <span class="material-symbols-outlined" style="vertical-align:-3px;font-size:1rem">@cmi</span> }
                                                @cn
                                            }
                                            else { <span>—</span> }
                                        </td>
                                        <td><UserChip Name="@l.SellerName" AvatarUrl="@l.SellerAvatarUrl" /></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="tabpane-pad">
                    @if (_listings is null || _listings.Items.Count == 0)
                    {
                        <div class="empty">@(_listings is null ? "Loading…" : "No items for sale yet.")</div>
                    }
                    else
                    {
                        <div class="shop-grid">
                            @foreach (var l in _listings.Items)
                            {
                                <ListingCard Listing="l" GuildId="GuildId" ItemHref="@BuildUrl(("item", l.Id.ToString()))" ShowStoreChip="true">
                                    <Trailing>
                                        <UserChip Name="@l.SellerName" AvatarUrl="@l.SellerAvatarUrl" />
                                    </Trailing>
                                </ListingCard>
                            }
                        </div>
                    }
                </div>
            }

            <div class="dg-footer">
                <div class="dg-pager">
                    <button type="button" class="btn btn-ghost btn-sm" disabled="@(CurLPage <= 1)" @onclick='() => Go(("lpage", (CurLPage - 1).ToString()))'>← Prev</button>
                    <span>Page @CurLPage of @Math.Max(_listings?.TotalPages ?? 1, 1) · @(_listings?.Total ?? 0) items</span>
                    <button type="button" class="btn btn-ghost btn-sm" disabled="@(CurLPage >= (_listings?.TotalPages ?? 1))" @onclick='() => Go(("lpage", (CurLPage + 1).ToString()))'>Next →</button>
                </div>
            </div>
        </TabPane>

        <TabPane Id="shops" Label="Shops" Icon="storefront">
            <div class="dg-toolbar">
                <div class="dg-filters">
                    <input type="search" class="dg-search" placeholder="Search shops…" @bind="_sSearchBox" @bind:event="oninput" @bind:after="DebouncedShopSearchAsync" />
                    <select class="dg-select" value="@(SType ?? "")" @onchange="OnShopType">
                        <option value="">All types</option>
                        @foreach (var t in _storeTypes)
                        {
                            <option value="@t.Id">@(ShopIcons.Emoji(t.Icon) is { } e ? e + " " : "")@t.Name</option>
                        }
                    </select>
                    <select class="dg-select" value="@CurSSort" @onchange="OnShopSort">
                        <option value="">Newest</option>
                        <option value="name">Name · A → Z</option>
                        <option value="name-desc">Name · Z → A</option>
                    </select>
                    @if (_isCreator)
                    {
                        <div class="seg" role="group" aria-label="Scope">
                            <button type="button" class="@(CurSScope == "all" ? "active" : "")" @onclick='() => Go(("sscope", null), ("spage", null))'>All</button>
                            <button type="button" class="@(CurSScope == "mine" ? "active" : "")" @onclick='() => Go(("sscope", "mine"), ("spage", null))'>Mine</button>
                        </div>
                    }
                </div>
                <div class="dg-actions">
                    @if (_isCreator)
                    {
                        <button type="button" class="btn btn-sm" disabled="@_busy" @onclick="OpenCreateStore">
                            <span class="material-symbols-outlined">add_business</span> Create shop
                        </button>
                    }
                    @ViewToggle(CurSView, v => Go(("sview", v == "tiles" ? null : v)))
                </div>
            </div>

            @if (CurSView == "grid")
            {
                <div class="dg-scroll">
                    <table class="dg-table">
                        <thead><tr><th>Shop</th><th>Type</th>@if (_isManager) { <th>Owner</th> }<th class="num">Listings</th><th>Status</th><th class="dg-actions-col"></th></tr></thead>
                        <tbody>
                            @if (_stores is null || _stores.Items.Count == 0)
                            {
                                <tr class="dg-empty"><td colspan="6">@(_stores is null ? "Loading…" : "No shops match.")</td></tr>
                            }
                            else
                            {
                                @foreach (var s in _stores.Items)
                                {
                                    <tr>
                                        <td>
                                            <span style="display:inline-flex;align-items:center;gap:.5rem">
                                                @if (s.LogoImageKey is { } lk)
                                                {
                                                    <img src="/shop-image/@lk" alt="" style="width:24px;height:24px;border-radius:6px;object-fit:cover;flex:0 0 auto" />
                                                }
                                                else if (ShopIcons.Material(s.StoreTypeIcon) is { } smi)
                                                {
                                                    <span class="material-symbols-outlined" style="font-size:20px;opacity:.8">@smi</span>
                                                }
                                                <a href="/guilds/@GuildId/shop/store/@s.Slug">@s.Name</a>
                                            </span>
                                        </td>
                                        <td>
                                            @if (s.StoreTypeName is { } tn)
                                            {
                                                @if (ShopIcons.Material(s.StoreTypeIcon) is { } tmi) { <span class="material-symbols-outlined" style="vertical-align:-3px;font-size:1rem">@tmi</span> }
                                                @tn
                                            }
                                            else { <span>—</span> }
                                        </td>
                                        @if (_isManager) { <td><UserChip Name="@s.OwnerName" AvatarUrl="@s.OwnerAvatarUrl" /></td> }
                                        <td class="num">@s.ListingCount</td>
                                        <td><span class="status-dot @(s.Closed ? "is-ended" : "is-active")"></span>@(s.Closed ? "Closed" : "Open")</td>
                                        <td class="dg-actions-col">
                                            <div class="dg-row-actions">
                                                <a class="icon-btn" title="View storefront" href="/guilds/@GuildId/shop/store/@s.Slug"><span class="material-symbols-outlined">storefront</span></a>
                                                @if (CanManage(s))
                                                {
                                                    <a class="icon-btn" title="Edit shop" href="/guilds/@GuildId/shop/stores/@s.Id"><span class="material-symbols-outlined">edit</span></a>
                                                    <button type="button" class="icon-btn danger" title="Delete shop" disabled="@_busy" @onclick="() => DeleteStoreAsync(s.Id, s.Name)"><span class="material-symbols-outlined">delete</span></button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="tabpane-pad">
                    @if (_stores is null || _stores.Items.Count == 0)
                    {
                        <div class="empty">@(_stores is null ? "Loading…" : "No shops yet.")</div>
                    }
                    else
                    {
                        <div class="shop-grid">
                            @foreach (var s in _stores.Items)
                            {
                                <StoreCard Store="s" GuildId="GuildId" CanManage="CanManage(s)" />
                            }
                        </div>
                    }
                </div>
            }

            <div class="dg-footer">
                <div class="dg-pager">
                    <button type="button" class="btn btn-ghost btn-sm" disabled="@(CurSPage <= 1)" @onclick='() => Go(("spage", (CurSPage - 1).ToString()))'>← Prev</button>
                    <span>Page @CurSPage of @Math.Max(_stores?.TotalPages ?? 1, 1) · @(_stores?.Total ?? 0) shops</span>
                    <button type="button" class="btn btn-ghost btn-sm" disabled="@(CurSPage >= (_stores?.TotalPages ?? 1))" @onclick='() => Go(("spage", (CurSPage + 1).ToString()))'>Next →</button>
                </div>
            </div>
        </TabPane>
    </TabFrame>

    @if (ItemId is { } iid)
    {
        <ShopItemModal GuildId="GuildId" ItemId="iid" UserId="UserId" OnClose="CloseItem" OnChanged="OnItemChangedAsync" />
    }

    @if (_showCreateStore)
    {
        <div class="shop-modal-backdrop" @onclick="CloseCreateStore">
            <div class="shop-modal sm" @onclick:stopPropagation="true">
                <button type="button" class="shop-modal-close" title="Close" @onclick="CloseCreateStore"><span class="material-symbols-outlined">close</span></button>
                <div class="shop-modal-body mform">
                    <h2>New shop</h2>
                    <label class="field">
                        <span>Name</span>
                        <input class="dg-search" placeholder="e.g. Quantum Vault" @bind="_newStoreName" @bind:event="oninput" />
                    </label>
                    @if (_storeTypes.Count > 0)
                    {
                        <label class="field">
                            <span>Type</span>
                            <select class="dg-select" @bind="_newStoreType">
                                <option value="">No type</option>
                                @foreach (var t in _storeTypes)
                                {
                                    <option value="@t.Id">@(ShopIcons.Emoji(t.Icon) is { } e ? e + " " : "")@t.Name</option>
                                }
                            </select>
                        </label>
                    }
                    <label class="field">
                        <span>Description <span class="muted">(optional)</span></span>
                        <textarea class="dg-search" rows="2" placeholder="Short tagline for your storefront" @bind="_newStoreDesc" @bind:event="oninput"></textarea>
                    </label>
                    @if (_isManager)
                    {
                        <label class="field" style="flex-direction:row;align-items:center;gap:.5rem">
                            <input type="checkbox" @bind="_newStoreGuild" />
                            <span>Guild shop <span class="muted">— run by the guild; purchases burn the buyer's coins (no seller paid, no ratings/offers)</span></span>
                        </label>
                    }
                    <div style="display:flex;gap:.5rem;justify-content:flex-end;flex-wrap:wrap;margin-top:.3rem">
                        <button type="button" class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="CloseCreateStore">Cancel</button>
                        <button type="button" class="btn btn-ghost btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_newStoreName))" @onclick="() => CreateStoreAsync(thenEdit: true)">
                            <span class="material-symbols-outlined">tune</span> Create &amp; edit
                        </button>
                        <button type="button" class="btn btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_newStoreName))" @onclick="() => CreateStoreAsync(thenEdit: false)">
                            <span class="material-symbols-outlined">add_business</span> Create
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    }
}

@code {
    // Razor render-fragment helpers (markup templates) stay in the .razor; the rest of the component lives in the
    // code-behind partial.
    private RenderFragment ViewToggle(string current, Action<string> set) =>@<text>
        <div class="seg" role="group" aria-label="View">
            <button type="button" class="@(current == "tiles" ? "active" : "")" title="Tiles" @onclick='() => set("tiles")'><span class="material-symbols-outlined">grid_view</span></button>
            <button type="button" class="@(current == "grid" ? "active" : "")" title="Grid" @onclick='() => set("grid")'><span class="material-symbols-outlined">view_list</span></button>
        </div>
    </text>;

    private RenderFragment FilterChip(string text, Action onClear) => @<text>
        <span class="chip filter-chip">@text <button type="button" class="filter-chip-x" title="Remove" @onclick="onClear">×</button></span>
    </text>;
}
