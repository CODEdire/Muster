@page "/guilds/{GuildIdRaw}/shop/orders/{OrderId:guid}"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildMemberComponentBase
@inject IServiceScopeFactory Scopes
@using Microsoft.AspNetCore.Components.Forms
@using Muster.Contracts
@using Muster.Infrastructure.Commands
@using Muster.Infrastructure.Commands.Shops
@using Muster.Infrastructure.Services.Shops

<PageTitle>Receipt — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    @if (!_shopGate.CanEnable)
    {
        @* Wind-down surface: only a platform/plan block hides it; a guild that merely turned the market off keeps
           access so the order can still be confirmed / disputed / arbitrated. *@
        <FeatureGateNotice Verdict="_shopGate" Feature="The shop" />
    }
    else if (_order is null)
    {
        <div class="panel glass empty">That order couldn't be found. <a href="/guilds/@GuildId/shop/orders">Back to orders</a>.</div>
    }
    else if (!_canView)
    {
        <div class="panel glass empty">This receipt is private to the buyer and seller.</div>
    }
    else
    {
        <PageHeader Crumbs="@(new PageHeader.Crumb[] { new("Shop", $"/guilds/{GuildId}/shop"), new("Orders", $"/guilds/{GuildId}/shop/orders"), new("Receipt") })"
                    Subtitle="@($"Order {ShortId}")" />

        @if (Message is not null)
        {
            <div class="notice" role="status">
                <span class="material-symbols-outlined notice-icon">info</span>
                <span class="notice-text">@Message</span>
                <button type="button" class="icon-btn notice-close" title="Dismiss" @onclick="() => Message = null"><span class="material-symbols-outlined">close</span></button>
            </div>
        }

        <div class="panel glass">
            <div class="receipt-hero">
                <div class="receipt-thumb @(_order.ThumbKey is null ? "placeholder" : "")">
                    @if (_order.ThumbKey is { } tk)
                    {
                        <img src="/shop-image/@tk" alt="@_order.ItemName" />
                    }
                    else if (ShopIcons.Material(_order.CategoryIcon) is { } cmi)
                    {
                        <span class="material-symbols-outlined">@cmi</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined">inventory_2</span>
                    }
                </div>
                <div class="receipt-ident">
                    <div class="receipt-title-row">
                        <h2>@_order.ItemName</h2>
                        <span class="chip @StatusChip(_order.Status)">@_order.Status</span>
                    </div>
                    <div class="receipt-chips">
                        @if (_order.StoreName is { } sn)
                        {
                            <a class="chip chip-type" href="/guilds/@GuildId/shop/store/@_order.StoreSlug">
                                <span class="material-symbols-outlined">storefront</span> @sn
                            </a>
                        }
                        @if (_order.CategoryName is { } cn)
                        {
                            <span class="chip">@if (ShopIcons.Material(_order.CategoryIcon) is { } ci) { <span class="material-symbols-outlined">@ci</span> } @cn</span>
                        }
                        @if (_order.Quantity > 1) { <span class="chip">×@_order.Quantity</span> }
                    </div>
                </div>
            </div>

            <div class="receipt-parties">
                <div class="receipt-party">
                    <span class="lbl">Buyer</span>
                    <UserChip Name="@_order.BuyerName" AvatarUrl="@_order.BuyerAvatarUrl" />
                    @if (_order.BuyerRatingCount > 0) { <span class="rep-chip">★ @_order.BuyerRatingAvg.ToString("0.0") (@_order.BuyerRatingCount)</span> }
                </div>
                <div class="receipt-party">
                    <span class="lbl">Seller</span>
                    <UserChip Name="@_order.SellerName" AvatarUrl="@_order.SellerAvatarUrl" />
                    @if (_order.SellerRatingCount > 0) { <span class="rep-chip">★ @_order.SellerRatingAvg.ToString("0.0") (@_order.SellerRatingCount)</span> }
                </div>
            </div>

            <dl class="receipt-lines">
                <div><dt>Unit price</dt><dd>@_order.UnitPrice @_order.CurrencyCode</dd></div>
                <div><dt>Quantity</dt><dd>@_order.Quantity</dd></div>
                <div class="receipt-total"><dt>Total paid</dt><dd>@_order.Amount @_order.CurrencyCode</dd></div>
                @if (_order.Status == ShopOrderStatus.Settled)
                {
                    <div><dt>Commission (burned)</dt><dd>−@_order.FeeAmount @_order.CurrencyCode</dd></div>
                    <div><dt>Net to seller</dt><dd>@_order.Net @_order.CurrencyCode</dd></div>
                }
            </dl>

            <div class="receipt-timeline">
                <div class="rt-step done"><span class="material-symbols-outlined">shopping_cart</span> Ordered · <LocalTime Value="_order.CreatedAt" Zone="@_zoneId" /></div>
                @if (_order.DeliveredAt is { } d)
                {
                    <div class="rt-step done"><span class="material-symbols-outlined">local_shipping</span> Marked delivered · <LocalTime Value="d" Zone="@_zoneId" /></div>
                }
                @if (_order.SettledAt is { } st)
                {
                    <div class="rt-step done"><span class="material-symbols-outlined">paid</span> Settled · <LocalTime Value="st" Zone="@_zoneId" /></div>
                }
                else if (_order.Status == ShopOrderStatus.Cancelled)
                {
                    <div class="rt-step"><span class="material-symbols-outlined">undo</span> Cancelled — refunded to buyer</div>
                }
                else if (_order.Status == ShopOrderStatus.Refunded)
                {
                    <div class="rt-step"><span class="material-symbols-outlined">undo</span> Refunded to buyer</div>
                }
                else if (_order.Status == ShopOrderStatus.Disputed)
                {
                    <div class="rt-step"><span class="material-symbols-outlined">gavel</span> Disputed — awaiting resolution</div>
                }
                else
                {
                    @if (_order.TwoStepDelivery && _order.Status == ShopOrderStatus.PendingDelivery)
                    {
                        <div class="rt-step pending"><span class="material-symbols-outlined">local_shipping</span> Awaiting delivery from the seller</div>
                    }
                    <div class="rt-step pending">
                        <span class="material-symbols-outlined">hourglass_top</span> Awaiting buyer confirmation
                        @if (_order.AutoSettleAt is { } a) { <span>· auto-settles <LocalTime Value="a" Zone="@_zoneId" /></span> }
                    </div>
                }
            </div>

            @if (_order.Status == ShopOrderStatus.OfferPending)
            {
                <div class="receipt-section">
                    <h3 style="margin:0 0 .35rem"><span class="material-symbols-outlined" style="vertical-align:-4px">gavel</span> Offer in negotiation</h3>
                    <p class="subtitle" style="margin:0 0 .5rem">
                        Current price: <b>@_order.Amount @_order.CurrencyCode</b> ·
                        @(_order.OfferProposedBy == ShopOfferParty.Buyer ? "buyer's offer" : "seller's counter")
                        @if (_order.OfferExpiresAt is { } oe) { <span>· expires <LocalTime Value="oe" Zone="@_zoneId" /></span> }
                    </p>
                    @if (CanRespond)
                    {
                        <div class="btn-row">
                            <button class="btn btn-sm success" disabled="@_busy" @onclick="AcceptOfferAsync">
                                <span class="material-symbols-outlined">check_circle</span> Accept @_order.Amount @_order.CurrencyCode
                            </button>
                            <input type="number" min="1" placeholder="counter price" @bind="_counterAmount" style="max-width:9rem" />
                            <button class="btn btn-sm" disabled="@(_busy || _counterAmount <= 0)" @onclick="CounterAsync">
                                <span class="material-symbols-outlined">swap_horiz</span> Counter
                            </button>
                        </div>
                        @if (_order.MinPrice > 0 || _order.MaxPrice > 0)
                        {
                            <p class="hint" style="margin:.4rem 0 0">
                                Allowed price:
                                @(_order.MinPrice > 0 ? $"{_order.MinPrice}" : "0")@(_order.MaxPrice > 0 ? $"–{_order.MaxPrice}" : "+") @_order.CurrencyCode
                            </p>
                        }
                    }
                    else
                    {
                        <p class="subtitle" style="margin:0">Waiting for the @(_order.OfferProposedBy == ShopOfferParty.Buyer ? "seller" : "buyer")…</p>
                    }
                    @if (_isBuyer || _isSeller || _isManager)
                    {
                        <div class="btn-row" style="margin-top:.5rem">
                            <button class="btn btn-ghost btn-sm danger" disabled="@_busy" @onclick="DeclineOfferAsync">End offer</button>
                        </div>
                    }
                </div>
            }

            @if (_order.Status == ShopOrderStatus.Disputed)
            {
                <div class="receipt-section">
                    <h3 style="margin:0 0 .35rem"><span class="material-symbols-outlined" style="vertical-align:-4px">gavel</span> Dispute</h3>
                    <p class="subtitle" style="margin:0 0 .5rem">
                        Raised by @(_order.DisputedBy == _order.BuyerId ? _order.BuyerName : _order.SellerName)
                        @if (_order.DisputeRaisedAt is { } dr) { <span>· <LocalTime Value="dr" Zone="@_zoneId" /></span> }
                        @if (_order.DisputeAutoResolveAt is { } dar) { <span>· auto-resolves <LocalTime Value="dar" Zone="@_zoneId" /></span> }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_order.DisputeReason))
                    {
                        <p style="margin:0 0 .5rem">@_order.DisputeReason</p>
                    }
                    @if (_order.DisputeEvidenceKey is { } ek)
                    {
                        <img src="/shop-image/@ek" alt="Evidence" style="max-width:100%;max-height:240px;border-radius:8px" />
                    }
                    @if (_isManager)
                    {
                        <div class="btn-row" style="margin-top:.75rem">
                            <button class="btn btn-sm success" disabled="@_busy" @onclick="() => ArbitrateAsync(true)">
                                <span class="material-symbols-outlined">paid</span> Pay seller
                            </button>
                            <button class="btn btn-sm warn" disabled="@_busy" @onclick="() => ArbitrateAsync(false)">
                                <span class="material-symbols-outlined">undo</span> Refund buyer
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="subtitle" style="margin:.5rem 0 0">A shop manager will resolve this.</p>
                    }
                </div>
            }

            @if (_order.Status == ShopOrderStatus.Settled && _order.RatingsEnabled && (_isBuyer || _isSeller || _isManager))
            {
                <div class="receipt-section">
                    <h3 style="margin:0 0 .5rem"><span class="material-symbols-outlined" style="vertical-align:-4px">star</span> Ratings</h3>

                    @if (_ratings?.Mine is { } mine)
                    {
                        <p class="subtitle" style="margin:0 0 .5rem">
                            You rated the @(_isBuyer ? "seller" : "buyer"): @Stars(mine.Stars)
                            @if (!string.IsNullOrWhiteSpace(mine.Comment)) { <span>— @mine.Comment</span> }
                        </p>
                    }
                    else if (CanRate)
                    {
                        <div class="mform">
                            <div class="field span2">
                                <label>Rate the @(_isBuyer ? "seller" : "buyer")</label>
                                <div class="star-pick">
                                    @for (var n = 1; n <= 5; n++)
                                    {
                                        var v = n;
                                        <button type="button" class="star-btn @(_rateStars >= v ? "on" : "")" @onclick="() => _rateStars = v" title="@v">
                                            <span class="material-symbols-outlined">star</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="field span2">
                                <label>Comment (optional)</label>
                                <textarea rows="2" maxlength="1000" @bind="_rateComment" placeholder="How did it go?"></textarea>
                            </div>
                        </div>
                        <div class="btn-row" style="margin-top:.5rem">
                            <button class="btn btn-sm" disabled="@(_busy || _rateStars < 1)" @onclick="SubmitRatingAsync">
                                <span class="material-symbols-outlined">send</span> Submit rating
                            </button>
                        </div>
                        <p class="hint" style="margin:.4rem 0 0">
                            @if (_order.RatingWindowClosesAt is { } w)
                            {
                                <text>Hidden until both of you rate, or the window closes <LocalTime Value="w" Zone="@_zoneId" />.</text>
                            }
                            else
                            {
                                <text>Hidden until both of you rate.</text>
                            }
                        </p>
                    }
                    else if (_order.RatingsClosed)
                    {
                        <p class="subtitle" style="margin:0 0 .5rem">The rating window has closed.</p>
                    }

                    @if (_ratings?.Counterparty is { } cp)
                    {
                        <p class="subtitle" style="margin:.25rem 0 0">
                            The @(cp.Role == RatingRole.Provider ? "seller" : "buyer") was rated: @Stars(cp.Stars)
                            @if (!string.IsNullOrWhiteSpace(cp.Comment)) { <span>— @cp.Comment</span> }
                            @if (_isManager)
                            {
                                <button class="btn btn-ghost btn-sm danger" disabled="@_busy" style="margin-left:.5rem" @onclick="() => HideRatingAsync(cp.Id)">Hide</button>
                            }
                        </p>
                    }
                    else if (_ratings?.Mine is not null)
                    {
                        <p class="subtitle" style="margin:.25rem 0 0">The other party's rating stays hidden until they rate@(_order.RatingWindowClosesAt is not null ? " or the window closes." : ".")</p>
                    }
                </div>
            }

            @if (_showDispute && IsPending && (_isBuyer || _isSeller))
            {
                <div class="receipt-section">
                    <div class="mform">
                        <div class="field span2">
                            <label>What's wrong?</label>
                            <textarea rows="3" maxlength="1000" @bind="_disputeReason" placeholder="Describe the problem for the shop manager."></textarea>
                        </div>
                        @if (_imagesAvailable)
                        {
                            <div class="field span2">
                                <label>Evidence (optional)</label>
                                @if (_disputeEvidence is not null) { <span class="hint">Image attached ✓</span> }
                                <InputFile OnChange="OnEvidenceSelectedAsync" accept="image/*" />
                                @if (_uploading) { <span class="hint">Uploading…</span> }
                            </div>
                        }
                    </div>
                    <div class="btn-row" style="margin-top:.5rem">
                        <button class="btn btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_disputeReason))" @onclick="SubmitDisputeAsync">Submit dispute</button>
                        <button class="btn btn-ghost btn-sm" @onclick="() => _showDispute = false">Cancel</button>
                    </div>
                </div>
            }

            <div class="action-bar">
                <div class="action-right">
                    @if (_isBuyer && CanConfirm)
                    {
                        <button class="btn btn-sm success" disabled="@_busy" @onclick="ConfirmAsync">
                            <span class="material-symbols-outlined">check_circle</span> Confirm receipt
                        </button>
                    }
                    @if ((_isSeller || _isManager) && _order.TwoStepDelivery && _order.Status == ShopOrderStatus.PendingDelivery)
                    {
                        <button class="btn btn-sm" disabled="@_busy" @onclick="MarkDeliveredAsync">
                            <span class="material-symbols-outlined">local_shipping</span> Mark delivered
                        </button>
                    }
                    @if ((_isSeller || _isManager) && IsPending)
                    {
                        <button class="btn btn-sm danger" disabled="@_busy" @onclick="CancelAsync">
                            <span class="material-symbols-outlined">undo</span> Cancel &amp; refund
                        </button>
                    }
                    @if ((_isBuyer || _isSeller) && IsPending && !_showDispute)
                    {
                        <button class="btn btn-ghost btn-sm" @onclick="() => _showDispute = true">
                            <span class="material-symbols-outlined">gavel</span> Dispute
                        </button>
                    }
                    @if (_order.ListingAvailable)
                    {
                        <a class="btn btn-ghost btn-sm" href="@(_order.StoreSlug is { } vs ? $"/guilds/{GuildId}/shop/store/{vs}?item={_order.ListingId}" : $"/guilds/{GuildId}/shop/listing/{_order.ListingId}")">
                            <span class="material-symbols-outlined">visibility</span> View item
                        </a>
                    }
                    <a class="btn btn-ghost btn-sm" href="/guilds/@GuildId/wallet">View in wallet</a>
                </div>
            </div>
        </div>
    }
}
