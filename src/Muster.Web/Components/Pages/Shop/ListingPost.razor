@page "/guilds/{GuildIdRaw}/shop/stores/{StoreId:guid}/new"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildMemberComponentBase
@inject IServiceScopeFactory Scopes
@inject Microsoft.Extensions.Options.IOptions<ShopImageOptions> ImgOpt
@using Microsoft.AspNetCore.Components.Forms
@using Muster.Contracts
@using Muster.Domain.Entities.Shops
@using Muster.Infrastructure.Commands
@using Muster.Infrastructure.Commands.Shops
@using Muster.Infrastructure.Services.Shops

<PageTitle>New listing — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready && !_shopGate.IsEnabled)
{
    <FeatureGateNotice Verdict="_shopGate" Feature="The shop" />
}
else if (State == AccessState.Ready)
{
    <PageHeader Crumbs="@Crumbs" Subtitle="List an item for sale.">
        <Toolbar>
            <a class="btn btn-sm btn-ghost" href="@CancelHref">Cancel</a>
            <button type="button" class="btn btn-sm" disabled="@_busy" @onclick="SubmitAsync">
                <span class="material-symbols-outlined">sell</span> List item
            </button>
        </Toolbar>
    </PageHeader>

    @if (Message is not null)
    {
        <div class="notice" role="status"><span class="material-symbols-outlined notice-icon">info</span><span class="notice-text">@Message</span></div>
    }

    <div class="panel glass">
        <div class="mform">
            <div class="field span2">
                <label>Name</label>
                <input @bind="_name" maxlength="120" />
            </div>
            <div class="field span2">
                <label>Description</label>
                <MarkdownEditor @bind-Value="_description" Rows="4" MaxLength="2000"
                                Placeholder="Describe the item. Supports Discord markdown." />
            </div>
            <div class="field">
                <label>Price</label>
                <input type="number" min="1" @bind="_price" />
            </div>
            <div class="field">
                <label>Currency</label>
                <select @bind="_currency">
                    @foreach (var c in _currencies)
                    {
                        <option value="@c.Code">@c.Code — @c.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Quantity</label>
                <input type="number" min="1" @bind="_quantity" />
            </div>
            <div class="field">
                <label>Category</label>
                <select @bind="_categoryId">
                    <option value="">None</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@(ShopIcons.Emoji(cat.Icon) is { } e ? e + " " : "")@cat.Name</option>
                    }
                </select>
            </div>
            <div class="field span2">
                <label>Tags</label>
                <TagsEditor @bind-Tags="_tags" MaxTags="8" />
            </div>
            <div class="field span2"><label class="checkbox"><input type="checkbox" @bind="_acceptsOffers" /> Accept price offers on this listing</label></div>
            @if (_imagesAvailable)
            {
                <div class="field span2">
                    <label>Image</label>
                    @if (_imageKey is not null)
                    {
                        <img src="/shop-image/@_imageKey" alt="" style="display:block;max-height:140px;border-radius:8px;margin-bottom:.4rem" />
                        <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _imageKey = null"><span class="material-symbols-outlined">delete</span> Remove image</button>
                    }
                    <InputFile OnChange="OnImageSelectedAsync" accept="image/*" />
                    @if (_uploading) { <span class="hint">Uploading…</span> }
                    @if (_imageError is { } err) { <span class="hint" style="color:var(--danger)">@err</span> }
                    <span class="hint">@ImgOpt.Value.Describe(ShopImageKind.Listing)</span>
                </div>
            }
        </div>
    </div>
}
