@page "/guilds/{GuildIdRaw}/management/shop"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildAdminComponentBase
@implements IDisposable
@inject GuildShopSettingsService SettingsStore
@inject Muster.Web.GuildChannelOptions Channels
@inject IServiceScopeFactory Scopes
@using Muster.Contracts
@using Muster.Domain.Entities.Guilds
@using Muster.Infrastructure.Services.Shops

<PageTitle>Shop settings — Muster</PageTitle>

@if (State == AccessState.NeedLogin)
{
    <div class="panel glass empty">Please <a href="/account/login">log in</a>.</div>
}
else if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <PageHeader Crumbs="@(new PageHeader.Crumb[] { new("Admin", $"/guilds/{GuildId}/admin"), new("Shop settings") })"
                Subtitle="Marketplace rules and limits. Changes save automatically." />

    @* Master switch — sits above the toolbar. Disabled with a reason when a higher layer (platform kill-switch /
       plan) blocks the shop, since the per-guild toggle can't make it active in that case. *@
    <div class="shop-master-switch">
        <label class="checkbox" style="margin:0">
            <input type="checkbox" @bind="_s.PlayerMarketEnabled" @bind:after="ScheduleSave" disabled="@_platformBlocked" />
            <strong>Player marketplace enabled</strong>
        </label>
        @if (_platformBlocked)
        {
            <span class="chip" style="background:color-mix(in srgb, var(--danger) 16%, transparent);color:var(--danger)">
                <span class="material-symbols-outlined" style="vertical-align:-3px;font-size:1rem">lock</span> @_platformReason
            </span>
        }
    </div>

    <div class="dg-toolbar">
        <div class="dg-actions">
            <a class="btn btn-sm btn-ghost @(ConfigLocked ? "is-disabled" : null)" href="@(ConfigLocked ? null : $"/guilds/{GuildId}/management/shop/categories")" aria-disabled="@ConfigLocked">
                <span class="material-symbols-outlined">category</span> Manage categories
            </a>
            <a class="btn btn-sm btn-ghost @(ConfigLocked ? "is-disabled" : null)" href="@(ConfigLocked ? null : $"/guilds/{GuildId}/management/shop/store-types")" aria-disabled="@ConfigLocked">
                <span class="material-symbols-outlined">storefront</span> Manage store types
            </a>
            @if (_save != SaveStatus.None)
            {
                <span class="save-pill is-@_save.ToString().ToLowerInvariant()">
                    <span class="material-symbols-outlined">@(_save switch { SaveStatus.Saving => "sync", SaveStatus.Saved => "check_circle", _ => "error" })</span>
                    @(_save switch { SaveStatus.Saving => "Saving…", SaveStatus.Saved => "Saved", _ => _saveMsg ?? "Error" })
                </span>
            }
        </div>
    </div>

    @if (ConfigLocked)
    {
        <div class="panel glass empty">
            <span class="material-symbols-outlined" style="font-size:2.4rem;opacity:.5">@(_platformBlocked ? "lock" : "storefront")</span>
            <p>@(_platformBlocked
                ? $"The shop is unavailable ({_platformReason?.ToLowerInvariant()}). It can't be configured until that's resolved."
                : "Enable the player marketplace above to configure it.")</p>
        </div>
    }
    else
    {
    <Accordion SingleOpen="true">
        <AccordionPane Title="Marketplace" Icon="tune" Open="true" Summary="@($"{(_s.PlayerMarketEnabled ? "On" : "Off")} · {_s.CommissionBps / 100.0:0.##}% commission")">
            <div class="mform">
                <div class="field"><label class="checkbox"><input type="checkbox" @bind="_s.OffersEnabled" @bind:after="ScheduleSave" /> Allow offers / counteroffers</label></div>
                <div class="field"><label class="checkbox"><input type="checkbox" @bind="_s.TwoStepDelivery" @bind:after="ScheduleSave" /> Two-step delivery (seller marks delivered)</label></div>
                <div class="field"><label class="checkbox"><input type="checkbox" @bind="_s.RatingsEnabled" @bind:after="ScheduleSave" /> Ratings enabled</label></div>
                <div class="field"><label class="checkbox"><input type="checkbox" @bind="_s.PlayerTagsEnabled" @bind:after="ScheduleSave" /> Player tags enabled</label></div>
                <div class="field span2"><label class="checkbox"><input type="checkbox" @bind="_s.RequireCategory" @bind:after="ScheduleSave" /> Require a category on every listing</label></div>
            </div>
        </AccordionPane>

        <AccordionPane Title="Limits" Icon="speed" Summary="@($"{_s.MaxStoresPerSeller} stores · {_s.MaxActiveListingsPerSeller} listings / seller")">
            <p class="subtitle">0 = unlimited.</p>
            <div class="mform">
                <div class="field"><label>Max stores per seller</label><input type="number" min="0" @bind="_s.MaxStoresPerSeller" @bind:after="ScheduleSave" /></div>
                <div class="field"><label>Max active listings per seller</label><input type="number" min="0" @bind="_s.MaxActiveListingsPerSeller" @bind:after="ScheduleSave" /></div>
                <div class="field"><label>Max open offers per buyer</label><input type="number" min="0" @bind="_s.MaxOpenOffersPerBuyer" @bind:after="ScheduleSave" /></div>
                <div class="field"><label>Max tags per listing</label><input type="number" min="0" @bind="_s.MaxTagsPerListing" @bind:after="ScheduleSave" /></div>
                <div class="field"><label>Max featured per store</label><input type="number" min="0" @bind="_s.MaxFeaturedPerStore" @bind:after="ScheduleSave" /><span class="hint">0 = featuring off.</span></div>
            </div>
        </AccordionPane>

        <AccordionPane Title="Economy" Icon="payments" Summary="@($"{_s.CommissionBps / 100.0:0.##}% burned · floor {_s.MinPrice}")">
            <div class="mform">
                <div class="field"><label>Commission (basis points)</label><input type="number" min="0" max="10000" @bind="_s.CommissionBps" @bind:after="ScheduleSave" /><span class="hint">Burned on each sale. 250 = 2.5%.</span></div>
                <div class="field"><label>Minimum price</label><input type="number" min="0" @bind="_s.MinPrice" @bind:after="ScheduleSave" /><span class="hint">0 = no floor.</span></div>
                <div class="field"><label>Maximum price</label><input type="number" min="0" @bind="_s.MaxPrice" @bind:after="ScheduleSave" /><span class="hint">0 = no ceiling.</span></div>
                <div class="field"><label>Featured listing fee</label><input type="number" min="0" @bind="_s.FeaturedListingFee" @bind:after="ScheduleSave" /><span class="hint">Burned, in the listing's currency. 0 = free.</span></div>
                <div class="field span2">
                    <label>Allowed currencies</label>
                    @if (_currencies.Count == 0)
                    {
                        <span class="hint">No spendable currencies configured.</span>
                    }
                    else
                    {
                        <div style="display:flex;flex-wrap:wrap;gap:.75rem">
                            @foreach (var c in _currencies)
                            {
                                <label class="checkbox"><input type="checkbox" checked="@_allowed.Contains(c.Id)" @onchange="e => ToggleCurrency(c.Id, e)" /> @c.Code</label>
                            }
                        </div>
                        <span class="hint">None selected = any spendable currency is allowed.</span>
                    }
                </div>
            </div>
        </AccordionPane>

        <AccordionPane Title="Timers" Icon="schedule" Summary="@($"confirm {_s.DeliveryConfirmTimeoutHours}h · dispute {_s.DisputeTimeoutHours}h")">
            <div class="mform">
                <div class="field"><label>Delivery confirm timeout (hours)</label><input type="number" min="0" @bind="_s.DeliveryConfirmTimeoutHours" @bind:after="ScheduleSave" /></div>
                <div class="field"><label>Undelivered timeout (hours)</label><input type="number" min="0" @bind="_s.UndeliveredTimeoutHours" @bind:after="ScheduleSave" /><span class="hint">Two-step only. 0 = never auto-cancel.</span></div>
                <div class="field"><label>Dispute timeout (hours)</label><input type="number" min="0" @bind="_s.DisputeTimeoutHours" @bind:after="ScheduleSave" /></div>
                <div class="field"><label>Offer expiry (hours)</label><input type="number" min="0" @bind="_s.OfferExpiryHours" @bind:after="ScheduleSave" /></div>
                <div class="field"><label>Listing default expiry (days)</label><input type="number" min="0" @bind="_s.ListingDefaultExpiryDays" @bind:after="ScheduleSave" /><span class="hint">0 = never.</span></div>
                <div class="field"><label>Listing cooldown (minutes)</label><input type="number" min="0" @bind="_s.ListingCooldownMinutes" @bind:after="ScheduleSave" /></div>
                <div class="field"><label>Rating window (hours)</label><input type="number" min="0" @bind="_s.RatingWindowHours" @bind:after="ScheduleSave" /></div>
                <div class="field"><label>Featured duration (hours)</label><input type="number" min="0" @bind="_s.FeaturedDurationHours" @bind:after="ScheduleSave" /></div>
            </div>
        </AccordionPane>

        <AccordionPane Title="Channels" Icon="forum" Summary="Board + moderation channels">
            <div class="mform">
                <div class="field"><label>Shop board channel</label>
                    <select @bind="_s.ShopChannelId" @bind:after="ScheduleSave">
                        <option value="0">— none —</option>
                        @foreach (var c in _chat) { <option value="@c.Id">#@c.Name</option> }
                    </select>
                </div>
                <div class="field"><label>Moderation / dispute channel</label>
                    <select @bind="_s.ShopModChannelId" @bind:after="ScheduleSave">
                        <option value="0">— none —</option>
                        @foreach (var c in _chat) { <option value="@c.Id">#@c.Name</option> }
                    </select>
                </div>
                <div class="field span2">
                    <button type="button" class="btn btn-sm" @onclick="ResyncAsync"><span class="material-symbols-outlined">sync</span> Resync shop cards</button>
                    <span class="hint">Re-post featured listing cards to the board channel. Runs automatically when you change the channel.</span>
                </div>
            </div>
        </AccordionPane>
    </Accordion>
    }
}
