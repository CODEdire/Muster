@page "/guilds/{GuildIdRaw}/shop/store/{Slug}"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildMemberComponentBase
@implements IDisposable
@inject IServiceScopeFactory Scopes
@using Muster.Contracts
@using Muster.Domain.Entities.Shops
@using Muster.Infrastructure.Services.Shops
@using static Muster.Web.Components.Pages.Shop.Core.ShopPresentation

<PageTitle>@(_front?.Name ?? "Storefront") — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    @if (!_shopGate.IsEnabled)
    {
        <FeatureGateNotice Verdict="_shopGate" Feature="The shop" />
    }
    else if (_front is null)
    {
        <div class="panel glass empty">That storefront doesn't exist. <a href="/guilds/@GuildId/shop">Back to the shop</a>.</div>
    }
    else
    {
        @if (_front.BannerImageKey is { } bk)
        {
            @* Edge-fade hero: the banner is the masthead. Cover-fills the frame; left/right edges dissolve into the
               page (var(--bg-base)) so wide viewports never show a hard crop; a scrim — optionally tinted with the
               store's accent — carries the identity overlaid bottom-left. *@
            <div class="store-hero full-bleed" style="position:relative;height:clamp(160px,20vw,280px);border-radius:14px;overflow:hidden;margin-bottom:.5rem;background:var(--bg-base)">
                @* Banner shown at full height, left-anchored, never side-cropped — it scales to its max size for the
                   hero, then its right edge fades into the page (mask) so wide viewports blend instead of crop. *@
                <img src="/shop-image/@bk" alt="@(_front.Name) banner" style="position:absolute;left:0;top:0;height:100%;width:auto;display:block;object-fit:cover;-webkit-mask-image:linear-gradient(to right,#000 72%,transparent);mask-image:linear-gradient(to right,#000 72%,transparent)" />
                <div aria-hidden="true" style="position:absolute;inset:0;@ScrimStyle(_front.AccentColor)"></div>
                <div style="position:absolute;left:1.1rem;right:1.1rem;bottom:.85rem;display:flex;align-items:flex-end;gap:.75rem">
                    @if (_front.LogoImageKey is { } lk)
                    {
                        <img src="/shop-image/@lk" alt="" style="width:52px;height:52px;border-radius:12px;object-fit:cover;box-shadow:0 2px 12px rgba(0,0,0,.6)" />
                    }
                    else if (ShopIcons.Material(_front.StoreTypeIcon) is { } mi)
                    {
                        <span class="material-symbols-outlined" style="font-size:30px;width:52px;height:52px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:rgba(0,0,0,.4);color:#fff">@mi</span>
                    }
                    <div>
                        <nav class="store-titlecrumb store-titlecrumb-onbanner" aria-label="Breadcrumb">
                            <a href="/guilds/@GuildId/shop?tab=shops">Shops</a>
                            <span class="store-crumb-sep" aria-hidden="true">›</span>
                            <h1 class="store-title" aria-current="page">@_front.Name</h1>
                        </nav>
                        <p style="margin:2px 0 0;color:rgba(255,255,255,.88);font-size:.92rem;display:flex;align-items:center;gap:.4rem;flex-wrap:wrap">@HeroMetaInner</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            @* No banner — clean identity row, no empty hero box. *@
            <div class="page-head full-bleed" style="@(_front.AccentColor is { } c ? $"border-left:4px solid {c};padding-left:.75rem" : null)">
                <div style="display:flex;align-items:center;gap:.75rem">
                    @if (_front.LogoImageKey is { } lk)
                    {
                        <img src="/shop-image/@lk" alt="" style="width:56px;height:56px;border-radius:12px;object-fit:cover" />
                    }
                    else if (ShopIcons.Material(_front.StoreTypeIcon) is { } mi)
                    {
                        <span class="material-symbols-outlined" style="font-size:34px;width:56px;height:56px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:var(--surface)">@mi</span>
                    }
                    <div>
                        <nav class="store-titlecrumb" aria-label="Breadcrumb">
                            <a href="/guilds/@GuildId/shop?tab=shops">Shops</a>
                            <span class="store-crumb-sep" aria-hidden="true">›</span>
                            <h1 class="store-title" aria-current="page">@_front.Name</h1>
                        </nav>
                        <p class="subtitle" style="margin:0;display:flex;align-items:center;gap:.4rem;flex-wrap:wrap">@HeroMetaInner</p>
                    </div>
                </div>
            </div>
        }

        @if (_canManage)
        {
            <div style="display:flex;justify-content:flex-start;gap:.5rem;flex-wrap:wrap;align-items:center;padding:.6rem 0 .85rem;border-top:1px solid var(--border)">
                <a class="btn btn-sm" href="/guilds/@GuildId/shop/stores/@_front.Id/new"><span class="material-symbols-outlined">add</span> New listing</a>
                <a class="btn btn-ghost btn-sm" href="/guilds/@GuildId/shop/orders?tab=sales&store=@_front.Id"><span class="material-symbols-outlined">sell</span> Sales</a>
                @if (_isManager)
                {
                    <a class="btn btn-ghost btn-sm" href="/guilds/@GuildId/shop/orders?tab=disputes&store=@_front.Id"><span class="material-symbols-outlined">gavel</span> Disputes</a>
                }
                <a class="btn btn-ghost btn-sm" href="/guilds/@GuildId/shop/stores/@_front.Id"><span class="material-symbols-outlined">edit</span> Edit shop</a>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_front.Description))
        {
            <div class="panel glass markdown">@Muster.Web.DiscordMarkdown.ToHtml(_front.Description)</div>
        }


        <div class="dg-toolbar">
            <div class="dg-filters">
                <input type="search" class="dg-search" placeholder="Search items…" @bind="_searchBox" @bind:event="oninput" @bind:after="DebouncedSearchAsync" />
                <select class="dg-select" value="@(Cat ?? "")" @onchange="OnCategory">
                    <option value="">All categories</option>
                    @foreach (var c in _categories)
                    {
                        <option value="@c.Id">@(ShopIcons.Emoji(c.Icon) is { } e ? e + " " : "")@c.Name</option>
                    }
                </select>
                @if (_currencies.Count > 1)
                {
                    <select class="dg-select" value="@(Cur ?? "")" @onchange="OnCurrency">
                        <option value="">Any currency</option>
                        @foreach (var c in _currencies) { <option value="@c.Id">@c.Code</option> }
                    </select>
                }
                <input type="number" class="dg-search" style="max-width:5.5rem" min="0" placeholder="min" @bind="_minBox" @bind:event="oninput" @bind:after="DebouncedPriceAsync" />
                <input type="number" class="dg-search" style="max-width:5.5rem" min="0" placeholder="max" @bind="_maxBox" @bind:event="oninput" @bind:after="DebouncedPriceAsync" />
                <input type="search" class="dg-search" style="max-width:8rem" placeholder="#tag" @bind="_tagBox" @bind:event="oninput" @bind:after="DebouncedTagAsync" />
                <label class="chip" style="display:inline-flex;align-items:center;gap:.35rem;cursor:pointer"><input type="checkbox" checked="@Stock" @onchange="OnStock" /> In stock</label>
                <select class="dg-select" value="@CurSort" @onchange="OnSort">
                    <option value="">Featured · newest</option>
                    <option value="price-asc">Price · low → high</option>
                    <option value="price-desc">Price · high → low</option>
                    <option value="stock">Most stock</option>
                    <option value="name">Name · A → Z</option>
                </select>
            </div>
        </div>

        @if (HasFilters)
        {
            <div class="filter-summary">
                @if (Cat is { Length: > 0 } && CategoryName(Cat) is { } catName) { @FilterChip(catName, () => Go(("cat", null), ("page", null))) }
                @if (!string.IsNullOrEmpty(Q)) { @FilterChip($"\"{Q}\"", () => Go(("q", null), ("page", null))) }
                @if (!string.IsNullOrEmpty(Tag)) { @FilterChip($"#{Tag}", () => Go(("tag", null), ("page", null))) }
                @if (Cur is { Length: > 0 } && CurrencyCode(Cur) is { } curCode) { @FilterChip(curCode, () => Go(("cur", null), ("page", null))) }
                @if (Min is not null || Max is not null) { @FilterChip(PriceRangeLabel(Min, Max), () => Go(("min", null), ("max", null), ("page", null))) }
                @if (Stock) { @FilterChip("In stock", () => Go(("stock", null), ("page", null))) }
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearFilters">Clear all</button>
            </div>
        }

        @if (_items is null || _items.Items.Count == 0)
        {
            <div class="panel glass empty">@(_items is null ? "Loading…" : "No items match.")</div>
        }
        else
        {
            <div class="shop-grid">
                @foreach (var l in _items.Items)
                {
                    <ListingCard Listing="l" ItemHref="@StoreItemUrl(l.Id)">
                        <Trailing>
                            <a class="qc-details" href="@StoreItemUrl(l.Id)">Details →</a>
                        </Trailing>
                    </ListingCard>
                }
            </div>

            <div class="dg-footer">
                <div class="dg-pager">
                    <button type="button" class="btn btn-ghost btn-sm" disabled="@(CurPage <= 1)" @onclick='() => Go(("page", (CurPage - 1).ToString()))'>← Prev</button>
                    <span>Page @CurPage of @Math.Max(_items.TotalPages, 1) · @_items.Total item@(_items.Total == 1 ? "" : "s")</span>
                    <button type="button" class="btn btn-ghost btn-sm" disabled="@(CurPage >= _items.TotalPages)" @onclick='() => Go(("page", (CurPage + 1).ToString()))'>Next →</button>
                </div>
            </div>
        }

        @if (ItemId is { } iid)
        {
            <ShopItemModal GuildId="GuildId" ItemId="iid" UserId="UserId" OnClose="CloseItem" OnChanged="OnItemChangedAsync" />
        }
    }
}

@code {
    // Razor render-fragment helpers (markup templates) stay in the .razor; the rest of the component lives in the
    // code-behind partial.
    private RenderFragment FilterChip(string text, Action onClear) => @<text>
        <span class="chip filter-chip">@text <button type="button" class="filter-chip-x" title="Remove" @onclick="onClear">×</button></span>
    </text>;

    // Owner UserChip + type (with its icon) + closed + rating — shared by the banner hero and the no-banner row.
    private RenderFragment HeroMetaInner => @<text>
        <UserChip Name="@_front!.OwnerName" AvatarUrl="@_front.OwnerAvatarUrl" Prefix="by " />
        @if (_front.StoreTypeName is { } tn)
        {
            <span class="hero-dot">·</span>
            <span style="display:inline-flex;align-items:center;gap:.25rem">
                @if (ShopIcons.Material(_front.StoreTypeIcon) is { } mi)
                {
                    <span class="material-symbols-outlined" style="font-size:1.05em">@mi</span>
                }
                @tn
            </span>
        }
        @if (_front.Closed)
        {
            <span class="hero-dot">·</span><span>closed</span>
        }
        @if (_front.SellerRatingCount > 0)
        {
            <span class="hero-dot">·</span><span>★ @_front.SellerRatingAvg.ToString("0.0") (@_front.SellerRatingCount)</span>
        }
    </text>;
}
