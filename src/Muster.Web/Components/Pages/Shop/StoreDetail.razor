@page "/guilds/{GuildIdRaw}/shop/stores/{StoreId:guid}"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildMemberComponentBase
@implements IDisposable
@inject IServiceScopeFactory Scopes
@inject Microsoft.Extensions.Options.IOptions<ShopImageOptions> ImgOpt
@using Microsoft.AspNetCore.Components.Forms
@using Muster.Contracts
@using Muster.Domain.Entities.Shops
@using Muster.Infrastructure.Commands
@using Muster.Infrastructure.Commands.Shops
@using Muster.Infrastructure.Services.Shops

<PageTitle>@(_store?.Name ?? "Store") — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    @if (!_shopGate.IsEnabled)
    {
        <FeatureGateNotice Verdict="_shopGate" Feature="The shop" />
    }
    else if (_store is null)
    {
        <div class="panel glass empty">That store couldn't be found. <a href="/guilds/@GuildId/shop/stores">Back to shop management</a>.</div>
    }
    else if (!_canManage)
    {
        <div class="panel glass empty">You can only manage your own stores.</div>
    }
    else
    {
        <PageHeader Crumbs="@(new PageHeader.Crumb[] { new("Shops", $"/guilds/{GuildId}/shop?tab=shops"), new(_store.Name) })"
                    Subtitle="@($"Handle: {_store.Slug}")">
            <Toolbar>
                <a class="btn btn-sm btn-ghost" href="/guilds/@GuildId/shop/store/@_store.Slug">
                    <span class="material-symbols-outlined">storefront</span> View storefront
                </a>
            </Toolbar>
        </PageHeader>

        @if (Message is not null)
        {
            <div class="notice" role="status">
                <span class="material-symbols-outlined notice-icon">info</span>
                <span class="notice-text">@Message</span>
                <button type="button" class="icon-btn notice-close" title="Dismiss" @onclick="() => Message = null"><span class="material-symbols-outlined">close</span></button>
            </div>
        }

        <TabFrame ActiveId="@_tab" ActiveIdChanged="id => _tab = id">
            <TabPane Id="config" Label="Store config" Icon="tune" Padded="true">
                <div class="btn-row" style="justify-content:flex-end;margin-bottom:1rem">
                    <button type="button" class="btn btn-sm" disabled="@_busy" @onclick="SaveAsync">
                        <span class="material-symbols-outlined">save</span> Save changes
                    </button>
                    <button type="button" class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="ResyncAsync" title="Re-post featured cards to the shop channel">
                        <span class="material-symbols-outlined">sync</span> Resync shop cards
                    </button>
                    <button type="button" class="btn btn-sm danger" disabled="@_busy" @onclick="DeleteAsync">
                        <span class="material-symbols-outlined">delete</span> Delete store
                    </button>
                </div>

                <div class="mform">
                    <div class="field span2">
                        <label>Name</label>
                        <input @bind="_name" maxlength="80" />
                    </div>
                    <div class="field">
                        <label>Type</label>
                        <select @bind="_storeTypeId">
                            <option value="@Guid.Empty">— none —</option>
                            @foreach (var t in _storeTypes) { <option value="@t.Id">@(ShopIcons.Emoji(t.Icon) is { } e ? e + " " : "")@t.Name</option> }
                        </select>
                        <span class="hint">Admin-managed list. Shown on the shop's card.@(_storeTypes.Count == 0 ? " None defined yet." : "")</span>
                    </div>
                    <div class="field span2">
                        <label>Description</label>
                        <MarkdownEditor @bind-Value="_description" Rows="4" MaxLength="1000"
                                        Placeholder="Tell shoppers what you sell. Supports Discord markdown." />
                    </div>
                    <div class="field span2">
                        <label>Accent colour</label>
                        <div style="display:flex;gap:.5rem;align-items:center">
                            <input type="color" value="@SwatchValue(_accent)" @oninput="OnAccentPick"
                                   aria-label="Pick accent colour" style="width:2.5rem;height:2.25rem;padding:0;border:none;background:none;cursor:pointer" />
                            <input @bind="_accent" maxlength="16" placeholder="#7c3aed" style="max-width:8rem" />
                            @if (!string.IsNullOrWhiteSpace(_accent))
                            {
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _accent = string.Empty">Clear</button>
                            }
                        </div>
                        <span class="hint">Tints your storefront header — a hex colour like <code>#7c3aed</code>. Leave blank for the default theme.</span>
                    </div>
                    <div class="field span2">
                        <label class="checkbox"><input type="checkbox" @bind="_closed" /> Closed</label>
                        <span class="hint">A closed store keeps its history but stops new listings, purchases, and offers. Reopen any time.</span>
                    </div>
                    @if (_isManager)
                    {
                        <div class="field span2">
                            <label class="checkbox"><input type="checkbox" @bind="_guildStore" /> Guild shop</label>
                            <span class="hint">A guild shop is run by the guild: purchases <strong>burn</strong> the buyer's coins (no seller paid), and ratings/offers are off. Converting affects future sales only — in-flight orders keep their original terms. ShopManager-only.</span>
                        </div>
                    }
                    @if (_imagesAvailable)
                    {
                        <div class="field span2">
                            <label>Logo</label>
                            @if (!string.IsNullOrWhiteSpace(_logo))
                            {
                                <img src="/shop-image/@_logo" alt="Logo" style="display:block;width:64px;height:64px;object-fit:cover;border-radius:10px;margin-bottom:.5rem" />
                                <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _logo = string.Empty"><span class="material-symbols-outlined">delete</span> Remove logo</button>
                            }
                            <InputFile OnChange="OnLogoSelectedAsync" accept="image/*" />
                            @if (_logoUploading) { <span class="hint">Uploading…</span> }
                            @if (_logoError is { } le) { <span class="hint" style="color:var(--danger)">@le</span> }
                            <span class="hint">A square mark shown on shop cards and lists. @ImgOpt.Value.Describe(ShopImageKind.Icon)</span>
                        </div>
                        <div class="field span2">
                            <label>Banner image</label>
                            @if (!string.IsNullOrWhiteSpace(_banner))
                            {
                                @* Preview mirrors the storefront hero: cover-fit, edges fade into the page, accent scrim. *@
                                <div style="position:relative;height:clamp(160px,20vw,280px);border-radius:14px;overflow:hidden;margin-bottom:.5rem;background:@BannerBg(_accent)">
                                    <img src="/shop-image/@_banner" alt="Banner" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
                                    <div aria-hidden="true" style="position:absolute;inset:0;background:linear-gradient(to right,var(--bg-base),transparent 13%,transparent 87%,var(--bg-base))"></div>
                                    <div aria-hidden="true" style="position:absolute;inset:0;@BannerScrim(_accent)"></div>
                                </div>
                                <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _banner = string.Empty"><span class="material-symbols-outlined">delete</span> Remove banner</button>
                            }
                            <InputFile OnChange="OnBannerSelectedAsync" accept="image/*" />
                            @if (_uploading) { <span class="hint">Uploading…</span> }
                            @if (_imageError is { } err) { <span class="hint" style="color:var(--danger)">@err</span> }
                            <span class="hint">Your storefront hero and the Discord shop card. A wide banner (about 3:1, e.g. 1920×640) frames best — the web hero may crop the top/bottom slightly. @ImgOpt.Value.Describe(ShopImageKind.Banner)</span>
                        </div>
                    }
                </div>
            </TabPane>

            <TabPane Id="listings" Label="Listings" Icon="inventory_2">
                <div class="dg-toolbar">
                    <div class="dg-filters">
                        <input type="search" class="dg-search" placeholder="Search items…" @bind="_mSearch" @bind:event="oninput" @bind:after="DebouncedMSearchAsync" />
                        <select class="dg-select" value="@MStatusValue" @onchange="OnMStatus">
                            <option value="">All statuses</option>
                            <option value="Active">Active</option>
                            <option value="SoldOut">Sold out</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Expired">Expired</option>
                        </select>
                        <select class="dg-select" value="@_mSort" @onchange="OnMSort">
                            <option value="">Newest</option>
                            <option value="price-asc">Price · low → high</option>
                            <option value="price-desc">Price · high → low</option>
                            <option value="name">Name · A → Z</option>
                        </select>
                    </div>
                    <div class="dg-actions">
                        <a class="btn btn-sm" href="/guilds/@GuildId/shop/stores/@StoreId/new">
                            <span class="material-symbols-outlined">add</span> New listing
                        </a>
                    </div>
                </div>

                <div class="dg-scroll">
                    <table class="dg-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="num">Price</th>
                                <th class="num">Qty</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th class="dg-actions-col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_listingsPage is null || _listingsPage.Items.Count == 0)
                            {
                                <tr class="dg-empty"><td colspan="6">@(_listingsPage is null ? "Loading…" : "No listings match.")</td></tr>
                            }
                            else
                            {
                                @foreach (var l in _listingsPage.Items)
                                {
                                    <tr>
                                        <td>
                                            <span style="display:inline-flex;align-items:center;gap:.5rem">
                                                @if (l.ThumbKey is { } tk)
                                                {
                                                    <img src="/shop-image/@tk" alt="" style="width:28px;height:28px;border-radius:6px;object-fit:cover;flex:0 0 auto" />
                                                }
                                                else if (ShopIcons.Material(l.CategoryIcon) is { } cmi)
                                                {
                                                    <span class="material-symbols-outlined" style="font-size:22px;opacity:.7">@cmi</span>
                                                }
                                                else
                                                {
                                                    <span class="material-symbols-outlined" style="font-size:22px;opacity:.5">image</span>
                                                }
                                                <a href="/guilds/@GuildId/shop/listing/@l.Id/edit">@l.Name</a>
                                            </span>
                                            @if (l.Tags is { Count: > 0 } tags)
                                            {
                                                <div class="qc-chips" style="margin-top:.25rem">
                                                    @foreach (var t in tags.Take(5)) { <span class="chip">#@t</span> }
                                                </div>
                                            }
                                        </td>
                                        <td class="num">@l.Price @l.CurrencyCode</td>
                                        <td class="num">@l.Quantity</td>
                                        <td>
                                            @if (l.CategoryName is { } cn)
                                            {
                                                @if (ShopIcons.Material(l.CategoryIcon) is { } cmi) { <span class="material-symbols-outlined" style="vertical-align:-3px;font-size:1rem">@cmi</span> }
                                                @cn
                                            }
                                            else { <span>—</span> }
                                        </td>
                                        <td>
                                            <span class="status-dot @(l.Status == ShopListingStatus.Active ? "is-active" : "is-ended")"></span>
                                            @l.Status
                                            @if (l.Moderated)
                                            {
                                                <span class="chip" style="margin-left:.35rem" title="@(l.DelistReason ?? "No reason given")"><span class="material-symbols-outlined" style="vertical-align:-3px;font-size:1rem">gavel</span> Taken down</span>
                                            }
                                        </td>
                                        <td class="dg-actions-col">
                                            <div class="dg-row-actions">
                                                <button type="button" class="icon-btn" title="Preview" aria-label="Preview listing" @onclick="() => _previewItem = l.Id">
                                                    <span class="material-symbols-outlined">visibility</span>
                                                </button>
                                                <a class="icon-btn" title="Edit listing" aria-label="Edit listing" href="/guilds/@GuildId/shop/listing/@l.Id/edit">
                                                    <span class="material-symbols-outlined">edit</span>
                                                </a>
                                                @if (l.Status == ShopListingStatus.Active && l.Featured)
                                                {
                                                    <button type="button" class="icon-btn" title="Unfeature" aria-label="Unfeature listing"
                                                            disabled="@_busy" @onclick="() => UnfeatureAsync(l.Id, l.Name)">
                                                        <span class="material-symbols-outlined" style="color:#f5b301;font-variation-settings:'FILL' 1">star</span>
                                                    </button>
                                                }
                                                else if (l.Status == ShopListingStatus.Active)
                                                {
                                                    <button type="button" class="icon-btn" title="Feature" aria-label="Feature listing"
                                                            disabled="@_busy" @onclick="() => FeatureAsync(l.Id, l.Name, l.CurrencyCode)">
                                                        <span class="material-symbols-outlined">star</span>
                                                    </button>
                                                }
                                                @if (l.Status == ShopListingStatus.Active)
                                                {
                                                    <button type="button" class="icon-btn" title="Add stock" aria-label="Add stock"
                                                            disabled="@_busy" @onclick="() => AddStockAsync(l.Id, l.Name)">
                                                        <span class="material-symbols-outlined">add_box</span>
                                                    </button>
                                                    <button type="button" class="icon-btn danger" title="Withdraw listing" aria-label="Withdraw listing"
                                                            disabled="@_busy" @onclick="() => CancelListingAsync(l.Id, l.Name)">
                                                        <span class="material-symbols-outlined">delete</span>
                                                    </button>
                                                }
                                                else if (l.Status == ShopListingStatus.SoldOut || l.Status == ShopListingStatus.Expired)
                                                {
                                                    <button type="button" class="icon-btn" title="Relist as a new copy" aria-label="Relist listing"
                                                            disabled="@_busy" @onclick="() => RelistAsync(l.Id, l.Name)">
                                                        <span class="material-symbols-outlined">restart_alt</span>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="dg-footer">
                    <div class="dg-pager">
                        <button type="button" class="btn btn-ghost btn-sm" disabled="@((_listingsPage?.Page ?? 1) <= 1)" @onclick="() => MGo((_listingsPage?.Page ?? 1) - 1)">← Prev</button>
                        <span>Page @(_listingsPage?.Page ?? 1) of @Math.Max(_listingsPage?.TotalPages ?? 1, 1) · @(_listingsPage?.Total ?? 0) listing@((_listingsPage?.Total ?? 0) == 1 ? "" : "s")</span>
                        <button type="button" class="btn btn-ghost btn-sm" disabled="@((_listingsPage?.Page ?? 1) >= (_listingsPage?.TotalPages ?? 1))" @onclick="() => MGo((_listingsPage?.Page ?? 1) + 1)">Next →</button>
                    </div>
                </div>
            </TabPane>
        </TabFrame>

        @if (_previewItem is { } pid)
        {
            <ShopItemModal GuildId="GuildId" ItemId="pid" UserId="UserId" OnClose="() => _previewItem = null" OnChanged="OnPreviewChangedAsync" />
        }
    }
}
