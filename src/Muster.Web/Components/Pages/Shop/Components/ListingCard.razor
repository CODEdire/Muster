@using Muster.Infrastructure.Services.Shops
@using static Muster.Web.Components.Pages.Shop.Core.ShopPresentation

@* A market/storefront listing tile: thumbnail, featured/new badges, store + category overlay, price + trailing slot.
   The board passes ShowStoreChip + a seller chip; a storefront (already scoped to one store) passes a Details link. *@
<article class="shop-tile @(Listing.Featured ? "is-featured" : "")">
    <div class="shop-tile-media-wrap @(Listing.ThumbKey is null ? "placeholder" : "")">
        <a class="shop-tile-thumb" href="@ItemHref" aria-label="@Listing.Name">
            @if (Listing.ThumbKey is { } tk)
            {
                <img class="tile-bg" src="/shop-image/@tk" alt="" aria-hidden="true" loading="lazy" />
                <img class="tile-fg" src="/shop-image/@tk" alt="@Listing.Name" loading="lazy" />
            }
            else
            {
                <span class="material-symbols-outlined">image</span>
            }
        </a>
        @if (Listing.Featured || Listing.IsNew)
        {
            <span class="shop-tile-badges">
                @if (Listing.Featured) { <span class="shop-badge feat"><span class="material-symbols-outlined">star</span> Featured</span> }
                @if (Listing.IsNew) { <span class="shop-badge new">NEW</span> }
            </span>
        }
        @if (ShowStoreChip || Listing.CategoryName is not null)
        {
            <div class="shop-tile-overlay">
                @if (ShowStoreChip)
                {
                    <a class="tile-ochip store" href="/guilds/@GuildId/shop/store/@Listing.StoreSlug"><span class="material-symbols-outlined">storefront</span> @Listing.StoreName</a>
                }
                @if (Listing.CategoryName is { } cn)
                {
                    <span class="tile-ochip">@if (ShopIcons.Material(Listing.CategoryIcon) is { } cmi) { <span class="material-symbols-outlined">@cmi</span> } @cn</span>
                }
            </div>
        }
    </div>
    <div class="shop-tile-body">
        <h3><a class="qc-title" href="@ItemHref">@Listing.Name</a></h3>
        <span class="shop-stock@(Listing.Quantity <= 0 ? " out" : "")">@StockLabel(Listing.Quantity)</span>
        <div class="shop-tile-meta">
            <span class="shop-price">@Listing.Price @Listing.CurrencyCode</span>
            @Trailing
        </div>
    </div>
</article>
