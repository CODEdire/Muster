@page "/"
@layout PublicLayout

<PageTitle>Muster — participation tracking for Discord</PageTitle>

<section class="hero">
    <h1>Reward the people who show up</h1>
    <p>Muster tracks voice attendance, missions, musters, and awards across your Discord community —
       all on a clean multi-currency leaderboard.</p>

    <AuthorizeView>
        <Authorized>
            <a class="btn" href="/guilds">Go to your servers →</a>
        </Authorized>
        <NotAuthorized>
            <a class="btn" href="/account/login">Log in with Discord</a>
        </NotAuthorized>
    </AuthorizeView>
</section>

<div class="panel glass">
    <h2>What you get</h2>
    <ul>
        <li><strong>Voice attendance</strong> — reward time spent in tracked sessions and ops.</li>
        <li><strong>Missions &amp; musters</strong> — quests to claim and reaction check-ins.</li>
        <li><strong>Seasons &amp; leaderboards</strong> — points reset per season; spendable currencies persist.</li>
    </ul>
</div>
