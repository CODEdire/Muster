@page "/guilds/{GuildIdRaw}/treasury/flow"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildAdminComponentBase
@inject IServiceScopeFactory Scopes
@using Muster.Infrastructure.Services.Currencies
@using Muster.Infrastructure.Services.Web
@using Muster.Web.Components.Pages.Economy.Components
@using static Muster.Web.Components.Shared.LedgerMeta

<PageTitle>Flow — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need staff or admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="t-head">
        <nav class="t-crumb" aria-label="Breadcrumb">
            <a href="/guilds/@GuildId/treasury">Treasury</a>
            <span class="material-symbols-outlined sep" aria-hidden="true">chevron_right</span>
            <span class="who">Flow</span>
        </nav>
        <CurrencySwitcher Currencies="_currencies" Selected="_code" SelectedChanged="SelectCurrency" />
    </div>

    <TreasuryTabs GuildId="GuildId" Active="flow" Cur="_code" />

    @if (_currencies.Count == 0)
    {
        <div class="panel glass empty">No wallet currencies are configured yet.</div>
    }
    else if (_flow is not null)
    {
        <p class="f-note">Net-new vs destroyed over the last 30 days. Transfers and shop payouts are redistribution and excluded.</p>

        <div class="stat-grid">
            <div class="card glass stat">
                <span class="kpi-ico material-symbols-outlined" aria-hidden="true">water_drop</span>
                <span class="label">Minted · faucets</span><span class="num pos">+@_flow.Minted.ToString("N0")</span>
                @if (!string.IsNullOrEmpty(_mintSpark))
                {
                    <svg class="spark mint" viewBox="0 0 100 26" preserveAspectRatio="none" aria-hidden="true"><polyline points="@_mintSpark" /></svg>
                }
            </div>
            <div class="card glass stat">
                <span class="kpi-ico material-symbols-outlined" aria-hidden="true">local_fire_department</span>
                <span class="label">Burned · sinks</span><span class="num neg">−@_flow.Burned.ToString("N0")</span>
                @if (!string.IsNullOrEmpty(_burnSpark))
                {
                    <svg class="spark burn" viewBox="0 0 100 26" preserveAspectRatio="none" aria-hidden="true"><polyline points="@_burnSpark" /></svg>
                }
            </div>
            <div class="card glass stat">
                <span class="kpi-ico material-symbols-outlined" aria-hidden="true">swap_vert</span>
                <span class="label">Net supply</span><span class="num @(_flow.Net >= 0 ? "pos" : "neg")">@(_flow.Net > 0 ? "+" : "")@_flow.Net.ToString("N0")</span>
                @if (!string.IsNullOrEmpty(_netSpark))
                {
                    <svg class="spark net" viewBox="0 0 100 26" preserveAspectRatio="none" aria-hidden="true"><polyline points="@_netSpark" /></svg>
                }
            </div>
            <div class="card glass stat">
                <span class="kpi-ico material-symbols-outlined" aria-hidden="true">trending_up</span>
                <span class="label">Inflation</span><span class="num">@_flow.InflationPct.ToString("0.#")%</span><span class="subtitle">/ month</span>
            </div>
        </div>

        @if (_series.Count > 0)
        {
            <div class="f-card">
                <div class="panel-head"><h2>Mint vs burn by month</h2><span class="legend"><span class="sw mint"></span>minted <span class="sw burn"></span>burned</span></div>
                <svg class="f-bars" viewBox="0 0 600 150" aria-hidden="true">
                    <line x1="0" y1="130" x2="600" y2="130" class="axis" />
                    @{
                        var n = _series.Count;
                        var gw = 600.0 / n;
                        var bw = System.Math.Min(18.0, gw * 0.32);
                    }
                    @for (var i = 0; i < n; i++)
                    {
                        var m = _series[i];
                        var cx = i * gw + gw / 2;
                        var mh = m.Minted * 120.0 / _flowBarMax;
                        var bh = m.Burned * 120.0 / _flowBarMax;
                        <rect class="bar mint" x="@((cx - bw - 1).ToString("0.#"))" y="@((130 - mh).ToString("0.#"))" width="@bw.ToString("0.#")" height="@mh.ToString("0.#")" rx="2" />
                        <rect class="bar burn" x="@((cx + 1).ToString("0.#"))" y="@((130 - bh).ToString("0.#"))" width="@bw.ToString("0.#")" height="@bh.ToString("0.#")" rx="2" />
                    }
                </svg>
                <div class="f-mlabels">
                    @foreach (var m in _series)
                    {
                        <span>@MonthNames[m.Month]</span>
                    }
                </div>
            </div>
        }

        <div class="f-card">
            <div class="panel-head">
                <h2>By source</h2>
                <span class="legend"><span class="sw burn"></span>burned&nbsp;◄&nbsp;&nbsp;►&nbsp;minted&nbsp;<span class="sw mint"></span></span>
            </div>
            @if (_flow.Faucets.Count == 0 && _flow.Sinks.Count == 0)
            {
                <p class="subtitle">No mint or burn activity in this window.</p>
            }
            else
            {
                @foreach (var f in _flow.Faucets)
                {
                    <div class="flow-row">
                        <span class="fname">@SourceLabel(f.Source)</span>
                        <div class="fbar left"></div>
                        <div class="fbar right"><div class="fill mint" style="width:@(f.Total * 100 / FlowMax)%"></div></div>
                        <span class="fval pos">+@f.Total.ToString("N0")</span>
                    </div>
                }
                @foreach (var s in _flow.Sinks)
                {
                    <div class="flow-row">
                        <span class="fname">@SourceLabel(s.Source)</span>
                        <div class="fbar left"><div class="fill burn" style="width:@(s.Total * 100 / FlowMax)%"></div></div>
                        <div class="fbar right"></div>
                        <span class="fval neg">−@s.Total.ToString("N0")</span>
                    </div>
                }
            }
        </div>

        <div class="f-card">
            <div class="panel-head"><h2>Inflation gauge</h2></div>
            <p class="subtitle">@InflationRead(_flow.InflationPct) · supply @(_flow.Net >= 0 ? "growing" : "shrinking") ~@Math.Abs(_flow.InflationPct).ToString("0.#")%/mo. Healthy band 0–5%.</p>
            <div class="gauge"><div class="needle" style="left:@InflationPos%"></div></div>
            <div class="gauge-labels"><span>deflating</span><span>stable</span><span>hot</span></div>

            @if (!string.IsNullOrEmpty(_inflationLine))
            {
                <div class="infl-cap">Inflation over time · monthly</div>
                <svg class="f-infl" viewBox="0 0 600 70" preserveAspectRatio="none" aria-hidden="true">
                    <line x1="0" y1="@_inflationZeroY.ToString("0.#")" x2="600" y2="@_inflationZeroY.ToString("0.#")" class="zero" />
                    <polyline points="@_inflationLine" />
                </svg>
                <div class="f-mlabels">
                    @foreach (var m in _series)
                    {
                        <span>@MonthNames[m.Month]</span>
                    }
                </div>
            }
        </div>
    }
}
