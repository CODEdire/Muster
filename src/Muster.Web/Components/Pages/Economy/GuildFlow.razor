@page "/guilds/{GuildIdRaw}/treasury/flow"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildAdminComponentBase
@inject IServiceScopeFactory Scopes
@using Muster.Infrastructure.Services.Currencies
@using Muster.Infrastructure.Services.Web
@using Muster.Web.Components.Pages.Economy.Components
@using static Muster.Web.Components.Shared.LedgerMeta

<PageTitle>Flow — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need staff or admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="t-head">
        <nav class="t-crumb" aria-label="Breadcrumb">
            <a href="/guilds/@GuildId/treasury">Treasury</a>
            <span class="material-symbols-outlined sep" aria-hidden="true">chevron_right</span>
            <span class="who">Flow</span>
        </nav>
        @if (_currencies.Count > 1)
        {
            <div class="t-switch" role="tablist">
                @foreach (var c in _currencies)
                {
                    <button type="button" role="tab" class="cur-tab @(c.Code == _code ? "active" : "")"
                            aria-selected="@(c.Code == _code)" @onclick="() => SelectCurrency(c.Code)">
                        @if (c.Primary)
                        {
                            <span class="material-symbols-outlined star" title="Guild default" aria-hidden="true">star</span>
                        }
                        @c.Code
                    </button>
                }
            </div>
        }
    </div>

    <TreasuryTabs GuildId="GuildId" Active="flow" />

    @if (_currencies.Count == 0)
    {
        <div class="panel glass empty">No wallet currencies are configured yet.</div>
    }
    else if (_flow is not null)
    {
        <p class="f-note">Net-new vs destroyed over the last 30 days. Transfers and shop payouts are redistribution and excluded.</p>

        <div class="stat-grid">
            <div class="card glass stat"><span class="label">Minted · faucets</span><span class="num pos">+@_flow.Minted.ToString("N0")</span><span class="subtitle">net-new currency</span></div>
            <div class="card glass stat"><span class="label">Burned · sinks</span><span class="num neg">−@_flow.Burned.ToString("N0")</span><span class="subtitle">removed from supply</span></div>
            <div class="card glass stat"><span class="label">Net supply</span><span class="num @(_flow.Net >= 0 ? "pos" : "neg")">@(_flow.Net > 0 ? "+" : "")@_flow.Net.ToString("N0")</span><span class="subtitle">change · 30d</span></div>
            <div class="card glass stat"><span class="label">Inflation</span><span class="num">@_flow.InflationPct.ToString("0.#")%</span><span class="subtitle">/ month</span></div>
        </div>

        <div class="f-card">
            <div class="panel-head">
                <h2>By source</h2>
                <span class="legend"><span class="sw burn"></span>burned&nbsp;◄&nbsp;&nbsp;►&nbsp;minted&nbsp;<span class="sw mint"></span></span>
            </div>
            @if (_flow.Faucets.Count == 0 && _flow.Sinks.Count == 0)
            {
                <p class="subtitle">No mint or burn activity in this window.</p>
            }
            else
            {
                @foreach (var f in _flow.Faucets)
                {
                    <div class="flow-row">
                        <span class="fname">@SourceLabel(f.Source)</span>
                        <div class="fbar left"></div>
                        <div class="fbar right"><div class="fill mint" style="width:@(f.Total * 100 / FlowMax)%"></div></div>
                        <span class="fval pos">+@f.Total.ToString("N0")</span>
                    </div>
                }
                @foreach (var s in _flow.Sinks)
                {
                    <div class="flow-row">
                        <span class="fname">@SourceLabel(s.Source)</span>
                        <div class="fbar left"><div class="fill burn" style="width:@(s.Total * 100 / FlowMax)%"></div></div>
                        <div class="fbar right"></div>
                        <span class="fval neg">−@s.Total.ToString("N0")</span>
                    </div>
                }
            }
        </div>

        <div class="f-card">
            <div class="panel-head"><h2>Inflation gauge</h2></div>
            <p class="subtitle">@InflationRead(_flow.InflationPct) · supply @(_flow.Net >= 0 ? "growing" : "shrinking") ~@Math.Abs(_flow.InflationPct).ToString("0.#")%/mo. Healthy band 0–5%.</p>
            <div class="gauge"><div class="needle" style="left:@InflationPos%"></div></div>
            <div class="gauge-labels"><span>deflating</span><span>stable</span><span>hot</span></div>
        </div>
    }
}
