@inherits ParticipationPart
@using Muster.Web.Components.Shared
@using static Muster.Web.Components.Shared.LedgerMeta

<div class="pp-card">
    <div class="panel-head">
        <h2>Top holders</h2>
        <div class="pp-rankctl">
            @if (_seasons.Count > 0)
            {
                <select class="dg-select" value="@(_season?.ToString() ?? "")" @onchange="OnSeason">
                    @foreach (var s in _seasons)
                    {
                        <option value="@s.Id">@s.Name@(s.IsActive ? " (active)" : "")</option>
                    }
                </select>
            }
            @if (_loading)
            {
                <span class="dg-loading" aria-hidden="true"></span>
            }
        </div>
    </div>

    @if (_holders is null || _holders.Items.Count == 0)
    {
        <p class="subtitle">@(_holders is null ? "Loading…" : "No balances yet for this season.")</p>
    }
    else
    {
        @foreach (var h in _holders.Items)
        {
            <div class="pp-pod">
                <span class="rank @RankClass(h.Rank)">@h.Rank</span>
                <UserChip Name="@h.DisplayName" AvatarUrl="@h.AvatarUrl" Href="@MusterLinks.MemberDetail(GuildId, h.UserId)" />
                <span class="val">@h.Total.ToString("N0")</span>
            </div>
        }

        <div class="dg-footer">
            <span class="dg-tz">@_holders.Total holders</span>
            <div class="dg-pager">
                <button type="button" class="btn btn-ghost btn-sm" disabled="@(_page <= 1)" @onclick="Prev">← Prev</button>
                <span>Page @_page of @TotalPages</span>
                <button type="button" class="btn btn-ghost btn-sm" disabled="@(_page >= TotalPages)" @onclick="Next">Next →</button>
            </div>
        </div>
    }
</div>

@code {
    // pp-rankctl: keep the season picker + spinner tidy in the card head.
}
