@* Shared virtual tab bar across the guild Treasury pages. Active is one of: overview, ledger, participation. *@
<nav class="treasury-tabs" aria-label="Treasury sections">
    @foreach (var t in Tabs)
    {
        <a href="@t.Href" class="ttab @(t.Key == Active ? "active" : "")" aria-current="@(t.Key == Active ? "page" : null)">
            <span class="material-symbols-outlined" aria-hidden="true">@t.Icon</span> @t.Label
        </a>
    }
</nav>

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter] public string Active { get; set; } = "overview";

    private IEnumerable<(string Key, string Label, string Icon, string Href)> Tabs =>
    [
        ("overview", "Overview", "account_balance", $"/guilds/{GuildId}/treasury"),
        ("ledger", "Ledger", "receipt_long", $"/guilds/{GuildId}/guild-ledger"),
        ("distribution", "Distribution", "equalizer", $"/guilds/{GuildId}/treasury/distribution"),
        ("participation", "Participation", "trophy", $"/guilds/{GuildId}/guild-points"),
    ];
}
