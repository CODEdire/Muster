@* Treasury-specific configuration of the shared TabBar: builds the section list + carries the selected currency
   across tabs as ?cur=. The responsive behaviour lives in TabBar. *@
<TabBar Tabs="Items" Active="Active" AriaLabel="Treasury sections" />

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter] public string Active { get; set; } = "overview";

    /// <summary>The selected currency code, carried across tabs as ?cur= so the choice survives navigation.</summary>
    [Parameter] public string? Cur { get; set; }

    private string Q => string.IsNullOrWhiteSpace(Cur) ? "" : $"?cur={Uri.EscapeDataString(Cur)}";

    private IReadOnlyList<TabBar.TabItem> Items =>
    [
        new("overview", "Overview", "account_balance", $"/guilds/{GuildId}/treasury{Q}"),
        new("ledger", "Ledger", "receipt_long", $"/guilds/{GuildId}/treasury/ledger{Q}"),
        new("distribution", "Distribution", "equalizer", $"/guilds/{GuildId}/treasury/distribution{Q}"),
        new("flow", "Flow", "swap_vert", $"/guilds/{GuildId}/treasury/flow{Q}"),
        new("participation", "Participation", "trophy", $"/guilds/{GuildId}/treasury/participation{Q}"),
    ];
}
