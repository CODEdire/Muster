@* Shared virtual tab bar across the guild Treasury pages. Active is one of: overview, ledger, participation. *@
<nav class="treasury-tabs" aria-label="Treasury sections">
    @foreach (var t in Tabs)
    {
        <a href="@t.Href" class="ttab @(t.Key == Active ? "active" : "")" aria-current="@(t.Key == Active ? "page" : null)">
            <span class="material-symbols-outlined" aria-hidden="true">@t.Icon</span> @t.Label
        </a>
    }
</nav>

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter] public string Active { get; set; } = "overview";

    /// <summary>The selected currency code, carried across tabs as ?cur= so the choice survives navigation.</summary>
    [Parameter] public string? Cur { get; set; }

    private string Q => string.IsNullOrWhiteSpace(Cur) ? "" : $"?cur={Uri.EscapeDataString(Cur)}";

    private IEnumerable<(string Key, string Label, string Icon, string Href)> Tabs =>
    [
        ("overview", "Overview", "account_balance", $"/guilds/{GuildId}/treasury{Q}"),
        ("ledger", "Ledger", "receipt_long", $"/guilds/{GuildId}/treasury/ledger{Q}"),
        ("distribution", "Distribution", "equalizer", $"/guilds/{GuildId}/treasury/distribution{Q}"),
        ("flow", "Flow", "swap_vert", $"/guilds/{GuildId}/treasury/flow{Q}"),
        ("participation", "Participation", "trophy", $"/guilds/{GuildId}/treasury/participation{Q}"),
    ];
}
