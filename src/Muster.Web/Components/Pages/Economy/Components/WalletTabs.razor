@* Wallet section nav built on the shared TabBar. Account + Analytics always; the points Season + ledger tabs appear
   when the server runs points. The selected wallet currency is carried across as ?cur= so it survives navigation. *@
<TabBar Tabs="Items" Active="@Active" AriaLabel="Wallet sections" />

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter] public string Active { get; set; } = "account";

    /// <summary>The selected wallet currency, carried across tabs as ?cur= so the choice survives navigation.</summary>
    [Parameter] public string? Cur { get; set; }

    /// <summary>When an admin / economy-manager views another member's wallet, carried across tabs as ?member=.</summary>
    [Parameter] public string? Member { get; set; }

    /// <summary>Show the points Season + Points-ledger tabs (server runs a points score).</summary>
    [Parameter] public bool HasPoints { get; set; }

    /// <summary>Auditor viewing another member (read-only) — show only the ledger-bearing tabs (Account + Points).</summary>
    [Parameter] public bool LedgerOnly { get; set; }

    private string CurOnly => Query(includeCur: true, includeMember: true);
    private string MemberOnly => Query(includeCur: false, includeMember: true);

    private string Query(bool includeCur, bool includeMember)
    {
        var parts = new List<string>();
        if (includeCur && !string.IsNullOrWhiteSpace(Cur)) parts.Add($"cur={Uri.EscapeDataString(Cur)}");
        if (includeMember && !string.IsNullOrWhiteSpace(Member)) parts.Add($"member={Uri.EscapeDataString(Member)}");
        return parts.Count == 0 ? "" : "?" + string.Join("&", parts);
    }

    private IReadOnlyList<TabBar.TabItem> Items
    {
        get
        {
            var items = new List<TabBar.TabItem>
            {
                new("account", "Account", "payments", $"/guilds/{GuildId}/wallet{CurOnly}"),
            };
            if (!LedgerOnly)
            {
                items.Add(new("analytics", "Analytics", "monitoring", $"/guilds/{GuildId}/wallet/analytics{CurOnly}"));
            }
            if (HasPoints)
            {
                if (!LedgerOnly)
                {
                    items.Add(new("season", "Season", "local_fire_department", $"/guilds/{GuildId}/wallet/season{MemberOnly}"));
                }
                items.Add(new("points", "Points", "trophy", $"/guilds/{GuildId}/wallet/points{MemberOnly}"));
            }
            return items;
        }
    }
}
