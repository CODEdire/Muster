@inject IServiceScopeFactory Scopes
@inject Wolverine.IMessageBus Bus
@using Muster.Contracts
@using Muster.Domain.Enums
@using Muster.Infrastructure.Services.Currencies
@using Muster.Infrastructure.Services.Platform
@using Muster.Infrastructure.Services.Web

<div class="ma-backdrop" @onclick="Close">
    <div class="ma-card panel glass" @onclick:stopPropagation="true">
        <div class="ma-head">
            <h2>Mint / adjust</h2>
            <button type="button" class="ma-x" @onclick="Close" aria-label="Close"><span class="material-symbols-outlined">close</span></button>
        </div>

        @if (AllowBulk)
        {
            <div class="ma-modes" role="group" aria-label="Target">
                <button type="button" class="@(_bulk ? "" : "active")" @onclick="() => SetMode(false)">One member</button>
                <button type="button" class="@(_bulk ? "active" : "")" @onclick="() => SetMode(true)">By role</button>
            </div>
        }

        <p class="subtitle">
            @if (_bulk)
            {
                <text>Apply a signed delta to every member with the selected role. Positive mints; negative deducts. Audited.</text>
            }
            else
            {
                <text>Apply a signed correction to one member's balance. Positive mints new currency; negative deducts. Audited.</text>
            }
        </p>

        @if (_bulk)
        {
            <label>Role
                <select class="dg-select" @bind="_roleId">
                    <option value="">— select role —</option>
                    @foreach (var r in _roles)
                    {
                        <option value="@r.RoleId">@r.Name</option>
                    }
                </select>
            </label>
        }
        else
        {
            <label>Member
                <select class="dg-select" @bind="_targetId">
                    <option value="">— select member —</option>
                    @foreach (var m in _members)
                    {
                        <option value="@m.UserId">@m.DisplayName</option>
                    }
                </select>
            </label>
        }

        <div class="ma-row">
            @if (Currencies.Count > 1)
            {
                <label>Currency
                    <select class="dg-select" @bind="_code">
                        @foreach (var c in Currencies)
                        {
                            <option value="@c.Code">@c.Code</option>
                        }
                    </select>
                </label>
            }
            <label>Amount (signed)
                <input type="number" class="dg-select" @bind="_amount" />
            </label>
        </div>

        <label>Reason
            <input type="text" class="dg-search" @bind="_reason" placeholder="e.g. event prize, correction" />
        </label>

        @if (_bulk && _confirmCount is { } cc)
        {
            <p class="ma-confirm">This will apply <strong>@_amount.ToString("+#,##0;-#,##0") @_code</strong> to <strong>@cc.ToString("N0") member(s)</strong>. Confirm to queue.</p>
        }

        @if (_message is not null)
        {
            <p class="message @(_ok ? "ok" : "err")">@_message</p>
        }

        <div class="btn-row">
            @if (_bulk)
            {
                @if (_confirmCount is null)
                {
                    <button type="button" class="btn" disabled="@(_busy || !CanBulk)" @onclick="PreviewBulkAsync">Preview…</button>
                }
                else
                {
                    <button type="button" class="btn" disabled="@_busy" @onclick="QueueBulkAsync">Confirm &amp; queue</button>
                }
            }
            else
            {
                <button type="button" class="btn" disabled="@(_busy || !CanApply)" @onclick="ApplyAsync">
                    @(_amount >= 0 ? "Mint" : "Deduct") @(_amount == 0 ? "" : System.Math.Abs(_amount).ToString("N0"))
                </button>
            }
            <button type="button" class="btn btn-ghost" @onclick="Close">Cancel</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter, EditorRequired] public ulong ActorId { get; set; }
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public IReadOnlyList<CurrencyInfo> Currencies { get; set; } = [];
    [Parameter] public bool AllowBulk { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnApplied { get; set; }

    private IReadOnlyList<MemberOption> _members = [];
    private IReadOnlyList<BulkRoleOption> _roles = [];
    private bool _bulk;
    private string _targetId = "";
    private string _roleId = "";
    private string _code = "";
    private long _amount;
    private string _reason = "";
    private bool _busy;
    private string? _message;
    private bool _ok;
    private int? _confirmCount;

    private bool CanApply => ulong.TryParse(_targetId, out _) && _amount != 0 && !string.IsNullOrWhiteSpace(_code);
    private bool CanBulk => ulong.TryParse(_roleId, out _) && _amount != 0 && !string.IsNullOrWhiteSpace(_code) && !string.IsNullOrWhiteSpace(_reason);

    protected override async Task OnInitializedAsync()
    {
        _code = string.IsNullOrWhiteSpace(Code) ? (Currencies.FirstOrDefault()?.Code ?? "") : Code;
        await using var scope = Scopes.CreateAsyncScope();
        var members = scope.ServiceProvider.GetRequiredService<WebMemberService>();
        _members = await members.GetRecipientsAsync(GuildId, 0);
        if (AllowBulk)
        {
            _roles = await members.GetRoleOptionsAsync(GuildId);
        }
    }

    private void SetMode(bool bulk)
    {
        _bulk = bulk;
        _confirmCount = null;
        _message = null;
    }

    private async Task ApplyAsync()
    {
        if (_busy || !CanApply)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var target = ulong.Parse(_targetId);
            var reason = string.IsNullOrWhiteSpace(_reason) ? "Treasury adjustment" : _reason.Trim();
            var result = await Bus.InvokeAsync<Result>(new AdjustCurrency(GuildId, ActorId, _code, target, _amount, reason));

            _ok = result.Ok;
            _message = result.Ok
                ? $"Applied {_amount:+#,##0;-#,##0} {_code}."
                : result.Status switch
                {
                    "Forbidden" => "You're not allowed to do that.",
                    "CurrencyNotFound" => "That currency doesn't exist here.",
                    "InsufficientFunds" => "That would take the member below zero.",
                    var other => other,
                };

            if (result.Ok)
            {
                await OnApplied.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PreviewBulkAsync()
    {
        if (_busy || !CanBulk || !ulong.TryParse(_roleId, out var roleId))
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            var targets = await scope.ServiceProvider.GetRequiredService<WebMemberService>().GetRoleTargetsAsync(GuildId, roleId);
            if (targets.Count == 0)
            {
                _ok = false;
                _message = "That role has no members.";
                _confirmCount = null;
                return;
            }

            _confirmCount = targets.Count;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task QueueBulkAsync()
    {
        if (_busy || !ulong.TryParse(_roleId, out var roleId))
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            var sp = scope.ServiceProvider;
            var members = sp.GetRequiredService<WebMemberService>();
            var bulk = sp.GetRequiredService<ICurrencyBulkService>();

            var targets = await members.GetRoleTargetsAsync(GuildId, roleId);
            var reason = string.IsNullOrWhiteSpace(_reason) ? "Treasury adjustment" : _reason.Trim();
            var result = await bulk.QueueAsync(GuildId, ActorId, _code, _amount, reason, targets);

            _ok = result.Ok;
            _message = result.Message;
            _confirmCount = null;

            if (result.Ok)
            {
                if (result.BatchId is { } batchId)
                {
                    await sp.GetRequiredService<AuditService>()
                        .RecordBulkQueueAsync(GuildId, ActorId, _code, _amount, targets.Count, reason, batchId);
                }

                await OnApplied.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
