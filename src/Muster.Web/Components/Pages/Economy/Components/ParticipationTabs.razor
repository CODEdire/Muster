@using Muster.Persistence.Queries
@* Participation-section configuration of the shared TabBar: Overview, the current + previous season (resolved by the
   shell), plus Ranking and the full Ledger. Older seasons are reachable from the Ledger's season filter. *@
<TabBar Tabs="Items" Active="@Active" AriaLabel="Participation sections" />

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter] public string Active { get; set; } = "overview";
    [Parameter] public SeasonInfo? Current { get; set; }
    [Parameter] public SeasonInfo? Previous { get; set; }

    private IReadOnlyList<TabBar.TabItem> Items
    {
        get
        {
            var items = new List<TabBar.TabItem>
            {
                new("overview", "Overview", "dashboard", $"/guilds/{GuildId}/participation"),
            };
            if (Current is not null)
            {
                items.Add(new(Current.Id.ToString(), Current.Name, "local_fire_department", $"/guilds/{GuildId}/participation/season/{Current.Id}"));
            }
            if (Previous is not null)
            {
                items.Add(new(Previous.Id.ToString(), Previous.Name, "history", $"/guilds/{GuildId}/participation/season/{Previous.Id}"));
            }
            items.Add(new("ranking", "Ranking", "leaderboard", $"/guilds/{GuildId}/participation/ranking"));
            items.Add(new("ledger", "Ledger", "receipt_long", $"/guilds/{GuildId}/participation/ledger"));
            return items;
        }
    }
}
