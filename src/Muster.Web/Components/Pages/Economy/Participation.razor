@page "/guilds/{GuildIdRaw}/participation"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildAdminComponentBase
@inject IServiceScopeFactory Scopes
@using Muster.Infrastructure.Services.Currencies
@using Muster.Infrastructure.Services.Web
@using Muster.Web.Components.Shared
@using Muster.Web.Components.Pages.Economy.Components
@using static Muster.Web.Components.Shared.LedgerMeta

<PageTitle>Participation — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need staff or admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="t-head t-wide">
        <div class="p-title">
            <span class="material-symbols-outlined" aria-hidden="true">trophy</span>
            <div>
                <div class="p-name">Participation</div>
                <div class="p-sub">points engagement across the server</div>
            </div>
        </div>
        @if (_supply is not null)
        {
            <span class="p-members"><span class="material-symbols-outlined" aria-hidden="true">group</span> @( _home?.MemberCount.ToString("N0") ?? "0") members</span>
        }
    </div>

    <ParticipationTabs GuildId="GuildId" Active="@ActiveTab" Current="Current" Previous="Previous" />

    @if (_supply is null)
    {
        <div class="panel glass empty">Points isn't configured in this server.</div>
    }
    else if (_home is null || _home.Seasons.Count == 0)
    {
        <div class="panel glass empty">Participation insights need seasonal points. <a href="/guilds/@GuildId/participation/ledger">Open the points ledger ↗</a></div>
    }
    else if (IsSeason && _seg is { } seg)
    {
        <div class="p-seasonhead">
            <span class="p-seasonname">@seg.Season.Name</span>
            @if (seg.Season.IsActive)
            {
                <span class="p-tag">current</span>
            }
        </div>

        <div class="stat-grid">
            <div class="card glass stat"><span class="kpi-ico material-symbols-outlined" aria-hidden="true">bolt</span>
                <span class="label">Participation</span><span class="num accent-green">@seg.ParticipationPct%</span><span class="subtitle">@seg.Earners.ToString("N0") of @seg.MemberCount.ToString("N0") members</span></div>
            <div class="card glass stat"><span class="kpi-ico material-symbols-outlined" aria-hidden="true">auto_awesome</span>
                <span class="label">Points awarded</span><span class="num">@seg.Awarded.ToString("N0")</span><span class="subtitle">this season</span></div>
            <div class="card glass stat"><span class="kpi-ico material-symbols-outlined" aria-hidden="true">person_add</span>
                <span class="label">New earners</span><span class="num">@seg.NewEarners.ToString("N0")</span><span class="subtitle">first-time</span></div>
            <div class="card glass stat"><span class="kpi-ico material-symbols-outlined" aria-hidden="true">cached</span>
                <span class="label">Returning</span><span class="num accent-amber">@seg.ReturningEarners.ToString("N0")</span><span class="subtitle">@(seg.PriorEarners > 0 ? $"{seg.RetentionPct}% of prior season" : "no prior season")</span></div>
        </div>

        <div class="p-card">
            <div class="panel-head"><h2>Points awarded · weekly</h2></div>
            @if (_weekly.Count == 0)
            {
                <p class="subtitle">No points awarded yet this season.</p>
            }
            else
            {
                <div class="p-bars">
                    @foreach (var w in _weekly)
                    {
                        <div class="p-bar-col"><div class="p-bar" style="height:@(Math.Round(w.Total * 108.0 / WeeklyMax))px"></div></div>
                    }
                </div>
                <div class="p-bar-labels">
                    @foreach (var w in _weekly)
                    {
                        <span>@w.Label</span>
                    }
                </div>
            }
        </div>

        <div class="p-cols">
            @SourcesCard("Where points come from", _seasonSources)
            @PodiumCard($"{seg.Season.Name} leaders", _seasonPodium)
        </div>
    }
    else if (!IsSeason && _home.Current is { } cur)
    {
        <div class="stat-grid">
            <div class="card glass stat"><span class="kpi-ico material-symbols-outlined" aria-hidden="true">auto_awesome</span>
                <span class="label">Lifetime awarded</span><span class="num">@_home.LifetimeAwarded.ToString("N0")</span><span class="subtitle">across @_home.Seasons.Count season@(_home.Seasons.Count == 1 ? "" : "s")</span></div>
            <div class="card glass stat"><span class="kpi-ico material-symbols-outlined" aria-hidden="true">groups</span>
                <span class="label">Members ever earned</span><span class="num">@_home.MembersEverEarned.ToString("N0")</span><span class="subtitle">@(_home.MemberCount > 0 ? $"{_home.MembersEverEarned * 100 / _home.MemberCount}% of {_home.MemberCount:N0}" : "members")</span></div>
            <div class="card glass stat"><span class="kpi-ico material-symbols-outlined" aria-hidden="true">bolt</span>
                <span class="label">Participation now</span><span class="num accent-green">@cur.ParticipationPct%</span><span class="subtitle">@cur.Season.Name</span></div>
            <div class="card glass stat"><span class="kpi-ico material-symbols-outlined" aria-hidden="true">cached</span>
                <span class="label">Retention</span><span class="num accent-amber">@cur.RetentionPct%</span><span class="subtitle">@(_home.Previous is { } pv ? $"{pv.Season.Name} → {cur.Season.Name}" : "no prior season")</span></div>
        </div>

        <div class="p-card">
            <div class="panel-head">
                <h2>Engagement by season</h2>
                <span class="legend">
                    <span><span class="sw bar"></span> points awarded</span>
                    <span><span class="ln rate"></span> participation rate</span>
                </span>
            </div>
            @{
                var seasons = _home.Seasons;
                var n = seasons.Count;
                const double W = 600, H = 168, pb = 26, pt = 14;
                var gw = W / n;
                var bw = Math.Min(70.0, gw * 0.5);
                var ratePts = new System.Text.StringBuilder();
            }
            <svg class="p-combo" viewBox="0 0 600 168" preserveAspectRatio="none" aria-hidden="true">
                <line x1="0" y1="@(H - pb)" x2="600" y2="@(H - pb)" class="axis" />
                @for (var i = 0; i < n; i++)
                {
                    var s = seasons[i];
                    var cx = i * gw + gw / 2;
                    var bh = s.Awarded / (double)SeasonBarMax * (H - pb - pt);
                    var ry = pt + (1 - s.ParticipationPct / 100.0) * (H - pb - pt);
                    ratePts.Append(Fmt(cx)).Append(',').Append(Fmt(ry)).Append(' ');
                    <rect class="p-cbar" x="@Fmt(cx - bw / 2)" y="@Fmt(H - pb - bh)" width="@Fmt(bw)" height="@Fmt(bh)" rx="3" />
                }
                <polyline class="p-rate" points="@ratePts.ToString().Trim()" />
                @for (var i = 0; i < n; i++)
                {
                    var s = seasons[i];
                    var cx = i * gw + gw / 2;
                    var ry = pt + (1 - s.ParticipationPct / 100.0) * (H - pb - pt);
                    <circle class="p-dot" cx="@Fmt(cx)" cy="@Fmt(ry)" r="3.5" />
                }
            </svg>
            <div class="p-bar-labels">
                @foreach (var s in seasons)
                {
                    <span>@s.Season.Name<br /><span class="cnt">@s.Awarded.ToString("N0") · @s.ParticipationPct%</span></span>
                }
            </div>
        </div>

        <div class="p-cols">
            @SourcesCard("Where points come from", _ovSources)
            @PodiumCard("Top earners · all time", _ovPodium)
        </div>
    }
}

@code {
    private static string Fmt(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private RenderFragment SourcesCard(string title, IReadOnlyList<SourceEarned> list) => __builder =>
    {
        <div class="p-card">
            <div class="panel-head"><h2>@title</h2></div>
            @if (list.Count == 0)
            {
                <p class="subtitle">No points awarded in this scope.</p>
            }
            else
            {
                @foreach (var s in list)
                {
                    <div class="src-row">
                        <span class="src-name"><span class="material-symbols-outlined" aria-hidden="true">@SourceIcon(s.Source)</span>@SourceLabel(s.Source)</span>
                        <div class="src-bar"><div class="fill" style="width:@(s.Total * 100 / SourceMax(list))%"></div></div>
                        <span class="src-val">@s.Total.ToString("N0")</span>
                    </div>
                }
            }
        </div>
    };

    private RenderFragment PodiumCard(string title, IReadOnlyList<LeaderboardRow> list) => __builder =>
    {
        <div class="p-card">
            <div class="panel-head"><h2>@title</h2></div>
            @if (list.Count == 0)
            {
                <p class="subtitle">No earners yet.</p>
            }
            else
            {
                @foreach (var h in list)
                {
                    <div class="hold-row">
                        <span class="rank @RankClass(h.Rank)">@h.Rank</span>
                        <UserChip Name="@h.DisplayName" AvatarUrl="@h.AvatarUrl" Href="@MusterLinks.MemberDetail(GuildId, h.UserId)" />
                        <span class="hold-val">@h.Total.ToString("N0")</span>
                    </div>
                }
            }
        </div>
    };
}
