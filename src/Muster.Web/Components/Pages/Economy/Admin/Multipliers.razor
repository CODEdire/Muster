@page "/guilds/{GuildIdRaw}/multipliers"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildAdminComponentBase
@inject RewardMultiplierCommandService Mults
@inject WebAdminService AdminRead
@inject WebGuildService Guilds
@using Muster.Domain.Entities.Tracking
@using Muster.Domain.Enums
@using Muster.Infrastructure.Commands
@using Muster.Infrastructure.Commands.Tracking
@using Muster.Infrastructure.Services.Web

<PageTitle>Multipliers — Muster</PageTitle>

@if (State == AccessState.NeedLogin)
{
    <div class="panel glass empty">Please <a href="/account/login">log in</a>.</div>
}
else if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <a class="back-link" href="@MusterLinks.TrackingSettings(GuildId)">← Tracking</a>
        <h1>Reward multipliers</h1>
        <p class="subtitle">Boost (or dampen) participation rewards during set windows, schedules, or for roles.
            Stacking &amp; cap are on the <a href="@MusterLinks.TrackingSettings(GuildId)">Tracking</a> page.</p>
    </div>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <div class="panel glass">
        <h2>Active rules</h2>
        @if (_multipliers.Count == 0)
        {
            <p class="empty">No multipliers yet. Add one below.</p>
        }
        else
        {
            <table class="leaderboard mult-table">
                <thead>
                    <tr>
                        <th>Name</th><th>×</th><th>Kind</th><th>When</th>
                        <th>Applies to</th><th>Conditions</th><th>State</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _multipliers)
                    {
                        <tr class="@(m.Enabled ? "" : "off")">
                            <td>@m.Name</td>
                            <td class="factor">×@m.Factor.ToString("0.##")</td>
                            <td>@m.Kind</td>
                            <td>@When(m)</td>
                            <td><span class="scope-pills">@ScopePills(m.Scope)</span></td>
                            <td>@Conditions(m)</td>
                            <td>@(m.Enabled ? "🟢 on" : "⚪ off")</td>
                            <td class="row-actions">
                                <button type="button" class="btn btn-sm btn-ghost"
                                        @onclick="() => ToggleAsync(m.Id, !m.Enabled)"
                                        disabled="@(_busyId == m.Id)">
                                    @(m.Enabled ? "Disable" : "Enable")
                                </button>
                                <button type="button" class="btn btn-sm btn-danger"
                                        @onclick="() => RemoveAsync(m.Id)"
                                        disabled="@(_busyId == m.Id)">
                                    @(_busyId == m.Id ? "…" : "Remove")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="panel glass">
        <h2>Add a multiplier</h2>

        <div class="kind-picker">
            <button type="button" class="kind-btn @(Add.Kind == "oneoff" ? "active" : "")"
                    @onclick='() => Add.Kind = "oneoff"'>
                <span class="material-symbols-outlined">event</span>
                One-off window
                <span class="kind-desc">a single start → end</span>
            </button>
            <button type="button" class="kind-btn @(Add.Kind == "recurring" ? "active" : "")"
                    @onclick='() => Add.Kind = "recurring"'>
                <span class="material-symbols-outlined">repeat</span>
                Recurring weekly
                <span class="kind-desc">days + time of day</span>
            </button>
            <button type="button" class="kind-btn @(Add.Kind == "role" ? "active" : "")"
                    @onclick='() => Add.Kind = "role"'>
                <span class="material-symbols-outlined">groups</span>
                Role (always on)
                <span class="kind-desc">applies while a member holds the role</span>
            </button>
        </div>

        <div class="form-grid">
            <label>Name
                <input type="text" @bind="Add.Name" placeholder="e.g. Friday raid ×2" />
            </label>
            <label>Factor
                <input type="number" step="0.1" @bind="Add.Factor" />
                <span class="subtitle">&gt;1 boosts, &lt;1 dampens</span>
            </label>
        </div>

        <fieldset class="field-group">
            <legend>Applies to</legend>
            <div class="scope-buttons">
                <button type="button" class="scope-btn @(Add.ScopeVoice ? "active" : "")"
                        @onclick="() => Add.ScopeVoice = !Add.ScopeVoice">🎤 Background voice</button>
                <button type="button" class="scope-btn @(Add.ScopeMessages ? "active" : "")"
                        @onclick="() => Add.ScopeMessages = !Add.ScopeMessages">💬 Messages</button>
                <button type="button" class="scope-btn @(Add.ScopeSessions ? "active" : "")"
                        @onclick="() => Add.ScopeSessions = !Add.ScopeSessions">📅 Sessions</button>
                <button type="button" class="scope-btn @(Add.ScopeQuests ? "active" : "")"
                        @onclick="() => Add.ScopeQuests = !Add.ScopeQuests">⚔️ Quests</button>
            </div>
        </fieldset>

        @if (Add.Kind == "oneoff")
        {
            <fieldset class="field-group">
                <legend>One-off window <span class="subtitle">(guild time: @_zoneId)</span></legend>
                <div class="form-grid">
                    <label>Start
                        <input type="datetime-local" @bind="Add.StartLocal" />
                    </label>
                    <label>End
                        <input type="datetime-local" @bind="Add.EndLocal" />
                    </label>
                </div>
            </fieldset>
        }
        else if (Add.Kind == "recurring")
        {
            <fieldset class="field-group">
                <legend>Recurring schedule <span class="subtitle">(guild time: @_zoneId)</span></legend>
                <div class="day-picker">
                    @foreach (var d in DayPills)
                    {
                        <button type="button" class="day-pill @(d.GetVal() ? "active" : "")"
                                @onclick="() => d.Toggle()">
                            @d.Label
                        </button>
                    }
                </div>
                <div class="form-grid">
                    <label>From
                        <input type="time" @bind="Add.StartTime" />
                    </label>
                    <label>To
                        <input type="time" @bind="Add.EndTime" />
                        <span class="subtitle">may wrap past midnight</span>
                    </label>
                </div>
            </fieldset>
        }
        else if (Add.Kind == "role")
        {
            <fieldset class="field-group">
                <legend>Role</legend>
                <label>Discord role
                    <select @bind="Add.RoleId">
                        <option value="0">— select —</option>
                        @foreach (var r in _roles)
                        {
                            <option value="@r.RoleId">@r.Name</option>
                        }
                    </select>
                </label>
            </fieldset>
        }

        @if (Add.Kind != "role")
        {
            <fieldset class="field-group">
                <legend>Conditions <span class="subtitle">(channel-wide; 0 = none)</span></legend>
                <div class="form-grid">
                    <label>Min people in channel
                        <input type="number" min="0" @bind="Add.MinPeople" />
                    </label>
                    <label>Min minutes channel active
                        <input type="number" min="0" @bind="Add.MinMinutes" />
                    </label>
                </div>
                <p class="subtitle">Only applies while the voice channel has at least this many people AND has been
                    continuously occupied this long. Ignored for Messages / Quests.</p>
            </fieldset>
        }

        <div class="preview-box">
            <span class="material-symbols-outlined">visibility</span>
            <span><b>When this fires:</b> @PreviewWhen()</span>
        </div>

        <div class="btn-row">
            <button type="button" @onclick="AddAsync" disabled="@_saving">
                @(_saving ? "Saving…" : "Add multiplier")
            </button>
            <button type="button" class="btn btn-ghost" @onclick="ResetForm">Reset</button>
        </div>
    </div>
}
