@page "/guilds/{GuildIdRaw}/wallet/analytics"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildMemberComponentBase
@inject IServiceScopeFactory Scopes
@using Muster.Domain.Enums
@using Muster.Infrastructure.Services.Currencies
@using Muster.Infrastructure.Services.Web
@using static Muster.Web.Components.Shared.LedgerMeta

<PageTitle>Wallet analytics — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="an-head full-bleed">
        <nav class="wallet-crumb" aria-label="Breadcrumb">
            <a href="/guilds/@GuildId/wallet">Wallet</a>
            <span class="material-symbols-outlined sep" aria-hidden="true">chevron_right</span>
            <UserChip Name="@_displayName" AvatarUrl="@_avatarUrl" Href="@($"/guilds/{GuildId}/wallet")" />
            <span class="material-symbols-outlined sep" aria-hidden="true">chevron_right</span>
            <span class="who">Analytics</span>
        </nav>
        <div class="an-controls">
            @if (_currencies.Count > 1)
            {
                <div class="wallet-switch" role="tablist">
                    @foreach (var c in _currencies)
                    {
                        <button type="button" role="tab" class="cur-tab @(c.Code == _sel ? "active" : "")"
                                aria-selected="@(c.Code == _sel)" @onclick="() => SelectCurrency(c.Code)">
                            @if (c.Primary)
                            {
                                <span class="material-symbols-outlined star" title="Guild default" aria-hidden="true">star</span>
                            }
                            @c.Name
                        </button>
                    }
                </div>
            }
            @if (IsScore && _seasons.Count > 0)
            {
                <select class="dg-select" @onchange="OnSeason">
                    @foreach (var s in _seasons)
                    {
                        <option value="@s.Id" selected="@(s.Id == _season)">@s.Name@(s.IsActive ? " (active)" : "")</option>
                    }
                </select>
            }
            <select class="dg-select" @onchange="OnPeriod">
                @foreach (var (val, lbl) in Periods)
                {
                    <option value="@val" selected="@(val == _period)">@lbl</option>
                }
            </select>
        </div>
    </div>

    <div class="stat-grid">
        @if (IsScore)
        {
            <div class="stat an-kpi">
                <div class="label">Season points</div>
                <div class="num">@((_points?.Balance ?? _kpis.Balance).ToString("N0")) <span class="unit">@SelUnit</span></div>
                <p class="subtitle">@((_points?.Seasonal ?? false) ? "current season" : "all time")</p>
            </div>
            <div class="stat an-kpi">
                <div class="label">Earned</div>
                <div class="num pos">+@_kpis.Earned.ToString("N0")</div>
                <p class="subtitle">@(_earned.Count > 0 ? $"top: {SourceLabel(_earned[0].Source)}" : "—")</p>
            </div>
            <div class="stat an-kpi">
                <div class="label">Points rank</div>
                <div class="num">@(_rank > 0 ? $"#{_rank}" : "—")</div>
                <p class="subtitle">@(_holders > 0 ? $"of {_holders} members" : "—")</p>
            </div>
            <div class="stat an-kpi">
                <div class="label">Voice · season</div>
                <div class="num">@Hm(_points?.Voice.SeasonMinutes ?? 0)</div>
                <p class="subtitle">@((_points?.Voice.SeasonRank ?? 0) > 0 ? $"rank #{_points!.Voice.SeasonRank}" : "—")</p>
            </div>
        }
        else
        {
            <div class="stat an-kpi">
                <div class="label">Available</div>
                <div class="num">@_kpis.Available.ToString("N0") <span class="unit">@SelUnit</span></div>
                <p class="subtitle">of @_kpis.Balance.ToString("N0") total@(_kpis.Held > 0 ? $" · {_kpis.Held:N0} held" : "")</p>
            </div>
            <div class="stat an-kpi">
                <div class="label">Income</div>
                <div class="num pos">+@_kpis.Earned.ToString("N0")</div>
                <p class="subtitle">@(_earned.Count > 0 ? $"top: {SourceLabel(_earned[0].Source)}" : "—")</p>
            </div>
            <div class="stat an-kpi">
                <div class="label">Spending</div>
                <div class="num neg">@(_kpis.Spent > 0 ? "−" : "")@_kpis.Spent.ToString("N0")</div>
                <p class="subtitle">@(_spent.Count > 0 ? $"top: {SourceLabel(_spent[0].Source)}" : "—")</p>
            </div>
            <div class="stat an-kpi">
                <div class="label">Wealth rank</div>
                <div class="num">@(_rank > 0 ? $"#{_rank}" : "—")</div>
                <p class="subtitle">@(_holders > 0 ? $"of {_holders} holders" : "—")</p>
            </div>
        }
    </div>

    <div class="an-card">
        <div class="panel-head">
            <h2>Balance@(IsScore ? "" : " · candles per month")</h2>
            @if (!IsScore && _candles.Count > 0)
            {
                <span class="legend"><span class="sw earned"></span>up <span class="sw spent"></span>down <span class="ln close"></span>balance <span class="ln trend"></span>trend</span>
            }
        </div>
        @if (IsScore)
        {
            @if (string.IsNullOrEmpty(BalanceLine()))
            {
                <p class="subtitle">Not enough history in this window yet.</p>
            }
            else
            {
                <svg class="an-line" viewBox="0 0 600 150" preserveAspectRatio="none" aria-hidden="true">
                    <path class="area" d="@BalanceArea()" />
                    <polyline class="line" points="@BalanceLine()" />
                </svg>
                <div class="an-mlabels">
                    @foreach (var m in _months)
                    {
                        <span>@MonthLabel(m)</span>
                    }
                </div>
            }
        }
        else if (_candles.Count == 0)
        {
            <p class="subtitle">Not enough history in this window yet.</p>
        }
        else
        {
            <svg class="an-candles" viewBox="0 0 600 180" preserveAspectRatio="none" aria-hidden="true">
                <line x1="0" y1="172" x2="600" y2="172" class="axis" />
                @if (_trend is { } t)
                {
                    <line class="trend" x1="@Fmt(t.X1)" y1="@Fmt(t.Y1)" x2="@Fmt(t.X2)" y2="@Fmt(t.Y2)" />
                }
                @foreach (var c in _candles)
                {
                    <line class="wick @(c.Up ? "up" : "down")" x1="@Fmt(c.X)" y1="@Fmt(c.WickTop)" x2="@Fmt(c.X)" y2="@Fmt(c.WickTop + c.WickH)" />
                    <rect class="body @(c.Up ? "up" : "down")" x="@Fmt(c.X - c.BodyW / 2)" y="@Fmt(c.BodyTop)" width="@Fmt(c.BodyW)" height="@Fmt(c.BodyH)" rx="1" />
                }
                <polyline class="close" points="@_closeLine" />
            </svg>
            <div class="an-mlabels">
                @foreach (var c in _candles)
                {
                    <span>@c.Label</span>
                }
            </div>
        }
    </div>

    @if (IsScore && _seasonTotals.Count > 0)
    {
        <div class="an-card">
            <div class="panel-head">
                <h2>Season over season</h2>
                <span class="legend">@SelUnit earned per season · click to view</span>
            </div>
            @foreach (var st in _seasonTotals)
            {
                <div class="season-row @(st.Season.Id == _season ? "sel" : "")" @onclick="() => SelectSeason(st.Season.Id)">
                    <span class="season-name">@st.Season.Name@(st.Season.IsActive ? " · active" : "")</span>
                    <div class="season-bar"><div class="fill" style="width:@(st.Total * 100 / SeasonMax)%"></div></div>
                    <span class="season-val">@st.Total.ToString("N0")</span>
                </div>
            }
        </div>
    }

    <div class="wallet-cols @(IsScore ? "single" : "")">
        <div class="an-card">
            <div class="panel-head"><h2>Earned by source</h2></div>
            @if (_earned.Count == 0)
            {
                <p class="subtitle">No earnings in this window.</p>
            }
            else
            {
                @foreach (var s in _earned)
                {
                    <div class="src-row">
                        <span class="src-name">@SourceLabel(s.Source)</span>
                        <div class="src-bar"><div class="fill earned" style="width:@(s.Earned * 100 / EarnedMax)%"></div></div>
                        <span class="src-val">+@s.Earned.ToString("N0")</span>
                    </div>
                }
            }
        </div>
        @if (!IsScore)
        {
            <div class="an-card">
                <div class="panel-head"><h2>Spent by source</h2></div>
                @if (_spent.Count == 0)
                {
                    <p class="subtitle">No spending in this window.</p>
                }
                else
                {
                    @foreach (var s in _spent)
                    {
                        <div class="src-row">
                            <span class="src-name">@SourceLabel(s.Source)</span>
                            <div class="src-bar"><div class="fill spent" style="width:@(s.Spent * 100 / SpentMax)%"></div></div>
                            <span class="src-val">−@s.Spent.ToString("N0")</span>
                        </div>
                    }
                }
            </div>
        }
    </div>

    @if (_months.Count > 0 || _earned.Count > 0)
    {
        <div class="an-card">
            <div class="panel-head"><h2>Trends</h2></div>
            @if (_earned.Count > 0)
            {
                <div class="insight"><span class="material-symbols-outlined" aria-hidden="true">@SourceIcon(_earned[0].Source)</span> @SourceLabel(_earned[0].Source) drives @PercentOfEarned(_earned[0]) of your earnings</div>
            }
            @if (_spent.Count > 0)
            {
                <div class="insight"><span class="material-symbols-outlined" aria-hidden="true">@SourceIcon(_spent[0].Source)</span> @SourceLabel(_spent[0].Source) is your biggest spend</div>
            }
            @if (_months.Count > 0)
            {
                <div class="insight"><span class="material-symbols-outlined" aria-hidden="true">trending_up</span> Net positive @NetPositiveMonths of @_months.Count month@(_months.Count == 1 ? "" : "s")</div>
            }
        </div>
    }
}
