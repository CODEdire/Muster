@page "/guilds/{GuildIdRaw}/me"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildMemberComponentBase
@implements IDisposable
@inject IServiceScopeFactory Scopes
@inject ISessionUpdateNotifier Notifier
@using Muster.Domain.Enums
@using Muster.Infrastructure.Services.Currencies
@using Muster.Infrastructure.Services.Tracking
@using Muster.Infrastructure.Services.Web
@using Muster.Infrastructure.Services.Platform
@using Muster.Web.Components.Shared
@using static Muster.Web.Components.Shared.LedgerMeta

<PageTitle>Me — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <h1>You</h1>
        <p class="subtitle">Your standing, live sessions, and recent activity in this server.</p>
    </div>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <TabFrame ActiveId="@_tab" ActiveIdChanged="t => _tab = t">
        <TabPane Id="overview" Label="Overview" Icon="dashboard">
            <div class="member-detail-section">
                <h2>Balances</h2>
                <BalancesGrid Points="_points" PointsSeasonal="_pointsSeasonal" Wallets="_wallets" />

                <h2>Voice</h2>
                <VoiceStatsGrid Voice="_voice" />

                @if (_active.Count > 0)
                {
                    <h2>Active now</h2>
                    <div class="dg-scroll">
                        <table class="dg-table">
                            <thead><tr><th>Session</th><th>Channel</th><th>Your time</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var s in _active)
                                {
                                    <tr>
                                        <td><a href="/guilds/@GuildId/sessions/@s.SessionId">@s.Name</a></td>
                                        <td><ChannelLabel Name="@s.VoiceChannelName" /></td>
                                        <td>@Dur(s.MyMinutes)</td>
                                        <td>@(s.PresentNow ? "🟢 Active" : "🟡 Paused")</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => OptOutAsync(s.SessionId)">Opt out</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="subtitle">Opting out removes you from that one session for the rest of it — it doesn't change your standing preference (set that on the <a href="/guilds/@GuildId/settings#privacy">settings page</a>).</p>
                }
            </div>
        </TabPane>

        <TabPane Id="activity" Label="Activity" Icon="timeline">
            <div class="dg-scroll">
                <table class="dg-table">
                    <thead><tr><th>Session</th><th>Channel</th><th>Ended</th><th class="num">Your time</th></tr></thead>
                    <tbody>
                        @if (_history.Count == 0)
                        {
                            <tr class="dg-empty"><td colspan="4">No past sessions yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var s in _history)
                            {
                                <tr>
                                    <td><a href="/guilds/@GuildId/sessions/@s.SessionId">@s.Name</a></td>
                                    <td><ChannelLabel Name="@s.VoiceChannelName" /></td>
                                    <td>@if (s.EndedAt is { } e) { <LocalTime Value="e" Zone="@_zoneId" /> } else { <span class="subtitle">—</span> }</td>
                                    <td class="num">@Dur(s.MyMinutes)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="dg-footer">
                <span class="dg-tz">last @HistoryLimit sessions · times in <LocalTime ShowZone="true" Zone="@_zoneId" /></span>
                <a class="btn btn-ghost btn-sm" href="/guilds/@GuildId/sessions">All sessions →</a>
            </div>
        </TabPane>

        <TabPane Id="wallet" Label="Wallet" Icon="account_balance_wallet">
            <div class="member-detail-section">
                <p class="subtitle">Open your <a href="/guilds/@GuildId/wallet">Wallet</a> for full ledger history, source/range filters, and sending to other members.</p>
                <p class="subtitle">Or jump to <a href="/guilds/@GuildId/points">Points</a> for points-only history and leaderboard context.</p>
            </div>
        </TabPane>
    </TabFrame>
}

@code {
    private const int HistoryLimit = 10;

    private string _tab = "overview";
    private long _points;
    private bool _pointsSeasonal;
    private MemberVoiceStats _voice = new(0, 0, 0);
    private IReadOnlyList<WalletBalance> _wallets = [];
    private IReadOnlyList<MemberSessionView> _active = [];
    private IReadOnlyList<MemberSessionView> _history = [];
    private string _zoneId = TimeZoneService.Utc;

    // Fresh DI scope per (re)load — see SessionDetail: avoids reusing the circuit-scoped DbContext across refreshes.
    protected override async Task LoadAsync()
    {
        await using var scope = Scopes.CreateAsyncScope();
        var sp = scope.ServiceProvider;
        var participation = sp.GetRequiredService<ParticipationReadService>();

        _zoneId = await sp.GetRequiredService<TimeZoneService>().ResolveZoneIdAsync(GuildId, UserId);
        _voice = await participation.MemberVoiceStatsAsync(GuildId, UserId);
        _active = await participation.MemberActiveSessionsAsync(GuildId, UserId);
        _history = await participation.MemberSessionHistoryAsync(GuildId, UserId, HistoryLimit);

        var snap = await sp.GetRequiredService<PointsReadService>().GetSnapshotAsync(GuildId, UserId);
        _points = snap.Balance;
        _pointsSeasonal = snap.Seasonal;

        _wallets = await sp.GetRequiredService<WalletReadService>().GetWalletsAsync(GuildId, UserId);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Notifier.Updated += OnSessionChanged;
        }
    }

    private void OnSessionChanged(SessionAttendanceChanged change)
    {
        if (State != AccessState.Ready || change.GuildId != GuildId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task OptOutAsync(Guid sessionId)
    {
        await using (var scope = Scopes.CreateAsyncScope())
        {
            if (await scope.ServiceProvider.GetRequiredService<TrackingSessionService>().OptOutMemberAsync(GuildId, sessionId, UserId))
            {
                Message = "You've opted out of that session.";
            }
        }

        await LoadAsync();
    }

    public void Dispose() => Notifier.Updated -= OnSessionChanged;

    private static string Dur(int minutes)
    {
        var h = minutes / 60;
        var m = minutes % 60;
        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }
}
