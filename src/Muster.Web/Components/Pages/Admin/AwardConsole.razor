@page "/guilds/{GuildIdRaw}/award"
@inherits GuildAdminComponentBase
@inject WebAdminService Admin
@inject Wolverine.IMessageBus Bus
@inject CurrencyAdminService CurrencyAdmin

<PageTitle>Award — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId/admin">← Admin</a>
        <h1>Award</h1>
        <p class="subtitle">Grant a currency to a member for an off-platform contribution.</p>
    </div>

    <div class="panel glass">
        @if (Message is not null)
        {
            <p class="message">@Message</p>
        }

        <EditForm class="form-grid" Model="Input" FormName="award" OnValidSubmit="SubmitAsync">
            <label>Member
                <InputSelect @bind-Value="Input.MemberId">
                    <option value="0">— select —</option>
                    @foreach (var m in _members)
                    {
                        <option value="@m.UserId">@m.DisplayName</option>
                    }
                </InputSelect>
            </label>
            <label>Currency
                <InputSelect @bind-Value="Input.Currency">
                    @foreach (var c in _currencies)
                    {
                        <option value="@c.Code">@c.Code — @c.Name</option>
                    }
                </InputSelect>
            </label>
            <label>Amount <InputNumber @bind-Value="Input.Amount" /></label>
            <label>Reason <InputText @bind-Value="Input.Reason" /></label>
            <div class="btn-row"><button type="submit">Award</button></div>
        </EditForm>
    </div>
}

@code {
@using Muster.Contracts
@using Muster.Infrastructure.Services.Currencies
@using Muster.Infrastructure.Services.Web
    [SupplyParameterFromForm] private AwardInput Input { get; set; } = new();

    private IReadOnlyList<MemberOption> _members = [];
    private IReadOnlyList<CurrencyView> _currencies = [];

    protected override async Task LoadAsync()
    {
        _members = await Admin.GetMembersAsync(GuildId);
        _currencies = await CurrencyAdmin.ListAsync(GuildId);
    }

    private async Task SubmitAsync()
    {
        if (Input.MemberId == 0)
        {
            Message = "Please choose a member.";
            return;
        }

        if (Input.Amount <= 0)
        {
            Message = "Amount must be greater than zero.";
            return;
        }

        var code = Input.Currency ?? "POINTS";
        var reason = string.IsNullOrWhiteSpace(Input.Reason) ? "Award" : Input.Reason!.Trim();
        // Award via the staff CQRS path (authorized + audited by the middleware): a positive Delta is a mint.
        var result = await Bus.InvokeAsync<Result>(new AdjustCurrency(GuildId, UserId, code, Input.MemberId, Input.Amount, reason));

        Message = result.Ok
            ? await HumanizeAsync($"Awarded {Input.Amount} {code.ToUpperInvariant()} to <@{Input.MemberId}> — {reason}")
            : result.Status switch
            {
                "CurrencyNotFound" => $"Unknown currency '{code}'.",
                "Forbidden" => "You're not allowed to do that.",
                var other => other,
            };

        if (result.Ok)
        {
            Input = new AwardInput();
        }
    }

    public class AwardInput
    {
        public ulong MemberId { get; set; }
        public string? Currency { get; set; } = "POINTS";
        public long Amount { get; set; }
        public string? Reason { get; set; }
    }
}
