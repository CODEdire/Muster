@page "/guilds/{GuildIdRaw}/muster-templates"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildAdminComponentBase
@inject MusterTemplateService Templates
@inject ICurrencyAdminService CurrencyAdmin
@using Muster.Domain.Entities.Musters
@using Muster.Infrastructure.Services.Currencies
@using Muster.Infrastructure.Services.Membership
@using Muster.Infrastructure.Services.Musters

<PageTitle>Muster templates — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    <PageHeader Crumbs="@(new PageHeader.Crumb[] { new("Admin", $"/guilds/{GuildId}/admin"), new("Muster settings", $"/guilds/{GuildId}/muster-settings"), new("Templates") })"
                Subtitle="Named reward presets creators pick from. A Muster Creator can only post from a template; managers can also override." />

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <div class="panel glass dg-frame">
        <div class="dg-toolbar">
            <div class="dg-filters">
                <input type="search" class="dg-search" placeholder="Search name or description…" @bind="_search" @bind:event="oninput" />
                <select class="dg-select" @bind="_enabledFilter">
                    <option value="all">All</option>
                    <option value="enabled">Enabled</option>
                    <option value="disabled">Disabled</option>
                </select>
            </div>
            <div class="dg-actions">
                <a class="btn btn-sm" href="/guilds/@GuildId/muster-templates/new">
                    <span class="material-symbols-outlined">add</span> New template
                </a>
            </div>
        </div>

        <div class="dg-scroll">
            <table class="dg-table">
                <thead>
                    <tr>
                        <th class="sortable" @onclick='() => SetSort("name")'>Name @Ind("name")</th>
                        <th class="sortable num" @onclick='() => SetSort("points")'>Points @Ind("points")</th>
                        <th class="sortable num" @onclick='() => SetSort("coins")'>Coins @Ind("coins")</th>
                        <th class="sortable num" @onclick='() => SetSort("capacity")'>Capacity @Ind("capacity")</th>
                        <th class="sortable num" @onclick='() => SetSort("min")'>Min @Ind("min")</th>
                        <th class="sortable num" @onclick='() => SetSort("expiry")'>Auto-close @Ind("expiry")</th>
                        <th class="sortable num" @onclick='() => SetSort("retention")'>Keep @Ind("retention")</th>
                        <th class="sortable" @onclick='() => SetSort("enabled")'>Enabled @Ind("enabled")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_list is null)
                    {
                        <tr class="dg-empty"><td colspan="9">Loading…</td></tr>
                    }
                    else if (Filtered.Count == 0)
                    {
                        <tr class="dg-empty"><td colspan="9">@(_list.Count == 0 ? "No templates yet — create one to get started." : "No templates match your filter.")</td></tr>
                    }
                    else
                    {
                        @foreach (var t in Filtered)
                        {
                            <tr>
                                <td>
                                    <a href="/guilds/@GuildId/muster-templates/@t.Id/edit">@t.Name</a>
                                    @if (!string.IsNullOrWhiteSpace(t.Description))
                                    {
                                        <div class="subtitle dg-sub">@t.Description</div>
                                    }
                                </td>
                                <td class="num">@(t.Points > 0 ? t.Points.ToString("N0") : "—")</td>
                                <td class="num">@(t.Coins > 0 ? $"{t.Coins:N0} {CoinCode(t.CoinCurrencyId)}" : "—")</td>
                                <td class="num">@(t.Capacity is { } cap ? cap.ToString("N0") : "—")</td>
                                <td class="num">@(t.MinCheckIns > 0 ? t.MinCheckIns.ToString("N0") : "—")</td>
                                <td class="num">@(t.ExpiryHours is { } ex ? $"{ex}h" : "—")</td>
                                <td class="num">@(t.RetentionHours)h</td>
                                <td>@(t.Enabled ? "✓" : "—")</td>
                                <td class="dg-actions-col">
                                    <a class="icon-btn" title="Edit" href="/guilds/@GuildId/muster-templates/@t.Id/edit"><span class="material-symbols-outlined">edit</span></a>
                                    <button type="button" class="icon-btn danger" title="Delete" disabled="@_busy" @onclick="() => Delete(t)"><span class="material-symbols-outlined">delete</span></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="dg-footer">
            <span class="dg-tz">@(Filtered.Count) of @(_list?.Count ?? 0) template@(_list?.Count == 1 ? "" : "s")</span>
        </div>
    </div>
}

<style>
    .dg-sub { margin: 0.15rem 0 0; font-size: 0.78rem; }
</style>

@code {
    protected override GuildAccessTier RequiredAccess => GuildAccessTier.TrackingManager | GuildAccessTier.Officer;

    private IReadOnlyList<MusterTemplate>? _list;
    private IReadOnlyList<CurrencyView> _coins = [];
    private bool _busy;

    private string _search = "";
    private string _enabledFilter = "all";
    private string _sortKey = "name";
    private bool _descending;

    protected override async Task LoadAsync()
    {
        _list = await Templates.ListAsync(GuildId);
        _coins = (await CurrencyAdmin.ListAsync(GuildId)).Where(c => c.IsSpendable).ToList();
    }

    // In-memory filter + sort — the template set is small (a handful per guild).
    private IReadOnlyList<MusterTemplate> Filtered
    {
        get
        {
            if (_list is null)
            {
                return [];
            }

            IEnumerable<MusterTemplate> q = _list;

            if (_enabledFilter == "enabled") { q = q.Where(t => t.Enabled); }
            else if (_enabledFilter == "disabled") { q = q.Where(t => !t.Enabled); }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(t => (t.Name?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                              || (t.Description?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            Func<MusterTemplate, IComparable> key = _sortKey switch
            {
                "points" => t => t.Points,
                "coins" => t => t.Coins,
                "capacity" => t => t.Capacity ?? -1,
                "min" => t => t.MinCheckIns,
                "expiry" => t => t.ExpiryHours ?? -1,
                "retention" => t => t.RetentionHours,
                "enabled" => t => t.Enabled ? 1 : 0,
                _ => t => t.Name ?? "",
            };

            q = _descending ? q.OrderByDescending(key).ThenBy(t => t.Name) : q.OrderBy(key).ThenBy(t => t.Name);
            return q.ToList();
        }
    }

    private void SetSort(string column)
    {
        _descending = _sortKey == column ? !_descending : false;
        _sortKey = column;
    }

    private string Ind(string column) => _sortKey == column ? (_descending ? "▼" : "▲") : "";

    private string CoinCode(Guid? id) => _coins.FirstOrDefault(c => c.Id == id)?.Code ?? "coins";

    private async Task Delete(MusterTemplate t)
    {
        _busy = true;
        try
        {
            await Templates.DeleteAsync(GuildId, t.Id);
            await AuditAsync("muster.template", $"delete:{t.Name}");
            Message = $"Deleted “{t.Name}”.";
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
