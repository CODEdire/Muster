@page "/guilds/{GuildIdRaw}/members/{MemberId}"
@inherits GuildAdminComponentBase
@inject WebMemberService Members

<PageTitle>Member — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need officer access for this server.</div>
}
else if (State == AccessState.Ready && _detail is not null)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId">← Dashboard</a>
        <h1>@_detail.DisplayName</h1>
        <p class="subtitle">Member detail</p>
    </div>

    <MemberPanel Detail="_detail" />
}

@code {
@using Muster.Infrastructure.Services.Web
    [Parameter] public string MemberId { get; set; } = string.Empty;

    private MemberDetailView? _detail;

    // Officers may view any member's detail.
    protected override bool OfficerSufficient => true;

    protected override async Task LoadAsync()
    {
        if (ulong.TryParse(MemberId, out var memberId))
        {
            _detail = await Members.GetAsync(GuildId, memberId);
        }
    }
}
