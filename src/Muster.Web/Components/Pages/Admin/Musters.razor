@page "/guilds/{GuildIdRaw}/musters"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildAdminComponentBase
@inject IMusterReadService Reads
@inject GuildMusterSettingsService MusterStore
@inject MusterTemplateService TemplateSvc
@inject ICurrencyAdminService CurrencyAdmin
@inject Muster.Web.GuildChannelOptions Channels
@inject Wolverine.IMessageBus Bus
@using Muster.Contracts
@using Muster.Domain.Entities.Guilds
@using Muster.Domain.Entities.Musters
@using Muster.Domain.Enums
@using Muster.Infrastructure.Commands
@using Muster.Infrastructure.Services.Currencies
@using Muster.Infrastructure.Services.Membership
@using Muster.Infrastructure.Services.Musters
@using Muster.Infrastructure.Services.Web

<PageTitle>Musters — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <h1>Musters</h1>
        <p class="subtitle">Reaction-style check-ins: post a card, members tap Check-In, you track who's in.</p>
    </div>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <div class="panel glass">
        <h2>Post a muster</h2>
        <div class="form-grid">
            <label>Prompt@(_templateHasPrompt ? " (optional — template provides one)" : "")
                <input class="input" @bind="_prompt" placeholder="@(_templateHasPrompt ? "Leave blank to use the template's prompt" : "What members are checking in for")" maxlength="2000" />
            </label>
            <label>Title (optional)
                <input class="input" @bind="_title" placeholder="Heading shown above the prompt" maxlength="100" />
            </label>
            <label>Template
                <select class="dg-select" @bind="_templateId">
                    @if (_isManager)
                    {
                        <option value="">— Custom rewards —</option>
                    }
                    @foreach (var t in _templates)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
                @if (!_isManager && _templates.Count == 0)
                {
                    <span class="subtitle warn-text">No templates available — ask an admin to create one.</span>
                }
            </label>
            @if (_isManager && string.IsNullOrEmpty(_templateId))
            {
                <label>Points (participation)
                    <input class="input" type="number" min="0" @bind="_points" />
                </label>
                <label>Coins (optional)
                    <input class="input" type="number" min="0" @bind="_coins" />
                </label>
                <label>Coin currency
                    <select class="dg-select" @bind="_coinCurrencyId">
                        <option value="">— none —</option>
                        @foreach (var c in _coinCurrencies)
                        {
                            <option value="@c.Id">@c.Code — @c.Name</option>
                        }
                    </select>
                </label>
                <label>Minimum check-ins to reward
                    <input class="input" type="number" min="0" placeholder="No minimum" @bind="_minCheckIns" />
                </label>
            }
            <label>Capacity (optional)
                <input class="input" type="number" min="1" placeholder="Uncapped" @bind="_capacity" />
            </label>
            <label>Auto-close after (hours; 0 = guild default)
                <input class="input" type="number" min="0" @bind="_expiresHours" />
            </label>
            <label class="check">
                <input type="checkbox" @bind="_checkMeIn" /> Check me in
            </label>
            <label>Channel
                <select class="dg-select" @bind="_channelId">
                    <option value="0">Server default@(_defaultChannelId == 0 ? " — none set, no Discord card" : "")</option>
                    @foreach (var grp in _channels.GroupBy(c => c.Kind))
                    {
                        <optgroup label="@grp.Key">
                            @foreach (var c in grp)
                            {
                                <option value="@c.Id">@(c.Kind == "Voice" ? "🔊 " : "#")@c.Name</option>
                            }
                        </optgroup>
                    }
                </select>
            </label>
        </div>
        <div class="btn-row">
            <button type="button" disabled="@_posting" @onclick="PostAsync">Post muster</button>
        </div>
        <p class="subtitle">Cards post to the configured muster channel (set with <code>/muster config channel</code>). With none set, the muster is tracked here but no Discord card is posted.</p>
    </div>

    <div class="dg-toolbar">
        <label class="checkbox"><input type="checkbox" @bind="_includeClosed" @bind:after="LoadListAsync" /> Show closed</label>
    </div>

    <div class="dg-scroll">
        <table class="dg-table">
            <thead>
                <tr><th>Muster</th><th>Status</th><th class="num">Checked in</th><th class="num">Reward</th><th>Linked</th><th>Created</th><th></th></tr>
            </thead>
            <tbody>
                @if (_list is null || _list.Count == 0)
                {
                    <tr class="dg-empty"><td colspan="7">@(_list is null ? "Loading…" : "No musters yet.")</td></tr>
                }
                else
                {
                    @foreach (var m in _list)
                    {
                        <tr>
                            <td><a href="@MusterLinks.MusterDetail(GuildId, m.Id)">@m.Display</a></td>
                            <td>@StatusLabel(m.Status)</td>
                            <td class="num">@m.CheckedIn@(m.Capacity is { } c ? $"/{c}" : "")</td>
                            <td class="num">@RewardLabel(m.Points, m.Coins, m.CoinCode)</td>
                            <td>@(m.LinkedSessions > 0 ? $"{m.LinkedSessions} session(s)" : "—")</td>
                            <td><LocalTime Value="m.CreatedAt" /></td>
                            <td class="dg-actions-col">
                                <a class="icon-btn" title="View" href="@MusterLinks.MusterDetail(GuildId, m.Id)"><span class="material-symbols-outlined">visibility</span></a>
                                @if (_isManager && m.Status == MusterStatus.Open)
                                {
                                    <button type="button" class="icon-btn danger" title="Close" disabled="@_busy" @onclick="() => CloseAsync(m.Id)"><span class="material-symbols-outlined">stop_circle</span></button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    protected override GuildAccessTier RequiredAccess => GuildAccessTier.TrackingManager | GuildAccessTier.MusterCreator | GuildAccessTier.Officer;

    private IReadOnlyList<MusterListItem>? _list;
    private bool _includeClosed;
    private bool _posting;
    private bool _busy;

    private string _prompt = "";
    private string _title = "";
    private int _points;
    private int _coins;
    private string _coinCurrencyId = "";
    private string _templateId = "";
    private int? _capacity;
    private int? _minCheckIns;
    private int _expiresHours;
    private bool _checkMeIn = true;
    private ulong _channelId;
    private ulong _defaultChannelId;
    private bool _isManager;
    private IReadOnlyList<GuildChannelOptions.ChannelOption> _channels = [];
    private IReadOnlyList<MusterTemplate> _templates = [];
    private IReadOnlyList<CurrencyView> _coinCurrencies = [];

    protected override async Task LoadAsync()
    {
        _isManager = await Auth.IsTrackingManagerAsync(GuildId, UserId);

        var ms = await MusterStore.GetAsync(GuildId);
        _defaultChannelId = ms.MusterChannelId;
        _checkMeIn = ms.CreatorAutoCheckIn;

        // Offer chat channels; when an allow-list is set, only those.
        var chat = await Channels.ChatAsync(GuildId);
        _channels = ms.AllowedChannelIds.Count == 0 ? chat : chat.Where(c => ms.AllowedChannelIds.Contains(c.Id)).ToList();

        _templates = await TemplateSvc.ListAsync(GuildId, includeDisabled: false);
        _coinCurrencies = _isManager ? (await CurrencyAdmin.ListAsync(GuildId)).Where(c => c.IsSpendable).ToList() : [];

        // Creators (non-managers) can't free-hand rewards — default to the first template.
        if (!_isManager && string.IsNullOrEmpty(_templateId))
        {
            _templateId = _templates.FirstOrDefault()?.Id.ToString() ?? "";
        }

        await LoadListAsync();
    }

    private async Task LoadListAsync()
    {
        _list = await Reads.ListAsync(GuildId, _includeClosed);
    }

    // A selected template can supply the prompt, so the field is only required when posting without one.
    private bool _templateHasPrompt =>
        Guid.TryParse(_templateId, out var tg) && !string.IsNullOrWhiteSpace(_templates.FirstOrDefault(t => t.Id == tg)?.Prompt);

    private async Task PostAsync()
    {
        if (_posting)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_prompt) && !_templateHasPrompt)
        {
            Message = "Enter a prompt (or pick a template that has one).";
            return;
        }

        _posting = true;
        try
        {
            DateTimeOffset? expires = _expiresHours > 0 ? DateTimeOffset.UtcNow.AddHours(_expiresHours) : null;
            Guid? templateId = Guid.TryParse(_templateId, out var tg) ? tg : null;
            var custom = _isManager && templateId is null; // manager picked "— Custom rewards —"

            // ChannelId 0 → the card renderer falls back to the guild's configured muster channel.
            var command = new CreateMuster(GuildId, UserId, _channelId,
                string.IsNullOrWhiteSpace(_title) ? null : _title.Trim(), _prompt.Trim(),
                TemplateId: templateId,
                Points: custom ? _points : null,
                Coins: custom ? _coins : null,
                CoinCurrencyId: custom && Guid.TryParse(_coinCurrencyId, out var cg) ? cg : null,
                Capacity: _capacity > 0 ? _capacity : null, ExpiresAt: expires, SessionId: null,
                CheckInCreator: _checkMeIn,
                MinCheckIns: custom ? _minCheckIns : null);

            var noCard = _channelId == 0 && _defaultChannelId == 0;
            var result = await Bus.InvokeAsync<Result<Guid>>(command);
            Message = result.Ok
                ? noCard
                    ? "Muster created — but no Discord card was posted (no channel selected and no server muster channel set). Pick a channel above, or set one with /muster config channel."
                    : "Muster posted."
                : MusterStatusText.Friendly(result.Status);
            if (result.Ok)
            {
                _prompt = _title = "";
                _points = _coins = _expiresHours = 0;
                _capacity = _minCheckIns = null;
                _channelId = 0;
                if (_isManager) { _templateId = ""; _coinCurrencyId = ""; }
            }
        }
        finally
        {
            _posting = false;
            await LoadListAsync();
        }
    }

    private async Task CloseAsync(Guid musterId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Bus.InvokeAsync<Result>(new CloseMuster(GuildId, UserId, musterId));
            Message = result.Ok ? "Muster closed." : MusterStatusText.Friendly(result.Status);
        }
        finally
        {
            _busy = false;
            await LoadListAsync();
        }
    }

    private static string RewardLabel(long points, long coins, string? coinCode)
    {
        var parts = new List<string>();
        if (points > 0) { parts.Add($"{points} pts"); }
        if (coins > 0) { parts.Add($"{coins} {coinCode ?? "coins"}"); }
        return parts.Count == 0 ? "—" : string.Join(" + ", parts);
    }

    private static string StatusLabel(MusterStatus s) => s switch
    {
        MusterStatus.Open => "🟢 Open",
        MusterStatus.Locked => "🔒 Locked",
        MusterStatus.Closed => "✅ Closed",
        MusterStatus.Expired => "⌛ Expired",
        MusterStatus.Cancelled => "🚫 Cancelled",
        _ => s.ToString(),
    };
}
