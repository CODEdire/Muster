@page "/guilds/{GuildIdRaw}/quest-settings"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildAdminComponentBase
@inject ConfigCommandService Config
@inject WebAdminService AdminRead
@inject Muster.Web.GuildChannelOptions Channels
@using Muster.Domain.Entities
@using Muster.Domain.Enums
@using Muster.Infrastructure.Commands.Membership
@using Muster.Infrastructure.Services.Web

<PageTitle>Quest settings — Muster</PageTitle>

@if (State == AccessState.NeedLogin)
{
    <div class="panel glass empty">Please <a href="/account/login">log in</a>.</div>
}
else if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId/admin">← Admin</a>
        <h1>Quest settings</h1>
        <p class="subtitle">Quest board channels, approval workflow, auto-resolve timeouts, and difficulty-tier bonuses.</p>
    </div>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <div class="panel glass">
        <h2>Quest board channels</h2>
        <p class="subtitle">Auto-updating cards posted to Discord — edited in place as the quest changes state.
            Leave unset for pull-only (<code>/quest list</code>).</p>
        @if (_channels.Count == 0)
        {
            <p class="subtitle warn-text">No channels available — check the bot is in this server and can view channels.</p>
        }
        <div class="form-grid">
            <label>Public board channel
                <select @bind="Channel.ChannelId">
                    <option value="0">— none (disabled) —</option>
                    @foreach (var c in _channels)
                    {
                        <option value="@c.Id">#@c.Name</option>
                    }
                </select>
                @if (Channel.ChannelId != 0 && _channelById.TryGetValue(Channel.ChannelId, out var pub))
                {
                    <span class="subtitle">posts to <code>#@pub.Name</code></span>
                }
            </label>
            <label>Mod channel
                <select @bind="Channel.ModChannelId">
                    <option value="0">— none (these states post nowhere) —</option>
                    @foreach (var c in _channels)
                    {
                        <option value="@c.Id">#@c.Name</option>
                    }
                </select>
                <span class="subtitle">intake / disputes / sign-off — lock down via Discord perms</span>
            </label>
            <label>Keep completed cards for (hours)
                <input type="number" @bind="Channel.RetentionHours" />
                <span class="subtitle">how long a finished card lingers before deletion (web keeps full history)</span>
            </label>
        </div>
        <div class="btn-row">
            <button type="button" @onclick="SaveChannelAsync" disabled="@_savingChannel">
                @(_savingChannel ? "Saving…" : "Save board")
            </button>
        </div>
    </div>

    <div class="panel glass">
        <h2>Personal quest approval</h2>
        <p class="subtitle">Personal (member-funded) quests can be vetted and tiered by a quest manager before they
            open, with an optional final sign-off before payout.</p>
        <div class="form-grid">
            <label class="check">
                <input type="checkbox" @bind="Approval.IntakeApproval" />
                Require manager intake approval + tiering before a personal quest opens
            </label>
            <label class="check">
                <input type="checkbox" @bind="Approval.AllowSelf" />
                Allow a poster to take &amp; complete their own player quest
                <span class="subtitle">handy for solo/small guilds &amp; testing</span>
            </label>
            <label>Final sign-off before payout
                <select @bind="Approval.FinalMode">
                    <option value="@FinalApprovalMode.Off">Off — owner acceptance pays out directly</option>
                    <option value="@FinalApprovalMode.OwnerChoice">Owner chooses per quest</option>
                    <option value="@FinalApprovalMode.ApproverChoice">Intake approver decides</option>
                    <option value="@FinalApprovalMode.Forced">Always required</option>
                </select>
            </label>
        </div>
        <div class="btn-row">
            <button type="button" @onclick="SaveApprovalAsync" disabled="@_savingApproval">
                @(_savingApproval ? "Saving…" : "Save approval")
            </button>
        </div>
    </div>

    <div class="panel glass">
        <h2>Quest automation</h2>
        <p class="subtitle">Auto-resolve stuck quests after a number of hours (0 = off). Paired action runs at timeout.</p>

        <fieldset class="field-group timeout-pair @(Auto.IntakeHours <= 0 ? "off" : "")">
            <legend>Intake (personal quests awaiting tiering)</legend>
            <div class="form-grid">
                <label>Timeout (hours)
                    <input type="number" @bind="Auto.IntakeHours" />
                </label>
                <label>Action at timeout
                    <select @bind="Auto.IntakeAction" disabled="@(Auto.IntakeHours <= 0)">
                        <option value="@StaleIntakeAction.Decline">Decline (refund owner)</option>
                        <option value="@StaleIntakeAction.Accept">Accept (open, no tier)</option>
                    </select>
                </label>
            </div>
        </fieldset>

        <fieldset class="field-group timeout-pair @(Auto.ClaimHours <= 0 ? "off" : "")">
            <legend>Idle claim (taker not submitting)</legend>
            <div class="form-grid">
                <label>Timeout (hours)
                    <input type="number" @bind="Auto.ClaimHours" />
                    <span class="subtitle">releases the taker so others can claim</span>
                </label>
            </div>
        </fieldset>

        <fieldset class="field-group timeout-pair @(Auto.SubmissionHours <= 0 ? "off" : "")">
            <legend>Submission review (owner not deciding)</legend>
            <div class="form-grid">
                <label>Timeout (hours)
                    <input type="number" @bind="Auto.SubmissionHours" />
                </label>
                <label>Action at timeout
                    <select @bind="Auto.SubmissionAction" disabled="@(Auto.SubmissionHours <= 0)">
                        <option value="@StaleSubmissionAction.Approve">Approve (settle)</option>
                        <option value="@StaleSubmissionAction.Reject">Send back for revision</option>
                        <option value="@StaleSubmissionAction.Dispute">Escalate to arbitration (personal)</option>
                    </select>
                </label>
            </div>
        </fieldset>

        <fieldset class="field-group timeout-pair @(Auto.FinalHours <= 0 ? "off" : "")">
            <legend>Final sign-off (manager not signing)</legend>
            <div class="form-grid">
                <label>Timeout (hours)
                    <input type="number" @bind="Auto.FinalHours" />
                </label>
                <label>Action at timeout
                    <select @bind="Auto.FinalAction" disabled="@(Auto.FinalHours <= 0)">
                        <option value="@StaleFinalAction.Approve">Pay completer</option>
                        <option value="@StaleFinalAction.Refund">Refund owner</option>
                    </select>
                </label>
            </div>
        </fieldset>

        <fieldset class="field-group">
            <legend>Limits &amp; reminders</legend>
            <div class="form-grid">
                <label>Max active quests per poster
                    <input type="number" @bind="Auto.MaxOpenPerPoster" />
                    <span class="subtitle">0 = unlimited</span>
                </label>
                <label>Max active claims per member
                    <input type="number" @bind="Auto.MaxActiveClaims" />
                    <span class="subtitle">0 = unlimited</span>
                </label>
                <label>Max revision round-trips
                    <input type="number" @bind="Auto.MaxRevisions" />
                    <span class="subtitle">0 = unlimited</span>
                </label>
                <label>Deadline reminder (hours before)
                    <input type="number" @bind="Auto.DeadlineReminderHours" />
                    <span class="subtitle">DMs workers/owner before close; 0 = off</span>
                </label>
            </div>
        </fieldset>

        <div class="btn-row">
            <button type="button" @onclick="SaveAutomationAsync" disabled="@_savingAuto">
                @(_savingAuto ? "Saving…" : "Save automation")
            </button>
        </div>
    </div>

    <div class="panel glass">
        <h2>Quest difficulty tiers</h2>
        <p class="subtitle">Bonus POINTS minted to the completer of a guild quest (or a personal quest a manager
            notarizes) by difficulty. S is hardest.</p>
        <div class="tier-grid">
            @foreach (var t in TierRows)
            {
                <label class="tier-card">
                    <span class="tier-letter @t.Css">@t.Letter</span>
                    <span class="tier-label">@t.Label</span>
                    <input type="number" @bind="t.Binding" />
                </label>
            }
        </div>
        <div class="btn-row">
            <button type="button" @onclick="SaveTiersAsync" disabled="@_savingTiers">
                @(_savingTiers ? "Saving…" : "Save tiers")
            </button>
        </div>
    </div>
}

<style>
    .field-group { border: 1px solid rgba(255,255,255,0.08); border-radius: 0.5rem;
        padding: 0.85rem 1rem 1rem; margin-bottom: 1rem; }
    .field-group legend { padding: 0 0.5rem; font-size: 0.85rem; text-transform: uppercase;
        letter-spacing: 0.05em; color: var(--text-muted); }
    .field-group.off { opacity: 0.55; }
    .field-group.off legend::after { content: " (off)"; color: var(--text-muted); }
    .timeout-pair input[type=number] { width: 8rem; }
    .warn-text { color: #d97706; }

    .tier-grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        margin-bottom: 1rem; }
    .tier-card { display: flex; flex-direction: column; gap: 0.4rem; padding: 0.85rem;
        background: rgba(255,255,255,0.03); border-radius: 0.5rem; border: 1px solid rgba(255,255,255,0.08); }
    .tier-letter { font-size: 1.5rem; font-weight: 700; line-height: 1; }
    .tier-letter.s { color: #f87171; }
    .tier-letter.a { color: #fb923c; }
    .tier-letter.b { color: #fbbf24; }
    .tier-letter.c { color: #a3e635; }
    .tier-letter.d { color: #4ade80; }
    .tier-letter.e { color: #60a5fa; }
    .tier-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .tier-card input { padding: 0.4rem 0.6rem; }
</style>

@code {
    // QuestManager + legacy Officer + Admin (implicit) — quest workflow config.
    protected override GuildAccessTier RequiredAccess => GuildAccessTier.QuestManager | GuildAccessTier.Officer;

    private TierInput Tier { get; set; } = new();
    private ApprovalInput Approval { get; set; } = new();
    private AutomationInput Auto { get; set; } = new();
    private ChannelInput Channel { get; set; } = new();

    private IReadOnlyList<GuildChannelOptions.ChannelOption> _channels = [];
    private Dictionary<ulong, GuildChannelOptions.ChannelOption> _channelById = new();

    private bool _savingChannel;
    private bool _savingApproval;
    private bool _savingAuto;
    private bool _savingTiers;

    // Row metadata for the tier card grid — letter, descriptor, color class, plus a get/set hook bound to the
    // matching nullable on TierInput (so the input's @bind round-trips through the same field).
    private List<TierRow> TierRows = new();

    protected override async Task LoadAsync()
    {
        _channels = await Channels.TextAsync(GuildId);
        _channelById = _channels.ToDictionary(c => c.Id);

        var settings = await AdminRead.GetSettingsAsync(GuildId);

        Tier = new TierInput
        {
            S = settings.Quests.TierSPoints,
            A = settings.Quests.TierAPoints,
            B = settings.Quests.TierBPoints,
            C = settings.Quests.TierCPoints,
            D = settings.Quests.TierDPoints,
            E = settings.Quests.TierEPoints,
        };
        TierRows =
        [
            new("S", "hardest", "s", () => Tier.S ?? 0, v => Tier.S = v),
            new("A", "very hard", "a", () => Tier.A ?? 0, v => Tier.A = v),
            new("B", "hard",      "b", () => Tier.B ?? 0, v => Tier.B = v),
            new("C", "moderate",  "c", () => Tier.C ?? 0, v => Tier.C = v),
            new("D", "easy",      "d", () => Tier.D ?? 0, v => Tier.D = v),
            new("E", "easiest",   "e", () => Tier.E ?? 0, v => Tier.E = v),
        ];

        Approval = new ApprovalInput
        {
            IntakeApproval = settings.Quests.PersonalQuestIntakeApproval,
            FinalMode = settings.Quests.FinalApprovalMode,
            AllowSelf = settings.Quests.AllowSelfParticipation,
        };

        Auto = new AutomationInput
        {
            IntakeHours = settings.Quests.IntakeTimeoutHours,
            IntakeAction = settings.Quests.IntakeTimeoutAction,
            ClaimHours = settings.Quests.ClaimTimeoutHours,
            SubmissionHours = settings.Quests.SubmissionTimeoutHours,
            SubmissionAction = settings.Quests.SubmissionTimeoutAction,
            FinalHours = settings.Quests.FinalApprovalTimeoutHours,
            FinalAction = settings.Quests.FinalApprovalTimeoutAction,
            MaxOpenPerPoster = settings.Quests.MaxOpenQuestsPerPoster,
            MaxActiveClaims = settings.Quests.MaxActiveClaimsPerUser,
            MaxRevisions = settings.Quests.MaxRevisions,
            DeadlineReminderHours = settings.Quests.DeadlineReminderHours,
        };

        Channel = new ChannelInput
        {
            ChannelId = settings.Quests.QuestChannelId,
            ModChannelId = settings.Quests.QuestModChannelId,
            RetentionHours = settings.Quests.BoardRetentionHours,
        };
    }

    private async Task SaveChannelAsync()
    {
        _savingChannel = true;
        StateHasChanged();
        try
        {
            var result = await Config.SetQuestBoardAsync(GuildId, Channel.ChannelId, Channel.ModChannelId, Channel.RetentionHours);
            if (!result.IsError)
            {
                await Audit.RecordQuestChannelAsync(GuildId, UserId, Channel.ChannelId, Channel.ModChannelId, Channel.RetentionHours);
            }
            Message = result.Message;
        }
        finally
        {
            _savingChannel = false;
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task SaveAutomationAsync()
    {
        _savingAuto = true;
        StateHasChanged();
        try
        {
            var result = await Config.SetQuestAutomationAsync(
                GuildId, Auto.IntakeHours, Auto.IntakeAction, Auto.ClaimHours,
                Auto.SubmissionHours, Auto.SubmissionAction, Auto.FinalHours, Auto.FinalAction,
                Auto.MaxOpenPerPoster, Auto.MaxActiveClaims, Auto.MaxRevisions, Auto.DeadlineReminderHours);
            if (!result.IsError)
            {
                await Audit.RecordQuestAutomationAsync(GuildId, UserId, new QuestAutomationPayload(
                    Auto.IntakeHours, Auto.IntakeAction, Auto.ClaimHours,
                    Auto.SubmissionHours, Auto.SubmissionAction, Auto.FinalHours, Auto.FinalAction,
                    Auto.MaxOpenPerPoster, Auto.MaxActiveClaims, Auto.MaxRevisions, Auto.DeadlineReminderHours));
            }
            Message = result.Message;
        }
        finally
        {
            _savingAuto = false;
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task SaveApprovalAsync()
    {
        _savingApproval = true;
        StateHasChanged();
        try
        {
            var result = await Config.SetQuestApprovalAsync(GuildId, Approval.IntakeApproval, Approval.FinalMode, Approval.AllowSelf);
            if (!result.IsError)
            {
                await Audit.RecordQuestApprovalAsync(GuildId, UserId, Approval.IntakeApproval, Approval.FinalMode, Approval.AllowSelf);
            }
            Message = result.Message;
        }
        finally
        {
            _savingApproval = false;
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task SaveTiersAsync()
    {
        _savingTiers = true;
        StateHasChanged();
        try
        {
            var result = await Config.SetQuestTierPointsAsync(
                GuildId, Tier.S ?? 0, Tier.A ?? 0, Tier.B ?? 0, Tier.C ?? 0, Tier.D ?? 0, Tier.E ?? 0);
            if (!result.IsError)
            {
                await Audit.RecordQuestTierPointsAsync(GuildId, UserId, Tier.S ?? 0, Tier.A ?? 0, Tier.B ?? 0, Tier.C ?? 0, Tier.D ?? 0, Tier.E ?? 0);
            }
            Message = result.Message;
        }
        finally
        {
            _savingTiers = false;
            await LoadAsync();
            StateHasChanged();
        }
    }

    public class TierInput
    {
        public long? S { get; set; }
        public long? A { get; set; }
        public long? B { get; set; }
        public long? C { get; set; }
        public long? D { get; set; }
        public long? E { get; set; }
    }

    public class ChannelInput
    {
        public ulong ChannelId { get; set; }
        public ulong ModChannelId { get; set; }
        public int RetentionHours { get; set; } = 48;
    }

    public class ApprovalInput
    {
        public bool IntakeApproval { get; set; }
        public bool AllowSelf { get; set; }
        public FinalApprovalMode FinalMode { get; set; }
    }

    public class AutomationInput
    {
        public int IntakeHours { get; set; }
        public StaleIntakeAction IntakeAction { get; set; }
        public int ClaimHours { get; set; }
        public int SubmissionHours { get; set; }
        public StaleSubmissionAction SubmissionAction { get; set; }
        public int FinalHours { get; set; }
        public StaleFinalAction FinalAction { get; set; }
        public int MaxOpenPerPoster { get; set; }
        public int MaxActiveClaims { get; set; }
        public int MaxRevisions { get; set; }
        public int DeadlineReminderHours { get; set; }
    }

    public class TierRow(string letter, string label, string css, Func<long> get, Action<long?> set)
    {
        public string Letter { get; } = letter;
        public string Label { get; } = label;
        public string Css { get; } = css;
        public long Binding { get => get(); set => set(value); }
    }
}
