@page "/guilds/{GuildIdRaw}/sessions/{SessionId}"
@layout GuildLayout
@inherits GuildMemberComponentBase
@inject ParticipationReadService Participation
@inject MusterDbContext Db
@using Muster.Domain.Enums
@using Muster.Persistence
@using Muster.Persistence.Queries
@using Muster.Infrastructure.Services.Tracking

<PageTitle>Session — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready && _detail is null)
{
    <div class="panel glass empty">Session not found.</div>
}
else if (State == AccessState.Ready && _detail is not null)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId/sessions">← Sessions</a>
        <h1>@_detail.Name</h1>
        <p class="subtitle">@(_detail.Active ? "🟢 Active now" : "Ended")</p>
    </div>

    <div class="stat-grid">
        <div class="stat glass">
            <div class="label">Type</div>
            <div class="num">@(_detail.Source == TrackingSessionSource.DiscordScheduledEvent ? "Scheduled event" : "Manual")</div>
        </div>
        <div class="stat glass">
            <div class="label">Channel</div>
            <div class="num">@(string.IsNullOrWhiteSpace(_detail.VoiceChannelName) ? $"#{_detail.VoiceChannelId}" : "#" + _detail.VoiceChannelName)</div>
        </div>
        <div class="stat glass">
            <div class="label">Started</div>
            <div class="num">@_detail.StartedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</div>
        </div>
        <div class="stat glass">
            <div class="label">@(_detail.Active ? "Status" : "Ended")</div>
            <div class="num">@(_detail.Active ? "Active" : _detail.EndedAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") + " UTC")</div>
        </div>
    </div>

    <div class="panel glass">
        <h2>Rules</h2>
        <p class="subtitle">
            Anti-AFK guards for this session (for reference):
            pause while muted/deafened — <strong>@(_detail.RequireUnmuted ? "on" : "off")</strong>;
            pause while alone — <strong>@(_detail.RequireNotAlone ? "on" : "off")</strong>.
        </p>
    </div>

    <div class="panel glass">
        <h2>Attendance (@_detail.Members.Count)</h2>
        @if (_detail.Members.Count == 0)
        {
            <p class="empty">No attendance recorded.</p>
        }
        else
        {
            <table class="leaderboard">
                <thead><tr><th>Member</th><th>Joined</th><th>Minutes</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var m in _detail.Members)
                    {
                        <tr>
                            <td>@Name(m.UserId)</td>
                            <td>@m.FirstJoinedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</td>
                            <td>@m.TotalMinutes</td>
                            <td>@Status(m)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    [Parameter] public string SessionId { get; set; } = string.Empty;

    private SessionDetailView? _detail;
    private Dictionary<ulong, string> _names = [];

    protected override async Task LoadAsync()
    {
        if (!Guid.TryParse(SessionId, out var id))
        {
            return;
        }

        _detail = await Participation.SessionDetailAsync(GuildId, id);
        if (_detail is not null)
        {
            _names = await Db.UserDisplayNameMapAsync(_detail.Members.Select(m => m.UserId).ToList());
        }
    }

    private string Name(ulong userId) => _names.GetValueOrDefault(userId, $"User {userId}");

    /// <summary>Active = accruing; Paused = still present but muted/alone; Left = stale last-seen (disconnected).</summary>
    private string Status(SessionMemberRow m)
    {
        if (_detail is not { Active: true })
        {
            return "—";
        }

        if (m.PresentNow)
        {
            return "🟢 Active";
        }

        if (m.LastSeenAt is { } seen && DateTimeOffset.UtcNow - seen < TimeSpan.FromMinutes(6))
        {
            return "🟡 Present (not earning)";
        }

        return m.LastSeenAt is { } last ? $"⚪ Left {last.UtcDateTime:HH:mm} UTC" : "⚪ Left";
    }
}
