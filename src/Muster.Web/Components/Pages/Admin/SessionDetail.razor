@page "/guilds/{GuildIdRaw}/sessions/{SessionId}"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildMemberComponentBase
@implements IDisposable
@inject IServiceScopeFactory Scopes
@inject ISessionUpdateNotifier Notifier
@using Microsoft.EntityFrameworkCore
@using Muster.Domain.Enums
@using Muster.Persistence
@using Muster.Persistence.Queries
@using Muster.Infrastructure.Services.Tracking
@using Muster.Infrastructure.Services.Membership
@using Muster.Infrastructure.Services.Musters
@using Muster.Infrastructure.Services.Platform

<PageTitle>@(_detail?.Name ?? "Session") — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready && _detail is null)
{
    <div class="panel glass empty">Session not found. <a href="/guilds/@GuildId/sessions">Back to sessions</a></div>
}
else if (State == AccessState.Ready && _detail is not null)
{
    <header class="sess-head">
        <div class="sess-head-bar">
            <a class="btn btn-ghost btn-sm sess-back" href="/guilds/@GuildId/sessions">
                <span class="material-symbols-outlined">arrow_back</span> Sessions
            </a>
            <div class="sess-head-actions">
                @if (_detail.Active)
                {
                    <span class="updated">updated <LocalTime Value="_lastLoaded" Relative="true" /></span>
                }
                <a class="icon-btn" title="Open voice channel in Discord" aria-label="Open in Discord" target="_blank"
                   href="https://discord.com/channels/@GuildId/@_detail.VoiceChannelId">
                    <span class="material-symbols-outlined">open_in_new</span>
                </a>
                @if (_detail.ScheduledEventId is { } evId)
                {
                    <a class="icon-btn" title="Open event in Discord" aria-label="Open event" target="_blank"
                       href="https://discord.com/events/@GuildId/@evId">
                        <span class="material-symbols-outlined">event</span>
                    </a>
                }
                @if (_isStaff)
                {
                    <a class="btn btn-ghost btn-sm" href="/guilds/@GuildId/sessions/@_detail.Id/export.csv" target="_blank">
                        <span class="material-symbols-outlined">download</span> Export
                    </a>
                    @if (_detail.Active)
                    {
                        <button type="button" class="btn btn-sm btn-danger" @onclick="EndAsync" disabled="@_ending">
                            <span class="material-symbols-outlined">stop_circle</span> End session
                        </button>
                    }
                }
            </div>
        </div>

        <div class="sess-title">
            <h1>@_detail.Name</h1>
            @if (_detail.Active)
            {
                <span class="live-badge"><span class="live-dot"></span> LIVE</span>
            }
            else
            {
                <span class="badge ended-badge">Completed</span>
            }
        </div>

        <div class="sess-meta">
            <span><span class="material-symbols-outlined">@(_detail.Source == TrackingSessionSource.DiscordScheduledEvent ? "event" : "tune")</span>@Src(_detail.Source)</span>
            <span><ChannelLabel Id="_detail.VoiceChannelId" Name="@_detail.VoiceChannelName" /></span>
            @if (_detail.Active)
            {
                <span>started <LocalTime Value="_detail.StartedAt" /></span>
            }
            else
            {
                <span>ran <LocalTime Value="_detail.StartedAt" Pattern="MMM d, h:mm tt" /> – <LocalTime Value="_detail.EndedAt" Pattern="h:mm tt" /></span>
            }
            @if (_detail.OpenedBy != 0)
            {
                <span><span class="material-symbols-outlined">person</span>opened by @_detail.OpenedByName</span>
            }
        </div>
    </header>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <div class="sess-kpis">
        @if (_detail.Active)
        {
            var earn = _detail.Members.Count(m => m.PresentNow);
            var paused = _detail.Members.Count(IsPaused);
            var gone = _detail.Members.Count(IsGone);
            var tot = Math.Max(1, earn + paused + gone);
            <div class="kpi glass kpi-donut" title="Who's earning right now">
                <svg viewBox="0 0 36 36" class="donut" role="img" aria-label="Member status breakdown">
                    <circle class="donut-track" cx="18" cy="18" r="15.915" />
                    <circle class="donut-seg earn" cx="18" cy="18" r="15.915" stroke-dasharray="@DonutDash(earn, tot)" stroke-dashoffset="@DonutOff(0, tot)" />
                    <circle class="donut-seg paused" cx="18" cy="18" r="15.915" stroke-dasharray="@DonutDash(paused, tot)" stroke-dashoffset="@DonutOff(earn, tot)" />
                    <circle class="donut-seg left" cx="18" cy="18" r="15.915" stroke-dasharray="@DonutDash(gone, tot)" stroke-dashoffset="@DonutOff(earn + paused, tot)" />
                    <text x="18" y="20.5" class="donut-center">@earn</text>
                </svg>
                <ul class="donut-legend">
                    <li><span class="status-dot is-active"></span>Earning <b>@earn</b></li>
                    <li><span class="status-dot is-paused"></span>Paused <b>@paused</b></li>
                    <li><span class="status-dot is-ended"></span>Left <b>@gone</b></li>
                </ul>
            </div>
        }
        <div class="kpi glass"><div class="kpi-num">@Dur(Elapsed())</div><div class="kpi-label">@(_detail.Active ? "Elapsed" : "Duration")</div></div>
        @if (_detail.Active)
        {
            <div class="kpi glass">
                <div class="kpi-num">@_detail.Members.Count(m => m.InChannel)<span class="kpi-sub">/ @_detail.Members.Count</span></div>
                <div class="kpi-label">In voice / Total</div>
            </div>
        }
        else
        {
            <div class="kpi glass"><div class="kpi-num">@_detail.Members.Count</div><div class="kpi-label">Attendees</div></div>
        }
        <div class="kpi glass"><div class="kpi-num">@TotalMinutes</div><div class="kpi-label">Voice minutes</div></div>
        @if (_detail.Active && _sessionFactor > 1)
        {
            var eff = _detail.PointsPerMinute * _sessionFactor;
            <div class="kpi glass">
                <div class="kpi-num accent">@eff.ToString("0.##")<span class="kpi-unit">pts/min</span></div>
                <div class="kpi-label">Rate <span class="mult-chip">⚡@_sessionFactor.ToString("0.##")×</span></div>
            </div>
        }
        else
        {
            <div class="kpi glass"><div class="kpi-num">@_detail.PointsPerMinute<span class="kpi-unit">pts/min</span></div><div class="kpi-label">Rate</div></div>
        }
    </div>

    <div class="sess-rules">
        <span class="rules-label">Anti-AFK guards</span>
        <span class="rule-chip @(_detail.Guards.Unmuted() ? "on" : "off")"><span class="material-symbols-outlined">mic_off</span>Muted</span>
        <span class="rule-chip @(_detail.Guards.Undeafened() ? "on" : "off")"><span class="material-symbols-outlined">headset_off</span>Deafened</span>
        <span class="rule-chip @(_detail.Guards.NotAlone() ? "on" : "off")"><span class="material-symbols-outlined">group</span>Alone</span>
        <span class="rules-hint">on = that state pauses earning</span>
    </div>

    <TabFrame Fill="true" ActiveId="@_tab" ActiveIdChanged="t => _tab = t">
        <TabPane Id="gantt" Label="Gantt" Icon="view_timeline">
            @if (_detail.Members.Count == 0)
            {
                <p class="empty">No one has joined yet.</p>
            }
            else if (_timeline is { Tracks.Count: > 0 } tl)
            {
                <div class="viz">
                    <div class="panel-head">
                        <h2>People in voice over time</h2>
                        <span class="subtitle">peak @tl.Peak · <span class="seg-key earn">earning</span> <span class="seg-key paused">paused</span></span>
                    </div>

                    <div class="occ">
                        <svg viewBox="0 0 100 32" preserveAspectRatio="none" class="occ-svg" role="img" aria-label="Headcount over time">
                            <path d="@OccStepArea(tl)" class="occ-area" />
                            <polyline points="@OccStepLine(tl)" class="occ-line" />
                        </svg>
                        <div class="occ-axis">
                            <span><LocalTime Value="_detail.StartedAt" Pattern="h:mm tt" /></span>
                            <span>@(_detail.Active ? "now" : null)<LocalTime Value="_detail.EndedAt" Pattern="h:mm tt" Empty="" /></span>
                        </div>
                    </div>

                    <div class="gantt">
                        @foreach (var track in tl.Tracks)
                        {
                            var gm = MemberFor(track.UserId);
                            var gmedal = gm is null ? null : Medal(MinuteRank(gm));
                            <div class="gantt-row">
                                <span class="gantt-name" title="@NameFor(track.UserId)">
                                    @if (gmedal is not null)
                                    {
                                        <span class="medal" title="Top @MinuteRank(gm!) by minutes">@gmedal</span>
                                    }
                                    <UserChip Name="@NameFor(track.UserId)" AvatarUrl="@gm?.AvatarUrl" Href="@(_isStaff ? MusterLinks.MemberDetail(GuildId, track.UserId) : null)" />
                                </span>
                                <div class="gantt-track">
                                    @foreach (var seg in track.Segments)
                                    {
                                        var l = PctOf(seg.Start);
                                        var w = Math.Max(0.4, PctOf(seg.End) - l);
                                        if (l + w > 100) { l = Math.Max(0, 100 - w); } // keep the end sliver inside the track
                                        <div class="gantt-seg @(seg.Earning ? "earn" : "paused")"
                                             style="left:@Pct(l);width:@Pct(w)" title="@(seg.Earning ? "earning" : "paused")"></div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                @* Legacy fallback: sessions recorded before the event log have no events — approximate from
                   each member's first-join → last-seen span. *@
                var occ = OccupancySeries();
                var peak = occ.Length == 0 ? 0 : occ.Max();
                <div class="viz">
                    <div class="panel-head">
                        <h2>People in voice over time</h2>
                        <span class="subtitle">peak @peak · approximate (each bar = a member's first-join → last-seen)</span>
                    </div>

                    <div class="occ">
                        <svg viewBox="0 0 100 32" preserveAspectRatio="none" class="occ-svg" role="img" aria-label="Headcount over time">
                            <path d="@OccArea(occ, peak)" class="occ-area" />
                            <polyline points="@OccLine(occ, peak)" class="occ-line" />
                        </svg>
                        <div class="occ-axis">
                            <span><LocalTime Value="_detail.StartedAt" Pattern="h:mm tt" /></span>
                            <span>@(_detail.Active ? "now" : null)<LocalTime Value="_detail.EndedAt" Pattern="h:mm tt" Empty="" /></span>
                        </div>
                    </div>

                    <div class="gantt">
                        @foreach (var m in _detail.Members.OrderBy(m => m.FirstJoinedAt))
                        {
                            var (left, width, live) = Bar(m);
                            var lmedal = Medal(MinuteRank(m));
                            <div class="gantt-row">
                                <span class="gantt-name" title="@m.Name">
                                    @if (lmedal is not null)
                                    {
                                        <span class="medal" title="Top @MinuteRank(m) by minutes">@lmedal</span>
                                    }
                                    <UserChip Name="@m.Name" AvatarUrl="@m.AvatarUrl" Href="@(_isStaff ? MusterLinks.MemberDetail(GuildId, m.UserId) : null)" />
                                </span>
                                <div class="gantt-track">
                                    <div class="gantt-bar @(live ? "live" : null)" style="left:@Pct(left);width:@Pct(width)" title="@m.TotalMinutes min"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </TabPane>

        <TabPane Id="attendance" Label="Attendance" Icon="groups">
            <div class="dg-toolbar">
                <div class="dg-filters">
                    <span class="bg-count">@_detail.Members.Count total</span>
                    <input type="search" class="dg-search" placeholder="Find member…" @bind="_search" @bind:event="oninput" />
                </div>
                @if (_detail.Active && IsParticipant && !_isStaff)
                {
                    <div class="dg-actions">
                        <button type="button" class="btn btn-ghost btn-sm" disabled="@_optingSelf" @onclick="() => OptOutAsync(UserId)">Opt me out</button>
                    </div>
                }
            </div>

            @{ var rows = SortedFiltered(); }
            @if (rows.Count == 0)
            {
                <p class="empty">@(_detail.Members.Count == 0 ? "No one has joined yet." : "No member matches that search.")</p>
            }
            else
            {
                <table class="dg-table">
                    <thead>
                        <tr>
                            <th class="sortable" @onclick='() => SetSort("name")'>Member @Ind("name")</th>
                            <th class="sortable" @onclick='() => SetSort("joined")'>Joined @Ind("joined")</th>
                            <th class="num sortable" title="Time in the channel, including paused" @onclick='() => SetSort("voice")'>In voice @Ind("voice")</th>
                            <th class="num sortable" title="Eligible minutes that earn — paused/AFK time excluded" @onclick='() => SetSort("minutes")'>Earning @Ind("minutes")</th>
                            <th class="num sortable" @onclick='() => SetSort("points")'>@(_detail.Active ? "Projected" : "Points") @Ind("points")</th>
                            <th>Status</th>
                            <th class="dg-actions-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in rows)
                        {
                            var (dot, label) = Status(m);
                            var medal = Medal(MinuteRank(m));
                            <tr class="@(m.UserId == UserId ? "lb-me" : null)">
                                <td>
                                    <span class="dg-member">
                                        @if (medal is not null)
                                        {
                                            <span class="medal" title="Top @MinuteRank(m) by minutes">@medal</span>
                                        }
                                        <UserChip Name="@m.Name" AvatarUrl="@m.AvatarUrl" Href="@(_isStaff ? MusterLinks.MemberDetail(GuildId, m.UserId) : null)" />
                                    </span>
                                </td>
                                <td><LocalTime Value="m.FirstJoinedAt" /></td>
                                <td class="num">@PresenceMinutes(m)</td>
                                <td class="num">@m.TotalMinutes</td>
                                <td class="num">@(m.RewardMinutes * _detail.PointsPerMinute)</td>
                                <td><span class="status-dot @dot"></span>@label</td>
                                <td class="dg-actions-col">
                                    @if (_detail.Active && (m.UserId == UserId || _isStaff))
                                    {
                                        <button type="button" class="icon-btn warn" title="Opt out of this session" aria-label="Opt out"
                                                disabled="@(_optingOut == m.UserId)" @onclick="() => OptOutAsync(m.UserId)">
                                            <span class="material-symbols-outlined">person_remove</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </TabPane>

        @if (_isStaff)
        {
            <TabPane Id="audit" Label="Audit" Icon="history">
                @if (_detail.Events.Count == 0)
                {
                    <p class="empty">No presence events recorded for this session.</p>
                }
                else
                {
                    <table class="dg-table audit-table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Member</th>
                                <th>Event</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in _detail.Events.OrderByDescending(e => e.At).ThenByDescending(e => e.Kind))
                            {
                                <tr>
                                    <td><LocalTime Value="ev.At" Pattern="MMM d, h:mm:ss tt" /></td>
                                    <td><UserChip Name="@ev.Name" AvatarUrl="@(MemberFor(ev.UserId)?.AvatarUrl)" Href="@(_isStaff ? MusterLinks.MemberDetail(GuildId, ev.UserId) : null)" /></td>
                                    <td><span class="status-dot @EventDot(ev.Kind)"></span>@ev.Kind</td>
                                    <td class="muted">@ev.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </TabPane>
        }

        @if (_isStaff)
        {
            <TabPane Id="musters" Label="@($"Musters ({_musters.Count})")" Icon="groups">
                <div class="dg-frame" style="flex:1 1 auto; min-height:0; margin-bottom:0;">
                    <div class="dg-toolbar">
                        <div class="dg-filters"><span class="subtitle">Check-in musters gating this session's coin.</span></div>
                        <div class="dg-actions">
                            <a class="btn btn-sm" href="@MusterLinks.MusterNew(GuildId, _sessionGuid)"><span class="material-symbols-outlined">add</span> New muster</a>
                        </div>
                    </div>
                    <div class="dg-scroll">
                        <table class="dg-table">
                            <thead><tr><th>Muster</th><th>Status</th><th class="num">Checked in</th></tr></thead>
                            <tbody>
                                @if (_musters.Count == 0)
                                {
                                    <tr class="dg-empty"><td colspan="3">No musters linked yet. Create one to gate this session's coin on check-in.</td></tr>
                                }
                                else
                                {
                                    @foreach (var m in _musters)
                                    {
                                        <tr>
                                            <td><a href="@MusterLinks.MusterDetail(GuildId, m.Id)">@m.Display</a></td>
                                            <td>@m.Status</td>
                                            <td class="num">@m.CheckedIn</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="dg-footer"><span class="dg-tz">@_musters.Count linked muster@(_musters.Count == 1 ? "" : "s")</span></div>
                </div>
            </TabPane>
        }
    </TabFrame>

    <p class="tz-note">
        Times in <LocalTime ShowZone="true" />. Opting out removes you from this one session only —
        it doesn't change your standing preference (set that on the <a href="/guilds/@GuildId/settings#privacy">settings page</a>).
    </p>
}

@code {
    [Parameter] public string SessionId { get; set; } = string.Empty;

    private SessionDetailView? _detail;
    private IReadOnlyList<Muster.Infrastructure.Services.Musters.SessionMusterRef> _musters = [];
    private bool _isStaff;
    private bool _ending;
    private bool _optingSelf;
    private ulong? _optingOut;   // the member currently being opted out (disables that row's button)
    private Guid _sessionGuid;
    private string _zoneId = TimeZoneService.Utc;
    private decimal _sessionFactor = 1m;
    private DateTimeOffset _lastLoaded = DateTimeOffset.UtcNow;

    private string? _search;
    private string _sort = "minutes";
    private bool _sortDesc = true;
    private string _tab = "gantt";

    private SessionTimelineModel? _timeline;   // exact timeline from the event log; null for legacy (no events) → approximate fallback

    private System.Threading.Timer? _ticker;   // ticks the live elapsed/"updated" labels while active

    private bool IsParticipant => _detail?.Members.Any(m => m.UserId == UserId) ?? false;
    private int TotalMinutes => _detail?.Members.Sum(m => m.TotalMinutes) ?? 0;

    private TimeSpan Elapsed() => (_detail?.EndedAt ?? DateTimeOffset.UtcNow) - (_detail?.StartedAt ?? DateTimeOffset.UtcNow);

    protected override async Task LoadAsync()
    {
        if (!Guid.TryParse(SessionId, out var id))
        {
            return;
        }

        _sessionGuid = id;
        await using var scope = Scopes.CreateAsyncScope();
        var sp = scope.ServiceProvider;
        var auth = sp.GetRequiredService<GuildAuthorizationService>();

        _zoneId = await sp.GetRequiredService<TimeZoneService>().ResolveZoneIdAsync(GuildId, UserId);
        _sessionFactor = await sp.GetRequiredService<RewardMultiplierService>().ActiveFactorAsync(GuildId, MultiplierScope.Sessions);
        // Staff buttons (stop/close, force opt-out, etc.). IsTrackingManagerAsync already covers Admin + the legacy
        // Officer/EventOfficer umbrellas.
        _isStaff = await auth.IsTrackingManagerAsync(GuildId, UserId);
        _detail = await sp.GetRequiredService<ParticipationReadService>().SessionDetailAsync(GuildId, id);
        _musters = _isStaff ? await sp.GetRequiredService<IMusterReadService>().MustersForSessionAsync(GuildId, id) : [];
        _lastLoaded = DateTimeOffset.UtcNow;
        BuildTimeline();
    }

    // Project the event stream into exact segments + occupancy. Null when the session has no events (legacy),
    // so the view falls back to the first-join → last-seen approximation. WinEnd freezes at load for active
    // sessions (the live bar extends on the next reconcile/notify reload, matching the data cadence).
    private void BuildTimeline()
    {
        _timeline = _detail is { Events.Count: > 0 }
            ? SessionTimeline.Build(
                _detail.Events.Select(e => new PresencePoint(e.UserId, e.Kind, e.At)),
                WinStart, WinEnd, _detail.Members.Select(m => m.UserId).ToHashSet())
            : null;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Notifier.Updated += OnSessionChanged;
            // Tick once a second so the elapsed timer + "updated Xs ago" stay live while the session is running.
            _ticker = new System.Threading.Timer(_ => InvokeAsync(Tick), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
    }

    // Per-second tick: re-project so the open (live) run extends to "now" between reconcile reloads, then re-render.
    private void Tick()
    {
        if (_detail is { Active: true }) { BuildTimeline(); }
        StateHasChanged();
    }

    private void OnSessionChanged(SessionAttendanceChanged change)
    {
        if (State != AccessState.Ready || change.SessionId != _sessionGuid)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task EndAsync()
    {
        if (_ending || !_isStaff || !Guid.TryParse(SessionId, out var id))
        {
            return;
        }

        _ending = true;
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            var sp = scope.ServiceProvider;

            // CQRS path: command service runs auth + snapshot + close + returns info for the audit row.
            var result = await sp.GetRequiredService<Muster.Infrastructure.Commands.Tracking.TrackingCommandService>()
                .StopAsync(GuildId, UserId, id);

            if (result.IsError)
            {
                Message = result.Message;
                return;
            }

            var info = result.Value!;
            await sp.GetRequiredService<AuditService>().RecordSessionStoppedAsync(
                GuildId, UserId, info.Id, info.Name, info.VoiceChannelId, info.VoiceChannelName);
            Message = "Session ended and attendance awarded.";
        }
        finally
        {
            _ending = false;
            await LoadAsync();
        }
    }

    private async Task OptOutAsync(ulong userId)
    {
        // A member may opt only themselves out; staff may opt anyone out. Session-scoped only.
        if (_detail is not { Active: true } || (userId != UserId && !_isStaff) || _optingOut is not null)
        {
            return;
        }

        if (userId == UserId) { _optingSelf = true; }
        _optingOut = userId; // disables that row's opt-out button while in flight
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            var sp = scope.ServiceProvider;
            if (await sp.GetRequiredService<TrackingSessionService>().OptOutMemberAsync(GuildId, _sessionGuid, userId))
            {
                Message = userId == UserId ? "You've opted out of this session." : "Member opted out of this session.";
            }
        }
        finally
        {
            _optingSelf = false;
            _optingOut = null;
            await LoadAsync();
        }
    }

    public void Dispose()
    {
        Notifier.Updated -= OnSessionChanged;
        _ticker?.Dispose();
    }

    private IReadOnlyList<SessionMemberRow> SortedFiltered()
    {
        if (_detail is null)
        {
            return [];
        }

        IEnumerable<SessionMemberRow> q = _detail.Members;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            q = q.Where(m => m.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        Func<SessionMemberRow, object> key = _sort switch
        {
            "name" => m => m.Name,
            "joined" => m => m.FirstJoinedAt,
            "voice" => m => PresenceMinutes(m),
            "points" => m => m.RewardMinutes,
            "status" => m => StatusRank(m),
            _ => m => m.TotalMinutes,
        };
        q = _sortDesc ? q.OrderByDescending(key) : q.OrderBy(key);
        return q.ToList();
    }

    private void SetSort(string column)
    {
        if (_sort == column) { _sortDesc = !_sortDesc; }
        else { _sort = column; _sortDesc = true; }
    }

    private string Ind(string column) => _sort == column ? (_sortDesc ? "▼" : "▲") : "";

    // Authoritative from the InChannel latch: in the channel but not earning = paused; not in the channel = gone.
    private static bool IsPaused(SessionMemberRow m) => m.InChannel && !m.PresentNow;

    private static bool IsGone(SessionMemberRow m) => !m.InChannel;

    private int StatusRank(SessionMemberRow m) => m.PresentNow ? 0 : IsPaused(m) ? 1 : 2;

    /// <summary>Status dot class + label for a member (active sessions only carry live state).</summary>
    private (string Dot, string Label) Status(SessionMemberRow m)
    {
        if (_detail is not { Active: true })
        {
            return ("is-ended", "—");
        }

        if (m.PresentNow) { return ("is-active", "Earning"); }
        if (IsPaused(m)) { return ("is-paused", "Paused"); }
        return ("is-ended", m.LastSeenAt is { } last ? $"Left {TimeZoneService.Format(last, ViewerZone, "h:mm tt")}" : "Left");
    }

    private string ViewerZone => TimeZoneService.IsValidZone(BrowserZoneId) ? BrowserZoneId! : _zoneId;

    private static string Src(TrackingSessionSource s) => s == TrackingSessionSource.DiscordScheduledEvent ? "Scheduled event" : "Manual";

    private static string Dur(TimeSpan t)
    {
        if (t.TotalHours >= 1) { return $"{(int)t.TotalHours}h {t.Minutes}m"; }
        return t.TotalMinutes >= 1 ? $"{t.Minutes}m {t.Seconds}s" : $"{t.Seconds}s";
    }

    // ---- Timeline visuals: derived from each member's first-join → last-seen span. Approximate (a member who
    // left and rejoined is treated as one continuous span), so occupancy can over-count during a gap. ----
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private const int OccSamples = 48;

    private DateTimeOffset WinStart => _detail!.StartedAt;
    private DateTimeOffset WinEnd => _detail!.EndedAt ?? DateTimeOffset.UtcNow;
    private double WinSeconds => Math.Max(1, (WinEnd - WinStart).TotalSeconds);

    private (DateTimeOffset S, DateTimeOffset E, bool Live) Span(SessionMemberRow m)
    {
        var s = m.FirstJoinedAt < WinStart ? WinStart : m.FirstJoinedAt;
        var e = m.PresentNow ? WinEnd : (m.LastSeenAt ?? s);
        if (e > WinEnd) { e = WinEnd; }
        if (e < s) { e = s; }
        return (s, e, m.PresentNow);
    }

    private (double Left, double Width, bool Live) Bar(SessionMemberRow m)
    {
        var (s, e, live) = Span(m);
        var left = (s - WinStart).TotalSeconds / WinSeconds * 100;
        var width = Math.Max(0.8, (e - s).TotalSeconds / WinSeconds * 100);
        if (left + width > 100) { width = Math.Max(0.8, 100 - left); }
        return (left, width, live);
    }

    private int[] OccupancySeries()
    {
        var spans = _detail!.Members.Select(Span).ToList();
        var series = new int[OccSamples];
        for (var i = 0; i < OccSamples; i++)
        {
            var t = WinStart.AddSeconds(WinSeconds * i / (OccSamples - 1));
            series[i] = spans.Count(sp => sp.S <= t && t <= sp.E);
        }
        return series;
    }

    // viewBox 0 0 100 32: baseline at y=30, peak scaled into the top 28 units.
    private static string OccLine(int[] occ, int peak)
    {
        var max = Math.Max(1, peak);
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < occ.Length; i++)
        {
            var x = (double)i / (occ.Length - 1) * 100;
            var y = 30 - (double)occ[i] / max * 28;
            sb.Append(x.ToString("0.##", Inv)).Append(',').Append(y.ToString("0.##", Inv)).Append(' ');
        }
        return sb.ToString().TrimEnd();
    }

    private static string OccArea(int[] occ, int peak) => $"M0,32 {OccLine(occ, peak)} 100,32 Z";

    private static string DonutDash(int value, int total)
    {
        var pct = total <= 0 ? 0 : (double)value / total * 100;
        return $"{pct.ToString("0.##", Inv)} {(100 - pct).ToString("0.##", Inv)}";
    }

    private static string DonutOff(int before, int total)
    {
        var pct = total <= 0 ? 0 : (double)before / total * 100;
        return (25 - pct).ToString("0.##", Inv);
    }

    private static string Pct(double v) => v.ToString("0.##", Inv) + "%";

    // ---- Exact timeline (from the event log): position a time within the window, stepped occupancy curve. ----
    private string NameFor(ulong userId) => MemberFor(userId)?.Name ?? $"User {userId}";
    private SessionMemberRow? MemberFor(ulong userId) => _detail?.Members.FirstOrDefault(m => m.UserId == userId);

    // Total time in the channel (earning + paused), in minutes. Exact from the timeline; for legacy sessions
    // (no events) falls back to the first-join → last-seen span.
    private int PresenceMinutes(SessionMemberRow m)
    {
        if (_timeline?.Tracks.FirstOrDefault(t => t.UserId == m.UserId) is { } track)
        {
            return (int)(track.Segments.Sum(s => (s.End - s.Start).TotalSeconds) / 60);
        }

        var (s, e, _) = Span(m);
        return (int)(e - s).TotalMinutes;
    }

    private double PctOf(DateTimeOffset t)
    {
        var p = (t - WinStart).TotalSeconds / WinSeconds * 100;
        return p < 0 ? 0 : p > 100 ? 100 : p;
    }

    // Stepped headcount: hold flat between change-points, jump at each. viewBox 0 0 100 32, baseline y=30.
    // Steps at the window end are the synthetic clamp-closings of still-open runs — skip them so the line holds
    // the end-of-window headcount to the right edge (no phantom drop to zero at "now").
    private string OccStepLine(SessionTimelineModel tl)
    {
        var max = Math.Max(1, tl.Peak);
        double YFor(int c) => 30 - (double)c / max * 28;
        var sb = new System.Text.StringBuilder();
        void P(double x, double y) => sb.Append(x.ToString("0.##", Inv)).Append(',').Append(y.ToString("0.##", Inv)).Append(' ');

        var prev = 0;
        P(0, YFor(0));
        foreach (var step in tl.Occupancy)
        {
            if (step.At >= WinEnd) { continue; } // synthetic end-of-window closing; hold the prior level instead
            var x = PctOf(step.At);
            P(x, YFor(prev));   // hold previous level up to the change-point
            P(x, YFor(step.Count)); // then jump
            prev = step.Count;
        }
        P(100, YFor(prev));
        return sb.ToString().TrimEnd();
    }

    private string OccStepArea(SessionTimelineModel tl) => $"M0,32 {OccStepLine(tl)} 100,32 Z";

    private static string EventDot(SessionPresenceKind kind) => kind switch
    {
        SessionPresenceKind.Resume => "is-active",
        SessionPresenceKind.Pause => "is-paused",
        SessionPresenceKind.Leave => "is-ended",
        _ => "is-stats", // Join
    };

    // 1/2/3 for the top three by minutes, else 0. Suppressed unless ≥2 members have minutes — a medal
    // implies a race, so it's meaningless on a solo roster.
    private int MinuteRank(SessionMemberRow m)
    {
        if (_detail is null || m.TotalMinutes <= 0) { return 0; }
        var ranked = _detail.Members.Where(x => x.TotalMinutes > 0)
                                    .OrderByDescending(x => x.TotalMinutes)
                                    .ToList();
        if (ranked.Count < 2) { return 0; }
        var i = ranked.Take(3).ToList().FindIndex(x => x.UserId == m.UserId);
        return i < 0 ? 0 : i + 1;
    }

    private static string? Medal(int rank) => rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => null };
}
