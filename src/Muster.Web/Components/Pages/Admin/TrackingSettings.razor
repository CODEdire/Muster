@page "/guilds/{GuildIdRaw}/tracking"
@layout GuildLayout
@inherits GuildAdminComponentBase
@inject ConfigCommandService Config
@inject TrackedChannelCommandService Channels
@inject Muster.Infrastructure.Services.Currencies.ICurrencyReadService Reader
@inject MusterDbContext Db
@using Microsoft.EntityFrameworkCore
@using Muster.Domain.Entities
@using Muster.Domain.Entities.Guilds
@using Muster.Domain.Entities.Members
@using Muster.Domain.Enums
@using Muster.Persistence
@using Muster.Persistence.Queries
@using Muster.Infrastructure.Services.Currencies
@using Muster.Infrastructure.Commands.Membership
@using Muster.Infrastructure.Commands.Tracking

<PageTitle>Tracking — Muster</PageTitle>

@if (State == AccessState.NeedLogin)
{
    <div class="panel glass empty">Please <a href="/account/login">log in</a>.</div>
}
else if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId/admin">← Admin</a>
        <h1>Tracking</h1>
        <p class="subtitle">Monitored channels, reward rates, anti-AFK guards, and privacy defaults.</p>
    </div>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <div class="panel glass">
        <h2>Rewards &amp; privacy</h2>
        <EditForm class="form-grid" Model="Settings" FormName="tracking-settings" OnValidSubmit="SaveSettingsAsync">
            <input type="hidden" name="Settings.Submitted" value="1" />
            <label class="check"><InputCheckbox @bind-Value="Settings.BackgroundOptIn" /> Background tracking is opt-in (members must opt in via <code>/track-privacy</code>)</label>
            <label class="check"><InputCheckbox @bind-Value="Settings.ApplyGuardsToSessions" /> New sessions pause reward time while muted or alone (default)</label>
            <label>Session payout currency
                <InputSelect @bind-Value="Settings.CoinCurrency">
                    <option value="">— none (POINTS only) —</option>
                    @foreach (var c in _spendable)
                    {
                        <option value="@c.Code">@c.Code — @c.Name</option>
                    }
                </InputSelect>
            </label>
            <label>Minutes per coin <InputNumber @bind-Value="Settings.MinutesPerCoin" /> <span class="subtitle">0 = no coin on session close</span></label>
            <label>Max session hours <InputNumber @bind-Value="Settings.MaxSessionHours" /> <span class="subtitle">auto-close a never-stopped session (0 = off)</span></label>
            <label>Activity retention (days) <InputNumber @bind-Value="Settings.ActivityRetentionDays" /> <span class="subtitle">prune raw records; rollups kept (0 = forever)</span></label>
            <label>Min session seconds <InputNumber @bind-Value="Settings.MinTrackedSeconds" /> <span class="subtitle">drop drive-by attendees under this (0 = keep all)</span></label>
            <label>Multiplier stacking
                <InputSelect @bind-Value="Settings.Stacking">
                    <option value="@MultiplierStacking.HighestWins">Highest wins</option>
                    <option value="@MultiplierStacking.Multiplicative">Multiplicative</option>
                </InputSelect>
                <span class="subtitle">how overlapping windows combine</span>
            </label>
            <label>Multiplier cap <InputNumber @bind-Value="Settings.Cap" /> <span class="subtitle">clamp the effective factor (0 = no cap)</span></label>
            <label>Session start bonus <InputNumber @bind-Value="Settings.StartBonus" /> <span class="subtitle">flat POINTS for being there at the start (0 = off)</span></label>
            <label>Session end bonus <InputNumber @bind-Value="Settings.EndBonus" /> <span class="subtitle">flat POINTS for staying to the end (0 = off)</span></label>
            <label>Start window (min) <InputNumber @bind-Value="Settings.StartWindow" /> <span class="subtitle">joined within N min of start qualifies</span></label>
            <label>End window (min) <InputNumber @bind-Value="Settings.EndWindow" /> <span class="subtitle">present within N min of end qualifies</span></label>
            <label class="check"><InputCheckbox @bind-Value="Settings.MultiplyBonuses" /> Scale presence bonuses by the active multiplier</label>
            <div class="btn-row"><button type="submit">Save</button></div>
        </EditForm>
        <p class="subtitle">Manage reward windows on the <a href="/guilds/@GuildId/multipliers">Multipliers</a> page.</p>
    </div>

    <div class="panel glass">
        <h2>Monitored channels</h2>
        @if (_channels.Count == 0)
        {
            <p class="empty">No channels monitored yet. Add one below (or use <code>/track-voice</code> / <code>/track-text</code> in Discord).</p>
        }
        else
        {
            <table class="leaderboard">
                <thead><tr><th>Kind</th><th>Channel</th><th>Mode</th><th>Rate</th><th>Guards</th></tr></thead>
                <tbody>
                    @foreach (var c in _channels)
                    {
                        <tr>
                            <td>@(c.Kind == GuildChannelKind.Voice ? "🔊 Voice" : "💬 Text")</td>
                            <td>@ChannelLabel(c.ChannelId, c.Name)@(c.DeletedAt is not null ? " ⚠️ deleted" : "")</td>
                            <td>@c.Mode</td>
                            <td>@(c.Kind == GuildChannelKind.Voice ? $"{c.PointsPerMinute}/min" : $"{c.PointsPerMessage}/msg")@(c.DailyCapPoints > 0 ? $" (cap {c.DailyCapPoints}/day)" : "")</td>
                            <td>@(c.Kind == GuildChannelKind.Voice ? string.Join(" ", new[] { c.Guards.Unmuted() ? "unmuted" : null, c.Guards.Undeafened() ? "undeafened" : null, c.Guards.NotAlone() ? "not-alone" : null }.Where(x => x != null)) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="panel glass">
        <h2>Add / update a channel</h2>
        <EditForm class="form-grid" Model="AddChannel" FormName="add-channel" OnValidSubmit="AddChannelAsync">
            <input type="hidden" name="AddChannel.Submitted" value="1" />
            @if (_voice.Count > 0 || _text.Count > 0)
            {
                <label>Channel
                    <InputSelect @bind-Value="AddChannel.ChannelId">
                        <option value="">— select —</option>
                        @if (_voice.Count > 0)
                        {
                            <optgroup label="🔊 Voice">
                                @foreach (var c in _voice)
                                {
                                    <option value="@c.ChannelId">@c.Name</option>
                                }
                            </optgroup>
                        }
                        @if (_text.Count > 0)
                        {
                            <optgroup label="💬 Text">
                                @foreach (var c in _text)
                                {
                                    <option value="@c.ChannelId">#@c.Name</option>
                                }
                            </optgroup>
                        }
                    </InputSelect>
                    <span class="subtitle">Kind is detected from the channel.</span>
                </label>
            }
            else
            {
                <label>Channel id <InputText @bind-Value="AddChannel.ChannelId" /> <span class="subtitle">no synced channels — enter an id</span></label>
                <label>Kind
                    <InputSelect @bind-Value="AddChannel.Kind">
                        <option value="voice">Voice (reward by minute)</option>
                        <option value="text">Text (stats)</option>
                    </InputSelect>
                </label>
            }
            <label>Points per minute <InputNumber @bind-Value="AddChannel.PointsPerMinute" /> <span class="subtitle">voice only</span></label>
            <label>Daily cap <InputNumber @bind-Value="AddChannel.DailyCap" /> <span class="subtitle">0 = uncapped</span></label>
            <label class="check"><InputCheckbox @bind-Value="AddChannel.SkipMuted" /> Skip muted <span class="subtitle">voice — can't speak (off = count phone-call presence)</span></label>
            <label class="check"><InputCheckbox @bind-Value="AddChannel.SkipDeafened" /> Skip deafened <span class="subtitle">voice — checked out</span></label>
            <label class="check"><InputCheckbox @bind-Value="AddChannel.SkipAlone" /> Skip when alone <span class="subtitle">voice</span></label>
            <label>Points per message <InputNumber @bind-Value="AddChannel.PointsPerMessage" /> <span class="subtitle">text reward (0 = stats only)</span></label>
            <label>Messages per point <InputNumber @bind-Value="AddChannel.MessagesPerPoint" /> <span class="subtitle">text</span></label>
            <label>Message cooldown (s) <InputNumber @bind-Value="AddChannel.CooldownSeconds" /> <span class="subtitle">text anti-burst</span></label>
            <div class="btn-row"><button type="submit">Save channel</button></div>
        </EditForm>
    </div>

    @if (_channels.Count > 0)
    {
        <div class="panel glass">
            <h2>Stop monitoring</h2>
            <EditForm class="form-grid" Model="RemoveChannel" FormName="remove-channel" OnValidSubmit="RemoveChannelAsync">
                <input type="hidden" name="RemoveChannel.Submitted" value="1" />
                <label>Channel
                    <InputSelect @bind-Value="RemoveChannel.ChannelId">
                        <option value="0">— select —</option>
                        @foreach (var c in _channels)
                        {
                            <option value="@c.ChannelId">@(c.Kind == GuildChannelKind.Voice ? "🔊" : "💬") @ChannelLabel(c.ChannelId, c.Name)</option>
                        }
                    </InputSelect>
                </label>
                <div class="btn-row"><button type="submit">Remove</button></div>
            </EditForm>
        </div>
    }
}

@code {
    [SupplyParameterFromForm(FormName = "tracking-settings")] private SettingsInput Settings { get; set; } = new();
    [SupplyParameterFromForm(FormName = "add-channel")] private AddChannelInput AddChannel { get; set; } = new();
    [SupplyParameterFromForm(FormName = "remove-channel")] private RemoveChannelInput RemoveChannel { get; set; } = new();

    private IReadOnlyList<CurrencyInfo> _spendable = [];
    private IReadOnlyList<GuildChannel> _channels = [];
    private IReadOnlyList<GuildChannel> _voice = [];
    private IReadOnlyList<GuildChannel> _text = [];
    private Dictionary<ulong, GuildChannel> _syncedById = new();

    private string ChannelLabel(ulong channelId, string? storedName)
    {
        if (_syncedById.TryGetValue(channelId, out var c) && !string.IsNullOrWhiteSpace(c.Name))
        {
            return (c.Kind == GuildChannelKind.Text ? "#" : "") + c.Name;
        }
        return string.IsNullOrWhiteSpace(storedName) ? $"#{channelId}" : storedName!;
    }

    protected override async Task LoadAsync()
    {
        _spendable = (await Reader.GetCurrenciesAsync(GuildId)).Where(c => c.Spendable).ToList();
        _channels = await Db.ListTrackedChannelsAsync(GuildId);
        _voice = await Db.ListChannelsByKindAsync(GuildId, GuildChannelKind.Voice);
        _text = await Db.ListChannelsByKindAsync(GuildId, GuildChannelKind.Text);
        _syncedById = _voice.Concat(_text).ToDictionary(c => c.ChannelId);

        if (string.IsNullOrEmpty(Settings.Submitted))
        {
            var s = (await Db.Guilds.AsNoTracking().FirstOrDefaultAsync(g => g.Id == GuildId))?.Settings ?? new GuildSettings();
            Settings.BackgroundOptIn = s.BackgroundTrackingOptIn;
            Settings.ApplyGuardsToSessions = s.ApplyAfkGuardsToSessions;
            Settings.CoinCurrency = s.SessionCoinCurrencyCode;
            Settings.MinutesPerCoin = s.MinutesPerCoin;
            Settings.MaxSessionHours = s.MaxSessionHours;
            Settings.ActivityRetentionDays = s.ActivityRetentionDays;
            Settings.MinTrackedSeconds = s.MinTrackedSeconds;
            Settings.Stacking = s.MultiplierStacking;
            Settings.Cap = s.MultiplierCap;
            Settings.StartBonus = s.SessionStartBonus;
            Settings.EndBonus = s.SessionEndBonus;
            Settings.StartWindow = s.StartBonusWindowMinutes;
            Settings.EndWindow = s.EndBonusWindowMinutes;
            Settings.MultiplyBonuses = s.MultiplyPresenceBonuses;
        }
    }

    private async Task SaveSettingsAsync()
    {
        await Config.SetBackgroundOptInAsync(GuildId, Settings.BackgroundOptIn);
        await Config.SetApplyGuardsToSessionsAsync(GuildId, Settings.ApplyGuardsToSessions);
        await Config.SetMaxSessionHoursAsync(GuildId, Settings.MaxSessionHours);
        await Config.SetActivityRetentionAsync(GuildId, Settings.ActivityRetentionDays);
        await Config.SetMinTrackedSecondsAsync(GuildId, Settings.MinTrackedSeconds);
        var coin = await Config.SetSessionCoinAsync(GuildId, Settings.CoinCurrency, Settings.MinutesPerCoin);
        await Config.SetMultiplierSettingsAsync(GuildId, Settings.Stacking, Settings.Cap, Settings.StartBonus, Settings.EndBonus, Settings.StartWindow, Settings.EndWindow, Settings.MultiplyBonuses);

        await AuditAsync("config.tracking", $"background-opt-in={Settings.BackgroundOptIn}; session-guards={Settings.ApplyGuardsToSessions}; coin={Settings.CoinCurrency}/{Settings.MinutesPerCoin}; max-session-h={Settings.MaxSessionHours}; activity-retention={Settings.ActivityRetentionDays}; stacking={Settings.Stacking}; cap={Settings.Cap}; bonuses={Settings.StartBonus}/{Settings.EndBonus}");
        Message = coin.IsError ? coin.Message : "Tracking settings saved.";
        await LoadAsync();
    }

    private async Task AddChannelAsync()
    {
        if (!ulong.TryParse(AddChannel.ChannelId, out var channelId) || channelId == 0)
        {
            Message = "Enter a valid channel id.";
            return;
        }

        // Prefer the synced channel's actual kind/name; fall back to the manual Kind picker for unsynced ids.
        _syncedById.TryGetValue(channelId, out var synced);
        var isText = synced is not null ? synced.Kind == GuildChannelKind.Text : AddChannel.Kind == "text";
        var name = synced?.Name;

        var result = isText
            ? await Channels.SetTextAsync(GuildId, channelId, AddChannel.PointsPerMessage, AddChannel.MessagesPerPoint, AddChannel.CooldownSeconds, AddChannel.DailyCap, channelName: name)
            : await Channels.SetVoiceAsync(GuildId, channelId, AddChannel.PointsPerMinute, AddChannel.DailyCap, AddChannel.SkipMuted, AddChannel.SkipDeafened, AddChannel.SkipAlone, channelName: name);

        if (!result.IsError)
        {
            await AuditAsync("config.trackChannel", result.Message);
        }

        Message = result.Message;
        AddChannel = new AddChannelInput();
        await LoadAsync();
    }

    private async Task RemoveChannelAsync()
    {
        if (RemoveChannel.ChannelId == 0)
        {
            Message = "Choose a channel to remove.";
            return;
        }

        var result = await Channels.RemoveAsync(GuildId, RemoveChannel.ChannelId);
        if (!result.IsError)
        {
            await AuditAsync("config.untrackChannel", result.Message);
        }

        Message = result.Message;
        RemoveChannel = new RemoveChannelInput();
        await LoadAsync();
    }

    public class SettingsInput
    {
        public string? Submitted { get; set; }
        public bool BackgroundOptIn { get; set; }
        public bool ApplyGuardsToSessions { get; set; }
        public string? CoinCurrency { get; set; }
        public int MinutesPerCoin { get; set; }
        public int MaxSessionHours { get; set; }
        public int ActivityRetentionDays { get; set; }
        public int MinTrackedSeconds { get; set; }
        public MultiplierStacking Stacking { get; set; }
        public decimal Cap { get; set; }
        public int StartBonus { get; set; }
        public int EndBonus { get; set; }
        public int StartWindow { get; set; } = 5;
        public int EndWindow { get; set; } = 5;
        public bool MultiplyBonuses { get; set; }
    }

    public class AddChannelInput
    {
        public string? Submitted { get; set; }
        public string? ChannelId { get; set; }
        public string Kind { get; set; } = "voice";
        public int PointsPerMinute { get; set; } = 1;
        public int DailyCap { get; set; }
        public bool SkipMuted { get; set; }
        public bool SkipDeafened { get; set; } = true;
        public bool SkipAlone { get; set; } = true;
        public int PointsPerMessage { get; set; }
        public int MessagesPerPoint { get; set; } = 1;
        public int CooldownSeconds { get; set; }
    }

    public class RemoveChannelInput
    {
        public string? Submitted { get; set; }
        public ulong ChannelId { get; set; }
    }
}
