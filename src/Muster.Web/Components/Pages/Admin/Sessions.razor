@page "/guilds/{GuildIdRaw}/sessions"
@layout GuildLayout
@inherits GuildMemberComponentBase
@inject ParticipationReadService Participation
@inject MusterDbContext Db
@using Microsoft.EntityFrameworkCore
@using Muster.Domain.Enums
@using Muster.Persistence
@using Muster.Persistence.Queries
@using Muster.Infrastructure.Services.Tracking

<PageTitle>Sessions — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <h1>Sessions</h1>
        <p class="subtitle">Live operations, voice participation@(_isStaff ? ", and history" : "").</p>
    </div>

    @if (_present)
    {
        <div class="panel glass">
            <strong>You're being tracked in a live session.</strong>
            <a class="btn btn-sm btn-ghost" href="/guilds/@GuildId/me">Manage in your dashboard</a>
            <a class="btn btn-sm btn-ghost" href="/guilds/@GuildId/wallet#privacy">Privacy settings</a>
        </div>
    }

    <nav class="pill-tabs">
        <a class="@(Tab == "active" ? "active" : "")" href="@TabUrl("active")">Active</a>
        <a class="@(Tab == "leaderboard" ? "active" : "")" href="@TabUrl("leaderboard")">Leaderboard</a>
        @if (_isStaff)
        {
            <a class="@(Tab == "history" ? "active" : "")" href="@TabUrl("history")">History</a>
        }
        @if (_isStaff && _hasBackground)
        {
            <a class="@(Tab == "background" ? "active" : "")" href="@TabUrl("background")">Background</a>
        }
    </nav>

    @if (Tab == "leaderboard")
    {
        <div class="panel glass">
            @if (_leaderboard.Count == 0)
            {
                <p class="empty">No voice activity tracked yet.</p>
            }
            else
            {
                <table class="leaderboard">
                    <thead><tr><th>#</th><th>Member</th><th>Voice time</th></tr></thead>
                    <tbody>
                        @{ var rank = 1; }
                        @foreach (var e in _leaderboard)
                        {
                            <tr><td>@rank</td><td>@Name(e.UserId)</td><td>@Dur(e.VoiceMinutes)</td></tr>
                            rank++;
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else if (Tab == "background" && _isStaff)
    {
        <div class="panel glass">
            <div class="panel-head">
                <h2>Background — tracked right now</h2>
                <a class="btn btn-ghost btn-sm" href="@TabUrl("background")">Refresh</a>
            </div>
            @if (_background.Count == 0)
            {
                <p class="empty">No one is being tracked in a monitored channel right now.</p>
            }
            else
            {
                <table class="leaderboard">
                    <thead><tr><th>Channel</th><th>Members present</th></tr></thead>
                    <tbody>
                        @foreach (var c in _background)
                        {
                            <tr>
                                <td>@Chan(c.ChannelId, c.ChannelName)</td>
                                <td>@string.Join(", ", c.PresentUserIds.Select(Name))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else if (Tab == "history" && _isStaff)
    {
        <div class="panel glass">
            <form method="get" class="filter-bar">
                <input type="hidden" name="tab" value="history" />
                <input type="search" name="search" value="@Search" placeholder="Search session name" />
                <input type="hidden" name="sort" value="@Sort" />
                <input type="hidden" name="desc" value="@Desc.ToString().ToLowerInvariant()" />
                <button type="submit">Filter</button>
                <a class="btn btn-ghost" href="/guilds/@GuildId/participation/export.csv">Export CSV</a>
            </form>
        </div>
        <div class="panel glass">
            @if (_history is null || _history.Items.Count == 0)
            {
                <p class="empty">No completed sessions.</p>
            }
            else
            {
                <table class="leaderboard">
                    <thead>
                        <tr>
                            <th><a href="@SortUrl("name")">Name @Ind("name")</a></th>
                            <th>Source</th><th>Channel</th>
                            <th><a href="@SortUrl("ended")">Ended @Ind("ended")</a></th>
                            <th>Duration</th>
                            <th><a href="@SortUrl("attendees")">Attendees @Ind("attendees")</a></th>
                            <th><a href="@SortUrl("minutes")">Minutes @Ind("minutes")</a></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _history.Items)
                        {
                            <tr>
                                <td><a href="/guilds/@GuildId/sessions/@s.Id">@s.Name</a></td>
                                <td>@Src(s.Source)</td>
                                <td>@Chan(s.VoiceChannelId, s.VoiceChannelName)</td>
                                <td>@(s.EndedAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "—") UTC</td>
                                <td>@Dur(s.EndedAt is { } e ? Math.Max(0, (int)(e - s.StartedAt).TotalMinutes) : 0)</td>
                                <td>@s.Attendees</td>
                                <td>@s.TotalMinutes</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="pager">
                    @if (_history.Page > 1)
                    {
                        <a class="btn btn-ghost" href="@Query("history", Sort, Desc, _history.Page - 1)">← Prev</a>
                    }
                    <span>Page @_history.Page of @_history.TotalPages · @_history.Total total</span>
                    @if (_history.Page < _history.TotalPages)
                    {
                        <a class="btn btn-ghost" href="@Query("history", Sort, Desc, _history.Page + 1)">Next →</a>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="panel glass">
            <form method="get" class="filter-bar">
                <input type="hidden" name="tab" value="active" />
                <input type="search" name="search" value="@Search" placeholder="Search session name" />
                <input type="hidden" name="sort" value="@Sort" />
                <input type="hidden" name="desc" value="@Desc.ToString().ToLowerInvariant()" />
                <button type="submit">Filter</button>
                <a class="btn btn-ghost btn-sm" href="@TabUrl("active")">Refresh</a>
            </form>
        </div>
        <div class="panel glass">
            @if (_active is null || _active.Items.Count == 0)
            {
                <p class="empty">No active sessions right now.</p>
            }
            else
            {
                <table class="leaderboard">
                    <thead>
                        <tr>
                            <th><a href="@SortUrl("name")">Name @Ind("name")</a></th>
                            <th>Source</th><th>Channel</th>
                            <th><a href="@SortUrl("started")">Started @Ind("started")</a></th>
                            <th><a href="@SortUrl("present")">In voice now @Ind("present")</a></th>
                            <th><a href="@SortUrl("attendees")">Attendees @Ind("attendees")</a></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _active.Items)
                        {
                            <tr>
                                <td><a href="/guilds/@GuildId/sessions/@s.Id">@s.Name</a></td>
                                <td>@Src(s.Source)</td>
                                <td>@Chan(s.VoiceChannelId, s.VoiceChannelName)</td>
                                <td>@s.StartedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                <td>@s.PresentNow</td>
                                <td>@s.Attendees</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="pager">
                    @if (_active.Page > 1)
                    {
                        <a class="btn btn-ghost" href="@Query("active", Sort, Desc, _active.Page - 1)">← Prev</a>
                    }
                    <span>Page @_active.Page of @_active.TotalPages · @_active.Total total</span>
                    @if (_active.Page < _active.TotalPages)
                    {
                        <a class="btn btn-ghost" href="@Query("active", Sort, Desc, _active.Page + 1)">Next →</a>
                    }
                </div>
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery] private string? Tab { get; set; }
    [SupplyParameterFromQuery] private string? Search { get; set; }
    [SupplyParameterFromQuery] private string? Sort { get; set; }
    [SupplyParameterFromQuery] private bool Desc { get; set; }
    [SupplyParameterFromQuery] private int Page { get; set; }

    private bool _isStaff;
    private bool _present;
    private bool _hasBackground;
    private PagedResult<ActiveSessionView>? _active;
    private PagedResult<RecentSessionView>? _history;
    private IReadOnlyList<VoiceLeaderboardEntry> _leaderboard = [];
    private IReadOnlyList<BackgroundChannelView> _background = [];
    private Dictionary<ulong, string> _names = [];

    private string CurrentTab => Tab is "leaderboard" or "history" or "background" ? Tab : "active";

    protected override async Task LoadAsync()
    {
        _isStaff = await Auth.IsAdminAsync(GuildId, UserId) || await Auth.IsOfficerAsync(GuildId, UserId);
        _hasBackground = _isStaff && await Db.TrackedChannels.AnyAsync(c => c.GuildId == GuildId && c.Kind == TrackedChannelKind.Voice && c.Mode != TrackedChannelMode.Off);
        Tab = CurrentTab;
        var page = Page <= 0 ? 1 : Page;

        // Banner: is the viewer currently in an active session's voice channel?
        _present = await Db.TrackingSessions
            .Where(s => s.GuildId == GuildId && s.Status == TrackingSessionStatus.Active)
            .SelectMany(s => s.Attendance)
            .AnyAsync(a => a.UserId == UserId && a.OpenSegmentStart != null);

        if (Tab == "leaderboard")
        {
            _leaderboard = await Participation.VoiceLeaderboardAsync(GuildId, 50);
            _names = await Db.UserDisplayNameMapAsync(_leaderboard.Select(e => e.UserId).ToList());
        }
        else if (Tab == "background" && _isStaff)
        {
            _background = await Participation.BackgroundNowAsync(GuildId);
            _names = await Db.UserDisplayNameMapAsync(_background.SelectMany(c => c.PresentUserIds).Distinct().ToList());
        }
        else if (Tab == "history" && _isStaff)
        {
            _history = await Participation.RecentSessionsPageAsync(GuildId, Search, Sort ?? "ended", Desc, page);
        }
        else
        {
            Tab = "active";
            _active = await Participation.ActiveSessionsPageAsync(GuildId, Search, Sort ?? "started", Desc, page);
        }
    }

    private string Name(ulong userId) => _names.GetValueOrDefault(userId, $"User {userId}");

    private static string Src(TrackingSessionSource s) => s == TrackingSessionSource.DiscordScheduledEvent ? "Scheduled event" : "Manual";

    private static string Chan(ulong id, string name) => string.IsNullOrWhiteSpace(name) ? $"#{id}" : $"#{name}";

    private static string Dur(int minutes)
    {
        var h = minutes / 60;
        var m = minutes % 60;
        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }

    private string Query(string tab, string? sort, bool desc, int page)
    {
        var parts = new List<string> { $"tab={tab}" };
        if (!string.IsNullOrEmpty(Search)) parts.Add($"search={Uri.EscapeDataString(Search)}");
        if (!string.IsNullOrEmpty(sort)) parts.Add($"sort={sort}");
        parts.Add($"desc={desc.ToString().ToLowerInvariant()}");
        parts.Add($"page={page}");
        return $"/guilds/{GuildId}/sessions?{string.Join("&", parts)}";
    }

    private string TabUrl(string tab) => Query(tab, null, false, 1);

    private string SortUrl(string column)
    {
        var desc = Sort == column ? !Desc : true; // toggle when re-clicking the active column
        return Query(Tab!, column, desc, 1);
    }

    private string Ind(string column) => Sort == column ? (Desc ? "▼" : "▲") : "";
}
