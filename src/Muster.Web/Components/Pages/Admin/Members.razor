@page "/guilds/{GuildIdRaw}/members"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildAdminComponentBase
@implements IDisposable
@inject IServiceScopeFactory Scopes
@inject Wolverine.IMessageBus Bus
@using Muster.Contracts
@using Muster.Domain.Enums
@using Muster.Infrastructure.Services.Web
@using Muster.Infrastructure.Services.Platform

<PageTitle>Members — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need staff or admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <h1>Members</h1>
        <p class="subtitle">Roster, balances, and engagement-at-a-glance. Click a member to drill in.</p>
    </div>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    @if (_kpis is not null)
    {
        <div class="stat-grid">
            <div class="card glass stat"><span class="label">Members</span><span class="num">@_kpis.Total.ToString("N0")</span><span class="subtitle">humans (bots hidden)</span></div>
            <div class="card glass stat"><span class="label">Active · 7d</span><span class="num">@_kpis.Active7d.ToString("N0")</span><span class="subtitle">any ledger or voice activity</span></div>
            <div class="card glass stat"><span class="label">Tracking opt-outs</span><span class="num">@_kpis.TrackingOptOuts.ToString("N0")</span><span class="subtitle">background or all-out</span></div>
            <div class="card glass stat"><span class="label">New · 30d</span><span class="num">@_kpis.NewLast30d.ToString("N0")</span><span class="subtitle">joined recently</span></div>
        </div>
    }

    <div class="panel glass dg-frame dg-fill">
    <div class="dg-toolbar">
        <div class="dg-filters">
            <input type="search" class="dg-search" placeholder="Search name…" @bind="_search" @bind:event="oninput" @bind:after="DebouncedSearchAsync" />
            <select class="dg-select" value="@_tracking" @onchange="OnTracking">
                <option value="">Any tracking</option>
                <option value="Default">Default</option>
                <option value="In">Opted in</option>
                <option value="BackgroundOut">Background out</option>
                <option value="AllOut">All out</option>
            </select>
            <select class="dg-select" value="@_activity" @onchange="OnActivity">
                <option value="">Any activity</option>
                <option value="active7">Active last 7d</option>
                <option value="stale30">Inactive 30d+</option>
                <option value="never">Never active</option>
            </select>
            <label class="dg-check">
                <input type="checkbox" checked="@_dmOut" @onchange="OnDmOut" /> DM opt-outs
            </label>
            @if (_loading)
            {
                <span class="dg-loading" aria-hidden="true"></span>
            }
        </div>
        <div class="dg-actions">
            <button type="button" class="btn btn-ghost btn-sm" title="Pull the latest roster from Discord" @onclick="SyncAsync">
                <span class="material-symbols-outlined">refresh</span> Sync from Discord
            </button>
        </div>
    </div>

    <div class="dg-scroll">
        <table class="dg-table">
            <thead>
                <tr>
                    <th class="sortable" @onclick='() => SetSort("name")'>Member @Ind("name")</th>
                    <th>Tracking</th>
                    <th class="num sortable" @onclick='() => SetSort("roles")'>Roles @Ind("roles")</th>
                    <th class="num sortable" @onclick='() => SetSort("points")'>Points @Ind("points")</th>
                    <th class="num sortable" @onclick='() => SetSort("currencies")'>Wallets @Ind("currencies")</th>
                    <th class="sortable" @onclick='() => SetSort("joined")'>Joined @Ind("joined")</th>
                    <th class="sortable" @onclick='() => SetSort("active")'>Last active @Ind("active")</th>
                    <th class="dg-actions-col"></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows is null)
                {
                    <tr class="dg-empty"><td colspan="8">Loading…</td></tr>
                }
                else if (PagedRows.Count == 0)
                {
                    <tr class="dg-empty"><td colspan="8">No members match these filters.</td></tr>
                }
                else
                {
                    @foreach (var r in PagedRows)
                    {
                        <tr>
                            <td>
                                <UserChip Name="@r.DisplayName" AvatarUrl="@r.AvatarUrl" Href="@MusterLinks.MemberDetail(GuildId, r.UserId)" />
                            </td>
                            <td>
                                <span class="track-pill track-@(r.Tracking.ToString().ToLowerInvariant())" title="@TrackTitle(r.Tracking)">@TrackLabel(r.Tracking)</span>
                                @if (r.DmOptOut)
                                {
                                    <span class="track-pill track-dmout" title="Opted out of currency receipt DMs">DM off</span>
                                }
                            </td>
                            <td class="num">@r.RoleCount</td>
                            <td class="num">@r.Points.ToString("N0")</td>
                            <td class="num">@r.CurrencyCount</td>
                            <td><LocalTime Value="r.JoinedAt" Zone="@_zoneId" Pattern="yyyy-MM-dd" /></td>
                            <td>
                                @if (r.LastActiveAt is { } la)
                                {
                                    <LocalTime Value="la" Zone="@_zoneId" />
                                }
                                else
                                {
                                    <span class="subtitle">—</span>
                                }
                            </td>
                            <td class="dg-actions-col">
                                <a class="icon-btn" title="View member" aria-label="View member" href="/guilds/@GuildId/members/@r.UserId">
                                    <span class="material-symbols-outlined">visibility</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="dg-footer">
        <div class="dg-footer-left">
            <div class="dg-pagesize">
                Rows
                <select class="dg-select" value="@_pageSize" @onchange="OnSize">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <span class="dg-tz">times in <LocalTime ShowZone="true" Zone="@_zoneId" /></span>
        </div>
        <div class="dg-pager">
            <button type="button" class="btn btn-ghost btn-sm" disabled="@(_page <= 1)" @onclick="Prev">← Prev</button>
            <span>Page @_page of @TotalPages · @FilteredCount total</span>
            <button type="button" class="btn btn-ghost btn-sm" disabled="@(_page >= TotalPages)" @onclick="Next">Next →</button>
        </div>
    </div>
    </div>
}

@code {
    // EconomyManager — economy staff need to award/inspect members from here.
    protected override GuildAccessTier RequiredAccess => GuildAccessTier.EconomyManager;

    private const int SearchDebounceMs = 350;

    private IReadOnlyList<MembersDirectoryRow>? _rows;
    private MembersKpis? _kpis;
    private bool _loading;
    private string _zoneId = TimeZoneService.Utc;

    private string? _search;
    private string _tracking = "";
    private string _activity = "";
    private bool _dmOut;
    private string _sortKey = "active";
    private bool _desc = true;
    private int _page = 1;
    private int _pageSize = 25;

    private CancellationTokenSource? _searchDebounce;

    private IReadOnlyList<MembersDirectoryRow> FilteredRows
    {
        get
        {
            if (_rows is null) return [];
            IEnumerable<MembersDirectoryRow> q = _rows;

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(r => r.DisplayName.Contains(s, StringComparison.OrdinalIgnoreCase));
            }

            if (Enum.TryParse<TrackingChoice>(_tracking, out var tc))
            {
                q = q.Where(r => r.Tracking == tc);
            }

            var now = DateTimeOffset.UtcNow;
            q = _activity switch
            {
                "active7" => q.Where(r => r.LastActiveAt is { } la && la >= now.AddDays(-7)),
                "stale30" => q.Where(r => r.LastActiveAt is { } la && la < now.AddDays(-30)),
                "never" => q.Where(r => r.LastActiveAt is null),
                _ => q,
            };

            if (_dmOut)
            {
                q = q.Where(r => r.DmOptOut);
            }

            q = (_sortKey, _desc) switch
            {
                ("name", true) => q.OrderByDescending(r => r.DisplayName),
                ("name", false) => q.OrderBy(r => r.DisplayName),
                ("roles", true) => q.OrderByDescending(r => r.RoleCount).ThenBy(r => r.DisplayName),
                ("roles", false) => q.OrderBy(r => r.RoleCount).ThenBy(r => r.DisplayName),
                ("points", true) => q.OrderByDescending(r => r.Points).ThenBy(r => r.DisplayName),
                ("points", false) => q.OrderBy(r => r.Points).ThenBy(r => r.DisplayName),
                ("currencies", true) => q.OrderByDescending(r => r.CurrencyCount).ThenBy(r => r.DisplayName),
                ("currencies", false) => q.OrderBy(r => r.CurrencyCount).ThenBy(r => r.DisplayName),
                ("joined", true) => q.OrderByDescending(r => r.JoinedAt).ThenBy(r => r.DisplayName),
                ("joined", false) => q.OrderBy(r => r.JoinedAt).ThenBy(r => r.DisplayName),
                ("active", true) => q.OrderByDescending(r => r.LastActiveAt ?? DateTimeOffset.MinValue).ThenBy(r => r.DisplayName),
                ("active", false) => q.OrderBy(r => r.LastActiveAt ?? DateTimeOffset.MaxValue).ThenBy(r => r.DisplayName),
                _ => q.OrderByDescending(r => r.LastActiveAt ?? DateTimeOffset.MinValue),
            };

            return q.ToList();
        }
    }

    private int FilteredCount => FilteredRows.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)_pageSize));
    private IReadOnlyList<MembersDirectoryRow> PagedRows
        => FilteredRows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override async Task LoadAsync()
    {
        await using var scope = Scopes.CreateAsyncScope();
        var sp = scope.ServiceProvider;

        _zoneId = await sp.GetRequiredService<TimeZoneService>().ResolveZoneIdAsync(GuildId, UserId);
        await ReloadAsync(sp);
    }

    private async Task ReloadAsync(IServiceProvider? sp = null)
    {
        _loading = true;
        try
        {
            if (sp is null)
            {
                await using var scope = Scopes.CreateAsyncScope();
                var (k, r) = await scope.ServiceProvider.GetRequiredService<WebMemberService>().LoadDirectoryAsync(GuildId);
                _kpis = k;
                _rows = r;
            }
            else
            {
                var (k, r) = await sp.GetRequiredService<WebMemberService>().LoadDirectoryAsync(GuildId);
                _kpis = k;
                _rows = r;
            }

            if (_page > TotalPages) _page = TotalPages;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DebouncedSearchAsync()
    {
        _searchDebounce?.Cancel();
        var cts = _searchDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchDebounceMs, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (!cts.IsCancellationRequested)
        {
            _page = 1;
            StateHasChanged();
        }
    }

    private void OnTracking(ChangeEventArgs e) { _tracking = (e.Value as string) ?? ""; _page = 1; }
    private void OnActivity(ChangeEventArgs e) { _activity = (e.Value as string) ?? ""; _page = 1; }
    private void OnDmOut(ChangeEventArgs e) { _dmOut = e.Value is true; _page = 1; }
    private void OnSize(ChangeEventArgs e) { _pageSize = int.TryParse(e.Value as string, out var v) ? v : 25; _page = 1; }

    private void SetSort(string column)
    {
        _desc = _sortKey == column ? !_desc : true;
        _sortKey = column;
        _page = 1;
    }

    private void Prev() { if (_page > 1) _page--; }
    private void Next() { if (_page < TotalPages) _page++; }

    private string Ind(string column) => _sortKey == column ? (_desc ? "▼" : "▲") : "";

    private async Task SyncAsync()
    {
        await Bus.PublishAsync(new SyncGuildMembers(GuildId));
        await using var scope = Scopes.CreateAsyncScope();
        await scope.ServiceProvider.GetRequiredService<AuditService>()
            .RecordMemberSyncAsync(GuildId, UserId, "Requested a member sync from Discord");
        Message = "Requested a sync from Discord — refresh in a moment to see the latest roster.";
    }

    private static string TrackLabel(TrackingChoice t) => t switch
    {
        TrackingChoice.In => "Opted in",
        TrackingChoice.BackgroundOut => "Background out",
        TrackingChoice.AllOut => "All out",
        _ => "Default",
    };

    private static string TrackTitle(TrackingChoice t) => t switch
    {
        TrackingChoice.In => "Explicitly opted into all tracking",
        TrackingChoice.BackgroundOut => "Opted out of background tracking; Sessions still tracked",
        TrackingChoice.AllOut => "Opted out of all tracking",
        _ => "Follows guild policy",
    };

    public void Dispose()
    {
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
    }
}
