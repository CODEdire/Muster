    // ---- Award/adjust ----

    private bool _syncing;

    /// <summary>Pull this member's external (connector) balances now and create any missing wallets — the same
    /// reconcile the dashboard does on visit, forced. Creates a wallet per external currency even when the balance
    /// already matches (so the member always has a wallet afterwards).</summary>
    private async Task SyncMemberAsync()
    {
        if (_syncing)
        {
            return;
        }

        _syncing = true;
        StateHasChanged();
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            var sync = scope.ServiceProvider.GetRequiredService<Muster.Infrastructure.Connectors.CurrencyConnectorSyncService>();
            var synced = await sync.SyncMemberDueAsync(GuildId, UserIdParsed, force: true);
            Message = synced > 0 ? $"Synced {synced} external balance(s) for this member." : "No external currencies to sync for this member.";
            await LoadAsync();
        }
        catch (Exception)
        {
            Message = "Couldn't sync this member's balances — check the connector configuration.";
        }
        finally
        {
            _syncing = false;
            StateHasChanged();
        }
    }

    private Task OpenAwardAsync()
    {
        _awardOpen = true;
        Award.Currency ??= _currencies.FirstOrDefault(c => c.Code != "POINTS")?.Code ?? _currencies.FirstOrDefault()?.Code;
        return Task.CompletedTask;
    }

    private void CloseAward() => _awardOpen = false;

    private async Task AwardAsync()
    {
        if (Award.Amount == 0)
        {
            Message = "Amount must be non-zero (negative deducts).";
            return;
        }

        var code = string.IsNullOrWhiteSpace(Award.Currency) ? "POINTS" : Award.Currency!;
        var reason = string.IsNullOrWhiteSpace(Award.Reason) ? "Adjustment" : Award.Reason!.Trim();

        _awarding = true;
        try
        {
            var result = await Bus.InvokeAsync<Result>(new AdjustCurrency(GuildId, UserId, code, UserIdParsed, Award.Amount, reason));
            if (result.Ok)
            {
                var verb = Award.Amount > 0 ? "Awarded" : "Deducted";
                Message = $"{verb} {Math.Abs(Award.Amount)} {code.ToUpperInvariant()} {(Award.Amount > 0 ? "to" : "from")} {_summary!.DisplayName} — {reason}";
                Award = new AwardInput { Currency = code };
                _awardOpen = false;

                await LoadAsync(); // refresh balances + ledger + audit
            }
            else
            {
                Message = result.Status switch
                {
                    "CurrencyNotFound" => $"Unknown currency '{code}'.",
                    "Forbidden" => "You're not allowed to do that.",
                    var other => other,
                };
            }
        }
        finally
        {
            _awarding = false;
        }
    }

    private static string TrackLabel(TrackingChoice t) => t switch
    {
        TrackingChoice.In => "Opted in",
        TrackingChoice.BackgroundOut => "Background out",
        TrackingChoice.AllOut => "All out",
        _ => "Default",
    };

    private static string Dur(int minutes)
    {
        var h = minutes / 60;
        var m = minutes % 60;
        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }

    public void Dispose()
    {
        _ledgerSearchDebounce?.Cancel();
        _ledgerSearchDebounce?.Dispose();
        _auditSearchDebounce?.Cancel();
        _auditSearchDebounce?.Dispose();
    }

    public class AwardInput
    {
        public string? Currency { get; set; }
        public long Amount { get; set; }
        public string? Reason { get; set; }
    }
