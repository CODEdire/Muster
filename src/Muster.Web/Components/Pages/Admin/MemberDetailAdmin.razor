    private async Task OnAuditPreset(ChangeEventArgs e)
    {
        _auditPreset = (e.Value as string) ?? "";
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        (_auditFrom, _auditTo) = _auditPreset switch
        {
            "today" => (today.ToString("yyyy-MM-dd"), today.ToString("yyyy-MM-dd")),
            "yesterday" => (today.AddDays(-1).ToString("yyyy-MM-dd"), today.AddDays(-1).ToString("yyyy-MM-dd")),
            "24h" => (today.AddDays(-1).ToString("yyyy-MM-dd"), today.ToString("yyyy-MM-dd")),
            "7d" => (today.AddDays(-7).ToString("yyyy-MM-dd"), today.ToString("yyyy-MM-dd")),
            "30d" => (today.AddDays(-30).ToString("yyyy-MM-dd"), today.ToString("yyyy-MM-dd")),
            _ => (null, null),
        };
        _auditPage = 1;
        await ReloadAuditAsync();
    }

