@page "/guilds/{GuildIdRaw}/currencies"
@inherits GuildAdminComponentBase
@inject CurrencyAdminService CurrencyAdmin
@inject ICurrencyService Currency
@using Muster.Domain.Entities
@using Muster.Domain.Enums
@using Muster.Infrastructure.Services.Currencies

<PageTitle>Currencies — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId/admin">← Admin</a>
        <h1>Currencies</h1>
        <p class="subtitle">POINTS drives the seasonal leaderboard. Create a spendable currency (e.g. COIN)
            for wallets, bounties, and external loot connectors.</p>
    </div>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <div class="panel glass">
        <div class="panel-head">
            <h2>Currencies</h2>
            <a class="btn" href="/guilds/@GuildId/currencies/new">+ New currency</a>
        </div>
        <table class="leaderboard">
            <thead><tr><th>Code</th><th>Name</th><th>Seasonal</th><th>Spendable</th><th>Mode</th><th>Connector</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in _currencies)
                {
                    <tr>
                        <td>@c.Code @(c.IsSystem ? "(system)" : "")</td>
                        <td>@c.Name</td>
                        <td>@(c.IsSeasonal ? "yes" : "no")</td>
                        <td>@(c.IsSpendable ? "yes" : "no")</td>
                        <td>@c.Mode</td>
                        <td>@ConnectorSummary(c)</td>
                        <td><a class="btn btn-sm btn-ghost" href="/guilds/@GuildId/currencies/@c.Id/edit">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="panel glass">
        <h2>Maintenance</h2>
        <p class="subtitle">Recompute every wallet balance in this server from the ledger (the ledger is the source
            of truth; this fixes any cached-balance drift).</p>
        <EditForm Model="this" FormName="rebuild-wallets" OnValidSubmit="RebuildAsync">
            <div class="btn-row"><button type="submit" class="btn-ghost">Rebuild wallets</button></div>
        </EditForm>
    </div>
}

@code {
    private IReadOnlyList<CurrencyView> _currencies = [];

    protected override async Task LoadAsync()
        => _currencies = await CurrencyAdmin.ListAsync(GuildId);

    private static string ConnectorSummary(CurrencyView c)
    {
        var cfg = c.Connector.Config;
        if (c.Mode == CurrencyMode.Internal || !cfg.Enabled)
        {
            return "—";
        }

        var actions = string.Concat(cfg.Credit.Enabled ? "C" : "", cfg.Debit.Enabled ? "D" : "", cfg.GetBalance.Enabled ? "B" : "");
        return $"{cfg.Auth.Scheme} · {(actions.Length > 0 ? actions : "—")}";
    }

    private async Task RebuildAsync()
    {
        var corrected = await Currency.RebuildWalletsAsync(GuildId);
        Message = $"Rebuilt wallets — {corrected} balance(s) corrected.";
        await AuditAsync("currency.rebuildWallets", Message);
        await LoadAsync();
    }
}
