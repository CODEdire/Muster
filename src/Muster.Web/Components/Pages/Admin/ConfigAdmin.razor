@page "/guilds/{GuildIdRaw}/config"
@inherits GuildAdminComponentBase
@inject WebAdminService Admin
@inject ConfigCommandService Config
@inject MusterDbContext Db
@using Muster.Domain.Entities
@using Muster.Infrastructure.Persistence
@using Muster.Domain.Enums
@using Microsoft.EntityFrameworkCore

<PageTitle>Role mapping — Muster</PageTitle>

@if (State == AccessState.NeedLogin)
{
    <div class="panel glass empty">Please <a href="/account/login">log in</a>.</div>
}
else if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId/admin">← Admin</a>
        <h1>Role mapping</h1>
        <p class="subtitle">The guild owner and members with Discord Administrator / Manage&nbsp;Server
            always have admin access. Grant additional roles below.</p>
    </div>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <div class="stat-grid">
        <div class="stat glass">
            <div class="label">Admin roles</div>
            <div class="num">@RoleNames(_mapping?.AdminRoleIds)</div>
        </div>
        <div class="stat glass">
            <div class="label">Officer roles</div>
            <div class="num">@RoleNames(_mapping?.OfficerRoleIds)</div>
        </div>
        <div class="stat glass">
            <div class="label">Participant roles</div>
            <div class="num">@(_mapping is { ParticipantRoleIds.Count: 0 } ? "everyone" : RoleNames(_mapping?.ParticipantRoleIds))</div>
        </div>
        <div class="stat glass">
            <div class="label">Quest Manager roles</div>
            <div class="num">@RoleNames(_mapping?.QuestManagerRoleIds)</div>
        </div>
    </div>

    <p class="subtitle">Participant roles control who can earn rewards. With none set, everyone
        participates; add roles to restrict earning to org members and exclude guests.</p>

    <div class="panel glass">
        <h2>Toggle a role</h2>
        <EditForm class="form-grid" Model="Input" FormName="toggle-role" OnValidSubmit="SubmitAsync">
            <label>Role
                <InputSelect @bind-Value="Input.RoleId">
                    <option value="0">— select —</option>
                    @foreach (var r in _mapping?.AllRoles ?? [])
                    {
                        <option value="@r.RoleId">@r.Name</option>
                    }
                </InputSelect>
            </label>
            <label>Mapping
                <InputSelect @bind-Value="Input.Kind">
                    <option value="admin">Admin</option>
                    <option value="officer">Officer</option>
                    <option value="participant">Participant</option>
                    <option value="questmanager">Quest Manager</option>
                </InputSelect>
            </label>
            <div class="btn-row"><button type="submit">Toggle</button></div>
        </EditForm>
    </div>

    <div class="panel glass">
        <h2>Personal quest approval</h2>
        <p class="subtitle">Personal (member-funded) quests can be vetted and tiered by a quest manager
            before they open, with an optional final sign-off before payout.</p>
        <EditForm class="form-grid" Model="Approval" FormName="quest-approval" OnValidSubmit="SaveApprovalAsync">
            <input type="hidden" name="Approval.Submitted" value="1" />
            <label class="checkbox"><InputCheckbox @bind-Value="Approval.IntakeApproval" /> Require manager intake approval + tiering before a personal quest opens</label>
            <label>Final sign-off before payout
                <InputSelect @bind-Value="Approval.FinalMode">
                    <option value="@FinalApprovalMode.Off">Off — owner acceptance pays out directly</option>
                    <option value="@FinalApprovalMode.OwnerChoice">Owner chooses per quest</option>
                    <option value="@FinalApprovalMode.ApproverChoice">Intake approver decides</option>
                    <option value="@FinalApprovalMode.Forced">Always required</option>
                </InputSelect>
            </label>
            <div class="btn-row"><button type="submit">Save approval</button></div>
        </EditForm>
    </div>

    <div class="panel glass">
        <h2>Quest automation &amp; limits</h2>
        <p class="subtitle">Auto-resolve stuck quests after a number of hours (0 = off), and cap how many quests
            a member can run at once (0 = unlimited).</p>
        <EditForm class="form-grid" Model="Auto" FormName="quest-automation" OnValidSubmit="SaveAutomationAsync">
            <input type="hidden" name="Auto.Submitted" value="1" />
            <label>Intake timeout (hours) <InputNumber @bind-Value="Auto.IntakeHours" /></label>
            <label>… then
                <InputSelect @bind-Value="Auto.IntakeAction">
                    <option value="@StaleIntakeAction.Decline">Decline (refund owner)</option>
                    <option value="@StaleIntakeAction.Accept">Accept (open, no tier)</option>
                </InputSelect>
            </label>
            <label>Idle-claim timeout (hours) <InputNumber @bind-Value="Auto.ClaimHours" /> <span class="subtitle">releases the taker</span></label>
            <label>Submission review timeout (hours) <InputNumber @bind-Value="Auto.SubmissionHours" /></label>
            <label>… then
                <InputSelect @bind-Value="Auto.SubmissionAction">
                    <option value="@StaleSubmissionAction.Approve">Approve (settle)</option>
                    <option value="@StaleSubmissionAction.Reject">Send back for revision</option>
                    <option value="@StaleSubmissionAction.Dispute">Escalate to arbitration (personal)</option>
                </InputSelect>
            </label>
            <label>Final sign-off timeout (hours) <InputNumber @bind-Value="Auto.FinalHours" /></label>
            <label>… then
                <InputSelect @bind-Value="Auto.FinalAction">
                    <option value="@StaleFinalAction.Approve">Pay completer</option>
                    <option value="@StaleFinalAction.Refund">Refund owner</option>
                </InputSelect>
            </label>
            <label>Max active quests per poster <InputNumber @bind-Value="Auto.MaxOpenPerPoster" /></label>
            <label>Max active claims per member <InputNumber @bind-Value="Auto.MaxActiveClaims" /></label>
            <label>Max revision round-trips <InputNumber @bind-Value="Auto.MaxRevisions" /> <span class="subtitle">0 = unlimited</span></label>
            <div class="btn-row"><button type="submit">Save automation</button></div>
        </EditForm>
    </div>

    <div class="panel glass">
        <h2>Quest difficulty tiers</h2>
        <p class="subtitle">Bonus POINTS minted to the completer of a guild quest (or a personal quest a
            manager notarizes) by difficulty. S is hardest.</p>
        <EditForm class="form-grid" Model="Tier" FormName="tier-points" OnValidSubmit="SaveTiersAsync">
            <label>S — hardest <InputNumber @bind-Value="Tier.S" /></label>
            <label>A <InputNumber @bind-Value="Tier.A" /></label>
            <label>B <InputNumber @bind-Value="Tier.B" /></label>
            <label>C <InputNumber @bind-Value="Tier.C" /></label>
            <label>D <InputNumber @bind-Value="Tier.D" /></label>
            <label>E — easiest <InputNumber @bind-Value="Tier.E" /></label>
            <div class="btn-row"><button type="submit">Save tiers</button></div>
        </EditForm>
    </div>
}

@code {
    [SupplyParameterFromForm(FormName = "toggle-role")] private ToggleInput Input { get; set; } = new();
    [SupplyParameterFromForm(FormName = "tier-points")] private TierInput Tier { get; set; } = new();
    [SupplyParameterFromForm(FormName = "quest-approval")] private ApprovalInput Approval { get; set; } = new();
    [SupplyParameterFromForm(FormName = "quest-automation")] private AutomationInput Auto { get; set; } = new();

    private RoleMappingView? _mapping;

    protected override async Task LoadAsync()
    {
        _mapping = await Admin.GetRoleMappingAsync(GuildId);

        // Prefill tier values on GET only; on a post the bound values survive (long? stays null on the
        // other form's post, so we only fill blanks).
        var settings = (await Db.Guilds.AsNoTracking().FirstOrDefaultAsync(g => g.Id == GuildId))?.Settings ?? new GuildSettings();
        Tier.S ??= settings.TierSPoints;
        Tier.A ??= settings.TierAPoints;
        Tier.B ??= settings.TierBPoints;
        Tier.C ??= settings.TierCPoints;
        Tier.D ??= settings.TierDPoints;
        Tier.E ??= settings.TierEPoints;

        // Prefill on GET / other-form posts; the hidden sentinel marks this form's own postback so we keep its values.
        if (string.IsNullOrEmpty(Approval.Submitted))
        {
            Approval.IntakeApproval = settings.PersonalQuestIntakeApproval;
            Approval.FinalMode = settings.FinalApprovalMode;
        }

        if (string.IsNullOrEmpty(Auto.Submitted))
        {
            Auto.IntakeHours = settings.IntakeTimeoutHours;
            Auto.IntakeAction = settings.IntakeTimeoutAction;
            Auto.ClaimHours = settings.ClaimTimeoutHours;
            Auto.SubmissionHours = settings.SubmissionTimeoutHours;
            Auto.SubmissionAction = settings.SubmissionTimeoutAction;
            Auto.FinalHours = settings.FinalApprovalTimeoutHours;
            Auto.FinalAction = settings.FinalApprovalTimeoutAction;
            Auto.MaxOpenPerPoster = settings.MaxOpenQuestsPerPoster;
            Auto.MaxActiveClaims = settings.MaxActiveClaimsPerUser;
            Auto.MaxRevisions = settings.MaxRevisions;
        }
    }

    private async Task SaveAutomationAsync()
    {
        var result = await Config.SetQuestAutomationAsync(
            GuildId, Auto.IntakeHours, Auto.IntakeAction, Auto.ClaimHours,
            Auto.SubmissionHours, Auto.SubmissionAction, Auto.FinalHours, Auto.FinalAction,
            Auto.MaxOpenPerPoster, Auto.MaxActiveClaims, Auto.MaxRevisions);
        if (!result.IsError)
        {
            await AuditAsync("config.questAutomation", result.Message);
        }

        Message = result.Message;
        await LoadAsync();
    }

    private async Task SaveApprovalAsync()
    {
        var result = await Config.SetQuestApprovalAsync(GuildId, Approval.IntakeApproval, Approval.FinalMode);
        if (!result.IsError)
        {
            await AuditAsync("config.questApproval", result.Message);
        }

        Message = result.Message;
        await LoadAsync();
    }

    private async Task SaveTiersAsync()
    {
        var result = await Config.SetQuestTierPointsAsync(
            GuildId, Tier.S ?? 0, Tier.A ?? 0, Tier.B ?? 0, Tier.C ?? 0, Tier.D ?? 0, Tier.E ?? 0);
        if (!result.IsError)
        {
            await AuditAsync("config.questTierPoints", result.Message);
        }

        Message = result.Message;
        await LoadAsync();
    }

    private async Task SubmitAsync()
    {
        if (Input.RoleId == 0)
        {
            Message = "Please choose a role.";
            return;
        }

        var result = Input.Kind switch
        {
            "officer" => await Config.ToggleOfficerRoleAsync(GuildId, Input.RoleId),
            "participant" => await Config.ToggleParticipantRoleAsync(GuildId, Input.RoleId),
            "questmanager" => await Config.ToggleQuestManagerRoleAsync(GuildId, Input.RoleId),
            _ => await Config.ToggleAdminRoleAsync(GuildId, Input.RoleId),
        };

        if (!result.IsError)
        {
            await AuditAsync($"config.{Input.Kind}Role", result.Message);
        }

        Message = await HumanizeAsync(result.Message);
        Input = new ToggleInput();
        await LoadAsync();
    }

    private string RoleNames(IReadOnlyList<ulong>? ids)
    {
        if (_mapping is null || ids is null || ids.Count == 0)
        {
            return "none";
        }

        var names = ids.Select(id => _mapping.AllRoles.FirstOrDefault(r => r.RoleId == id)?.Name ?? id.ToString());
        return string.Join(", ", names);
    }

    public class ToggleInput
    {
        public ulong RoleId { get; set; }
        public string Kind { get; set; } = "admin";
    }

    public class TierInput
    {
        public long? S { get; set; }
        public long? A { get; set; }
        public long? B { get; set; }
        public long? C { get; set; }
        public long? D { get; set; }
        public long? E { get; set; }
    }

    public class ApprovalInput
    {
        public string? Submitted { get; set; }
        public bool IntakeApproval { get; set; }
        public FinalApprovalMode FinalMode { get; set; }
    }

    public class AutomationInput
    {
        public string? Submitted { get; set; }
        public int IntakeHours { get; set; }
        public StaleIntakeAction IntakeAction { get; set; }
        public int ClaimHours { get; set; }
        public int SubmissionHours { get; set; }
        public StaleSubmissionAction SubmissionAction { get; set; }
        public int FinalHours { get; set; }
        public StaleFinalAction FinalAction { get; set; }
        public int MaxOpenPerPoster { get; set; }
        public int MaxActiveClaims { get; set; }
        public int MaxRevisions { get; set; }
    }
}
