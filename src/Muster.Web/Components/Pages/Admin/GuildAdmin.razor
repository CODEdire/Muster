@page "/guilds/{GuildIdRaw}/admin"
@layout GuildLayout
@inherits GuildAdminComponentBase

<PageTitle>Admin — Muster</PageTitle>

@if (State == AccessState.NeedLogin)
{
    <div class="panel glass empty">Please <a href="/account/login">log in</a>.</div>
}
else if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need staff or admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId">← Dashboard</a>
        <h1>Admin</h1>
        <p class="subtitle">Manage rewards, quests, seasons, and access.</p>
    </div>

    <div class="card-grid">
        <a class="card glass" href="/guilds/@GuildId/quest-settings">
            <h3>Quest settings</h3>
            <p>Board channels, approval workflow, auto-resolve timeouts &amp; limits, and tier bonus points.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/seasons">
            <h3>Seasons</h3>
            <p>Start a new season or end the current one.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/management/tracking">
            <h3>Tracking</h3>
            <p>Monitored channels, background &amp; session reward rates, anti-AFK guards, and privacy defaults.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/management/musters">
            <h3>Muster settings</h3>
            <p>Check-in card channel, terminal-card retention, and auto-creating a muster when a session opens.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/management/shop">
            <h3>Shop settings</h3>
            <p>Marketplace rules, limits, commission, board channels, and listing categories.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/config">
            <h3>Role mapping</h3>
            <p>Choose which Discord roles grant admin, staff, or participant access.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/currencies">
            <h3>Currencies</h3>
            <p>Create and configure currencies like a spendable COIN.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/multipliers">
            <h3>Reward windows</h3>
            <p>Time/role-based reward multipliers (×) applied across tracking, quests, and other earning. Stacking &amp; cap live in Tracking settings.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/api-clients">
            <h3>API clients</h3>
            <p>Issue keys for external systems to call the Muster API.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/webhooks">
            <h3>Webhooks</h3>
            <p>POST every currency movement to your own endpoint, HMAC-signed, to mirror the economy out.</p>
        </a>
    </div>
}

@code {
    // Any staff tier may reach the admin landing; per-page gates enforce the specific level.
    protected override GuildAccessTier RequiredAccess => GuildAccessTier.AnyStaff;
}
