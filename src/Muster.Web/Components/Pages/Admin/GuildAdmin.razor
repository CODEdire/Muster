@page "/guilds/{GuildIdRaw}/admin"
@inherits GuildAdminComponentBase

<PageTitle>Admin — Muster</PageTitle>

@if (State == AccessState.NeedLogin)
{
    <div class="panel glass empty">Please <a href="/account/login">log in</a>.</div>
}
else if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You need officer or admin access for this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId">← Dashboard</a>
        <h1>Admin</h1>
        <p class="subtitle">Manage rewards, quests, seasons, and access.</p>
    </div>

    <div class="card-grid">
        <a class="card glass" href="/guilds/@GuildId/award">
            <h3>Award / adjust</h3>
            <p>Mint a currency to a member, or correct a balance (negative deducts).</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/quest-settings">
            <h3>Quest settings</h3>
            <p>Board channels, approval workflow, auto-resolve timeouts &amp; limits, and tier bonus points.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/seasons">
            <h3>Seasons</h3>
            <p>Start a new season or end the current one.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/config">
            <h3>Role mapping</h3>
            <p>Choose which Discord roles grant admin, officer, or participant access.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/currencies">
            <h3>Currencies</h3>
            <p>Create and configure currencies like a spendable COIN.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/currency-overview">
            <h3>Currency overview</h3>
            <p>Supply, circulation, top holders, and the recent movement feed for any currency.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/members">
            <h3>Members</h3>
            <p>Browse balances, view any member's wallet, and bulk mint/adjust by selection or role.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/api-clients">
            <h3>API clients</h3>
            <p>Issue keys for external systems to call the Muster API.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/webhooks">
            <h3>Webhooks</h3>
            <p>POST every currency movement to your own endpoint, HMAC-signed, to mirror the economy out.</p>
        </a>
        <a class="card glass" href="/guilds/@GuildId/audit">
            <h3>Audit log</h3>
            <p>Search, filter, and export every admin action.</p>
        </a>
    </div>
}

@code {
    // Officer is enough to reach the admin hub; individual pages enforce their own level.
    protected override bool OfficerSufficient => true;
}
