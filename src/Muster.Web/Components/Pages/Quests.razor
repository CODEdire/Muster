@page "/guilds/{GuildIdRaw}/quests"
@inherits GuildMemberComponentBase
@inject QuestBoardService Board
@inject TimeZoneService TimeZones
@inject AuditService Audit
@inject MusterDbContext Db
@using Muster.Domain.Entities
@using Muster.Infrastructure.Persistence
@using Muster.Domain.Enums
@using Muster.Infrastructure.Commands
@using Muster.Infrastructure.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>Quest board — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId">← Dashboard</a>
        <h1>Quest board</h1>
        <p class="subtitle">Guild quests mint their reward on approval; personal quests escrow the poster's own balance until a member completes them.</p>
        <div class="actions">
            <a class="btn" href="/guilds/@GuildId/quests/new">Post a quest</a>
        </div>
    </div>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <div class="panel glass">
        <div class="filter-bar quest-tabs">
            <a href="@TabUrl("active")" class="@(CurrentTab == "active" ? "active" : "")">Active</a>
            <a href="@TabUrl("mine")" class="@(CurrentTab == "mine" ? "active" : "")">Mine</a>
            <a href="@TabUrl("history")" class="@(CurrentTab == "history" ? "active" : "")">History</a>
        </div>
        <form method="get" class="filter-bar">
            <input type="search" name="search" value="@Search" placeholder="Search name or details" />
            <select name="type">
                <option value="" selected="@string.IsNullOrEmpty(CurrentType)">All types</option>
                <option value="guild" selected="@(CurrentType == "guild")">Guild</option>
                <option value="personal" selected="@(CurrentType == "personal")">Personal</option>
            </select>
            <select name="size">
                @foreach (var s in PageSizes)
                {
                    <option value="@s" selected="@(s == CurrentSize)">@s / page</option>
                }
            </select>
            <input type="hidden" name="tab" value="@CurrentTab" />
            <input type="hidden" name="sort" value="@CurrentSort" />
            <input type="hidden" name="desc" value="@CurrentDesc.ToString().ToLowerInvariant()" />
            <button type="submit">Filter</button>
        </form>
    </div>

    <div class="panel glass">
        @if (_quests.Count == 0)
        {
            <p class="empty">No quests here.</p>
        }
        else
        {
            <table class="leaderboard quest-grid">
                <thead>
                    <tr>
                        <th><a href="@SortUrl("name")">Quest @Indicator("name")</a></th>
                        <th><a href="@SortUrl("type")">Type @Indicator("type")</a></th>
                        <th><a href="@SortUrl("reward")">Reward @Indicator("reward")</a></th>
                        <th><a href="@SortUrl("status")">Status @Indicator("status")</a></th>
                        <th><a href="@SortUrl("opens")">Opens @Indicator("opens")</a></th>
                        <th><a href="@SortUrl("closes")">Closes @Indicator("closes")</a></th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in _quests)
                    {
                        var actions = ActionsFor(q).ToList();
                        <tr>
                            <td data-label="Quest">
                                @q.Name<br /><span class="subtitle">@q.Description</span>
                                @{
                                    var sub = q.Participants.FirstOrDefault(p => p.Status == MissionParticipantStatus.Submitted);
                                    var rev = q.Participants.FirstOrDefault(p => p.Status == MissionParticipantStatus.RevisionRequested);
                                }
                                @if (sub?.Note is { Length: > 0 } sn)
                                {
                                    <br /><span class="subtitle">Note: @sn</span>
                                }
                                @if (rev?.ReviewNote is { Length: > 0 } rn)
                                {
                                    <br /><span class="subtitle">Revision requested: @rn</span>
                                }
                            </td>
                            <td data-label="Type">@(q.Origin == MissionOrigin.Guild ? "Guild" : "Personal")@(q.IsRepeatable ? " · repeatable" : "")</td>
                            <td data-label="Reward">@q.RewardAmount @_codes.GetValueOrDefault(q.RewardCurrencyId, "?")@(q.Tier != QuestTier.None ? $" · {q.Tier} ({q.BonusPoints} pts)" : "")</td>
                            <td data-label="Status"><span class="badge status-@StatusClass(q)">@StatusLabel(q)</span></td>
                            <td data-label="Opens">@Local(q.ScheduledStart)</td>
                            <td data-label="Closes">@Local(q.Deadline)</td>
                            <td data-label="Actions">
                                @if (actions.Count > 0)
                                {
                                    <EditForm class="row-actions" Model="this" FormName="@($"quest-{q.Id}")" OnValidSubmit="ActAsync">
                                        <input type="hidden" name="QuestId" value="@q.Id" />
                                        @if (Noteable(actions))
                                        {
                                            <input name="Note" class="note-input" placeholder="note (optional)" />
                                        }
                                        @foreach (var a in actions)
                                        {
                                            <button type="submit" name="Action" value="@a.Value" class="btn btn-sm @(a.Primary ? "" : "btn-ghost")">@a.Label</button>
                                        }
                                    </EditForm>
                                }
                                @if (CanIntake(q))
                                {
                                    <EditForm class="row-actions" Model="this" FormName="@($"intake-{q.Id}")" OnValidSubmit="ActAsync">
                                        <input type="hidden" name="QuestId" value="@q.Id" />
                                        <select name="Tier" class="tier-select">
                                            <option value="@QuestTier.None">No tier (0 pts)</option>
                                            @foreach (var t in _tiers)
                                            {
                                                <option value="@t">@t (@_settings.PointsForTier(t) pts)</option>
                                            }
                                        </select>
                                        @if (_settings.FinalApprovalMode == FinalApprovalMode.ApproverChoice)
                                        {
                                            <label class="checkbox"><input type="checkbox" name="RequireFinal" value="true" /> final sign-off</label>
                                        }
                                        <button type="submit" name="Action" value="accept" class="btn btn-sm">Accept &amp; open</button>
                                        <button type="submit" name="Action" value="reject-intake" class="btn btn-sm btn-ghost">Reject</button>
                                    </EditForm>
                                }
                                @if (CanFinalize(q))
                                {
                                    <EditForm class="row-actions" Model="this" FormName="@($"finalize-{q.Id}")" OnValidSubmit="ActAsync">
                                        <input type="hidden" name="QuestId" value="@q.Id" />
                                        <button type="submit" name="Action" value="finalize-pay" class="btn btn-sm">Pay completer</button>
                                        <button type="submit" name="Action" value="finalize-refund" class="btn btn-sm btn-ghost">Refund owner</button>
                                    </EditForm>
                                }
                                @if (CanEdit(q))
                                {
                                    <a class="btn btn-sm btn-ghost" href="/guilds/@GuildId/quests/@q.Id/edit">Edit</a>
                                }
                                @if (actions.Count == 0 && !CanIntake(q) && !CanFinalize(q) && !CanEdit(q))
                                {
                                    <span class="subtitle">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="pager">
                @if (_page > 1)
                {
                    <a class="btn btn-ghost" href="@PageUrl(_page - 1)">← Prev</a>
                }
                <span>Page @_page of @Math.Max(_totalPages, 1) · @_total quests</span>
                @if (_page < _totalPages)
                {
                    <a class="btn btn-ghost" href="@PageUrl(_page + 1)">Next →</a>
                }
            </div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] private string? Tab { get; set; }
    [SupplyParameterFromQuery] private string? Search { get; set; }
    [SupplyParameterFromQuery] private string? Type { get; set; }
    [SupplyParameterFromQuery] private string? Sort { get; set; }
    [SupplyParameterFromQuery] private bool Desc { get; set; }
    [SupplyParameterFromQuery] private int Page { get; set; }
    [SupplyParameterFromQuery] private int Size { get; set; }

    private static readonly int[] PageSizes = [10, 25, 50, 100];

    private IReadOnlyList<Mission> _quests = [];
    private Dictionary<Guid, string> _codes = [];
    private Dictionary<ulong, string> _names = [];
    private bool _isManager;
    private string _zoneId = TimeZoneService.Utc;
    private GuildSettings _settings = new();
    private int _total;
    private int _totalPages;
    private int _page = 1;

    private static readonly QuestTier[] _tiers = [QuestTier.E, QuestTier.D, QuestTier.C, QuestTier.B, QuestTier.A, QuestTier.S];

    /// <summary>Managers vet + tier a pending personal quest at intake.</summary>
    private bool CanIntake(Mission q) =>
        _isManager && q.Origin == MissionOrigin.Player && q.Status == MissionStatus.PendingApproval;

    /// <summary>Managers give the final sign-off on a personal quest awaiting it.</summary>
    private bool CanFinalize(Mission q) =>
        _isManager && q.Origin == MissionOrigin.Player && q.Status == MissionStatus.PendingFinal;

    /// <summary>Editable only before anyone is working on it: owner (personal) or manager (guild).</summary>
    private bool CanEdit(Mission q) =>
        q.Status is MissionStatus.Open or MissionStatus.Scheduled or MissionStatus.PendingApproval
        && !q.Participants.Any(p => p.Status is MissionParticipantStatus.Claimed or MissionParticipantStatus.Submitted
            or MissionParticipantStatus.RevisionRequested or MissionParticipantStatus.Approved)
        && (q.Origin == MissionOrigin.Guild ? _isManager : q.OwnerId == UserId);

    /// <summary>Whether any available action benefits from an optional note (submit/revise/reject).</summary>
    private static bool Noteable(IReadOnlyList<QuestAction> actions) =>
        actions.Any(a => a.Value is "submit" or "revise"
            || a.Value.StartsWith("revise:", StringComparison.Ordinal)
            || a.Value.StartsWith("reject:", StringComparison.Ordinal));

    private string CurrentTab => Tab is "mine" or "history" ? Tab : "active";
    private string CurrentType => Type is "guild" or "personal" ? Type : "";
    private string CurrentSort => string.IsNullOrEmpty(Sort) ? "created" : Sort;
    private bool CurrentDesc => string.IsNullOrEmpty(Sort) ? true : Desc;
    private int CurrentSize => PageSizes.Contains(Size) ? Size : 25;

    protected override async Task LoadAsync()
    {
        _isManager = await Auth.IsQuestManagerAsync(GuildId, UserId);
        _zoneId = await TimeZones.ResolveZoneIdAsync(GuildId, UserId);
        _settings = (await Db.Guilds.AsNoTracking().FirstOrDefaultAsync(g => g.Id == GuildId))?.Settings ?? new GuildSettings();
        _codes = await Db.Currencies.Where(c => c.GuildId == GuildId).ToDictionaryAsync(c => c.Id, c => c.Code);

        var query = Db.Missions.Include(m => m.Participants)
            .Where(m => m.GuildId == GuildId && m.Type == MissionType.Quest);

        query = CurrentTab switch
        {
            "history" => _isManager
                ? query.Where(m => m.Status == MissionStatus.Closed || m.Status == MissionStatus.Cancelled || m.Status == MissionStatus.Expired)
                : query.Where(m => (m.Status == MissionStatus.Closed || m.Status == MissionStatus.Cancelled || m.Status == MissionStatus.Expired)
                    && (m.OwnerId == UserId || m.Participants.Any(p => p.UserId == UserId))),
            "mine" => query.Where(m => m.OwnerId == UserId || m.Participants.Any(p => p.UserId == UserId)),
            _ => _isManager
                ? query.Where(m => m.Status == MissionStatus.Open || m.Status == MissionStatus.Scheduled || m.Status == MissionStatus.Disputed
                    || m.Status == MissionStatus.PendingApproval || m.Status == MissionStatus.PendingFinal)
                : query.Where(m => m.Status == MissionStatus.Open || m.Status == MissionStatus.Scheduled || m.Status == MissionStatus.Disputed),
        };

        if (CurrentType == "guild")
        {
            query = query.Where(m => m.Origin == MissionOrigin.Guild);
        }
        else if (CurrentType == "personal")
        {
            query = query.Where(m => m.Origin == MissionOrigin.Player);
        }

        if (!string.IsNullOrWhiteSpace(Search))
        {
            var s = Search.Trim();
            query = query.Where(m => m.Name.Contains(s) || m.Description.Contains(s));
        }

        _total = await query.CountAsync();
        _totalPages = Math.Max(1, (int)Math.Ceiling(_total / (double)CurrentSize));
        _page = Math.Clamp(Page <= 0 ? 1 : Page, 1, _totalPages);

        _quests = await Sorted(query).Skip((_page - 1) * CurrentSize).Take(CurrentSize).ToListAsync();

        var ids = _quests.SelectMany(m => m.Participants.Select(p => p.UserId)).Distinct().ToList();
        _names = await Db.Users.Where(u => ids.Contains(u.Id))
            .ToDictionaryAsync(u => u.Id, u => u.GlobalName ?? u.Username);
    }

    private IQueryable<Mission> Sorted(IQueryable<Mission> q)
    {
        var d = CurrentDesc;
        return CurrentSort switch
        {
            "name" => d ? q.OrderByDescending(m => m.Name) : q.OrderBy(m => m.Name),
            "type" => d ? q.OrderByDescending(m => m.Origin) : q.OrderBy(m => m.Origin),
            "reward" => d ? q.OrderByDescending(m => m.RewardAmount) : q.OrderBy(m => m.RewardAmount),
            "status" => d ? q.OrderByDescending(m => m.Status) : q.OrderBy(m => m.Status),
            "opens" => d ? q.OrderByDescending(m => m.ScheduledStart) : q.OrderBy(m => m.ScheduledStart),
            "closes" => d ? q.OrderByDescending(m => m.Deadline) : q.OrderBy(m => m.Deadline),
            _ => d ? q.OrderByDescending(m => m.CreatedAt) : q.OrderBy(m => m.CreatedAt),
        };
    }

    private async Task ActAsync()
    {
        var form = Http?.Request.Form;
        var id = form?["QuestId"].ToString() ?? "";
        var action = form?["Action"].ToString() ?? "";
        if (string.IsNullOrEmpty(id) || string.IsNullOrEmpty(action))
        {
            return;
        }

        var note = form?["Note"].ToString() is { Length: > 0 } n ? n.Trim() : null;

        CommandResult result;
        if (action.StartsWith("approve:") && ulong.TryParse(action[8..], out var approveId))
        {
            result = await Board.ApproveAsync(GuildId, id, approveId, UserId);
        }
        else if (action.StartsWith("reject:") && ulong.TryParse(action[7..], out var rejectId))
        {
            result = await Board.RejectAsync(GuildId, id, rejectId, UserId);
        }
        else if (action.StartsWith("revise:") && ulong.TryParse(action[7..], out var reviseId))
        {
            result = await Board.RequestRevisionAsync(GuildId, id, UserId, reviseId, note);
        }
        else if (action == "accept")
        {
            _ = Enum.TryParse<QuestTier>(form?["Tier"].ToString(), out var tier);
            var requireFinal = form?["RequireFinal"].ToString() == "true";
            result = await Board.AcceptIntakeAsync(GuildId, id, tier, requireFinal, UserId);
        }
        else
        {
            result = action switch
            {
                "submit" => await Board.SubmitAsync(GuildId, id, UserId, note),
                "confirm" => await Board.ConfirmAsync(GuildId, id, UserId),
                "cancel" => await Board.CancelAsync(GuildId, id, UserId),
                "dispute" => await Board.DisputeAsync(GuildId, id, UserId),
                "revise" => await Board.RequestRevisionAsync(GuildId, id, UserId, null, note),
                "reject-intake" => await Board.RejectIntakeAsync(GuildId, id, UserId),
                "finalize-pay" => await Board.FinalizeAsync(GuildId, id, true, UserId),
                "finalize-refund" => await Board.FinalizeAsync(GuildId, id, false, UserId),
                "resolve-pay" => await Board.ArbitrateAsync(GuildId, id, true),
                "resolve-refund" => await Board.ArbitrateAsync(GuildId, id, false),
                _ => await Board.ClaimAsync(GuildId, id, UserId),
            };
        }

        Message = result.Message;
        if (!result.IsError)
        {
            await Audit.RecordAsync(GuildId, UserId, $"quest.{action.Split(':')[0]}", id);
        }

        await LoadAsync();
    }

    /// <summary>The actions this viewer may take on a quest, given its state and their role.</summary>
    private IEnumerable<QuestAction> ActionsFor(Mission q)
    {
        var myPart = q.Participants.FirstOrDefault(p => p.UserId == UserId);
        var iAmOwner = q.OwnerId == UserId;
        var submitters = q.Participants.Where(p => p.Status == MissionParticipantStatus.Submitted).ToList();
        var isPersonal = q.Origin == MissionOrigin.Player;

        if (q.Status == MissionStatus.Open)
        {
            if (!iAmOwner && myPart is null)
            {
                yield return new("claim", "Claim", true);
            }

            if (myPart?.Status == MissionParticipantStatus.Claimed)
            {
                yield return new("submit", "Submit", true);
            }

            if (submitters.Count > 0 && isPersonal && iAmOwner)
            {
                yield return new("confirm", "Confirm & pay", true);
                yield return new("revise", "Request revision", false);
                yield return new("dispute", "Dispute", false);
            }
            else if (submitters.Count > 0 && !isPersonal && _isManager)
            {
                foreach (var s in submitters)
                {
                    yield return new($"approve:{s.UserId}", $"Approve {Name(s.UserId)}", true);
                    yield return new($"revise:{s.UserId}", $"Revise {Name(s.UserId)}", false);
                    yield return new($"reject:{s.UserId}", $"Reject {Name(s.UserId)}", false);
                }
            }
        }

        if (q.Status is MissionStatus.Open or MissionStatus.Scheduled or MissionStatus.PendingApproval && submitters.Count == 0
            && ((isPersonal && iAmOwner) || (!isPersonal && _isManager)))
        {
            yield return new("cancel", "Cancel", false);
        }

        if (q.Status == MissionStatus.Disputed && isPersonal && _isManager)
        {
            yield return new("resolve-pay", "Pay completer", true);
            yield return new("resolve-refund", "Refund owner", false);
        }
    }

    private string Name(ulong userId) => _names.GetValueOrDefault(userId, $"member {userId}");

    private string QPath => $"/guilds/{GuildId}/quests";

    private string BuildQuery(string tab, string sort, bool desc, int page)
    {
        var parts = new List<string> { $"tab={tab}" };
        if (!string.IsNullOrEmpty(Search)) parts.Add($"search={Uri.EscapeDataString(Search)}");
        if (!string.IsNullOrEmpty(CurrentType)) parts.Add($"type={CurrentType}");
        parts.Add($"sort={sort}");
        parts.Add($"desc={desc.ToString().ToLowerInvariant()}");
        parts.Add($"page={page}");
        parts.Add($"size={CurrentSize}");
        return string.Join("&", parts);
    }

    private string TabUrl(string tab) => $"{QPath}?{BuildQuery(tab, CurrentSort, CurrentDesc, 1)}";

    private string SortUrl(string column)
    {
        var desc = CurrentSort == column ? !CurrentDesc : false;
        return $"{QPath}?{BuildQuery(CurrentTab, column, desc, 1)}";
    }

    private string PageUrl(int page) => $"{QPath}?{BuildQuery(CurrentTab, CurrentSort, CurrentDesc, page)}";

    private string Indicator(string column) => CurrentSort == column ? (CurrentDesc ? "▼" : "▲") : "";

    private static string StatusClass(Mission q) => q.Status switch
    {
        MissionStatus.Open => "open",
        MissionStatus.Scheduled => "scheduled",
        MissionStatus.Disputed => "disputed",
        MissionStatus.PendingApproval => "scheduled",
        MissionStatus.PendingFinal => "disputed",
        MissionStatus.Closed => "closed",
        MissionStatus.Cancelled => "cancelled",
        MissionStatus.Expired => "expired",
        _ => "open",
    };

    private string StatusLabel(Mission q) => q.Status switch
    {
        MissionStatus.Scheduled => "Scheduled",
        MissionStatus.Disputed => "Disputed",
        MissionStatus.PendingApproval => "Pending approval",
        MissionStatus.PendingFinal => "Awaiting sign-off",
        MissionStatus.Open when q.Participants.Any(p => p.Status is MissionParticipantStatus.Claimed or MissionParticipantStatus.Submitted) => "In progress",
        MissionStatus.Open => "Open",
        MissionStatus.Closed => "Completed",
        MissionStatus.Cancelled => "Cancelled",
        MissionStatus.Expired => "Expired",
        _ => q.Status.ToString(),
    };

    private string Local(DateTimeOffset? utc)
    {
        if (utc is not { } t)
        {
            return "—";
        }

        if (!TimeZoneService.IsValidZone(_zoneId))
        {
            return t.UtcDateTime.ToString("yyyy-MM-dd HH:mm");
        }

        var zone = TimeZoneInfo.FindSystemTimeZoneById(_zoneId);
        return TimeZoneInfo.ConvertTime(t, zone).ToString("yyyy-MM-dd HH:mm");
    }

    private sealed record QuestAction(string Value, string Label, bool Primary);
}
