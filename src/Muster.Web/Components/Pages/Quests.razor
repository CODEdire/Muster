@page "/guilds/{GuildIdRaw}/quests"
@inherits GuildMemberComponentBase
@inject QuestBoardService Board
@inject TimeZoneService TimeZones
@inject CurrencyAdminService CurrencyAdmin
@inject MusterDbContext Db
@using Muster.Domain.Entities
@using Muster.Domain.Enums
@using Muster.Infrastructure.Commands
@using Microsoft.EntityFrameworkCore

<PageTitle>Quest board — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId">← Dashboard</a>
        <h1>Quest board</h1>
        <p class="subtitle">Guild quests mint their reward on approval; personal quests escrow the poster's own balance until a member completes them.</p>
    </div>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <div class="filter-bar quest-tabs">
        <a href="?tab=active" class="@(CurrentTab == "active" ? "active" : "")">Active</a>
        <a href="?tab=mine" class="@(CurrentTab == "mine" ? "active" : "")">Mine</a>
        <a href="?tab=history" class="@(CurrentTab == "history" ? "active" : "")">History</a>
    </div>

    <div class="panel glass">
        @if (_quests.Count == 0)
        {
            <p class="empty">No quests here.</p>
        }
        else
        {
            <table class="leaderboard quest-grid">
                <thead>
                    <tr><th>Quest</th><th>Type</th><th>Reward</th><th>Status</th><th>Opens</th><th>Closes</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var q in _quests)
                    {
                        var actions = ActionsFor(q).ToList();
                        <tr>
                            <td data-label="Quest">@q.Name<br /><span class="subtitle">@q.Description</span></td>
                            <td data-label="Type">@(q.Origin == MissionOrigin.Guild ? "Guild" : "Personal")</td>
                            <td data-label="Reward">@q.RewardAmount @_codes.GetValueOrDefault(q.RewardCurrencyId, "?")</td>
                            <td data-label="Status"><span class="badge status-@StatusClass(q)">@StatusLabel(q)</span></td>
                            <td data-label="Opens">@Local(q.ScheduledStart)</td>
                            <td data-label="Closes">@Local(q.Deadline)</td>
                            <td data-label="Actions">
                                @if (actions.Count == 0)
                                {
                                    <span class="subtitle">—</span>
                                }
                                else
                                {
                                    <EditForm class="row-actions" Model="this" FormName="@($"quest-{q.Id}")" OnValidSubmit="ActAsync">
                                        <input type="hidden" name="QuestId" value="@q.Id" />
                                        @foreach (var a in actions)
                                        {
                                            <button type="submit" name="Action" value="@a.Value" class="btn btn-sm @(a.Primary ? "" : "btn-ghost")">@a.Label</button>
                                        }
                                    </EditForm>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="panel glass">
        <h2>Post a quest</h2>
        <EditForm class="form-grid" Model="Post" FormName="post-quest" OnValidSubmit="PostAsync">
            <label>Type
                <InputSelect @bind-Value="Post.Kind">
                    <option value="personal">Personal quest — escrow my own balance</option>
                    @if (_isManager)
                    {
                        <option value="guild">Guild quest — minted reward (no balance needed)</option>
                    }
                </InputSelect>
            </label>
            <label>Name <InputText @bind-Value="Post.Name" /></label>
            <label>Details <InputText @bind-Value="Post.Details" /></label>
            <label>Reward amount <InputNumber @bind-Value="Post.Amount" /></label>
            <label>Currency
                <InputSelect @bind-Value="Post.Currency">
                    @foreach (var c in _currencies)
                    {
                        <option value="@c.Code">@c.Code — @c.Name</option>
                    }
                </InputSelect>
            </label>
            <label>Starts (optional) <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="Post.StartsAt" /></label>
            <label>Expires (optional) <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="Post.ExpiresAt" /></label>
            <div class="btn-row"><button type="submit">Post</button></div>
        </EditForm>
        <p class="subtitle">Start/expiry are read in your time zone (<strong>@_zoneId</strong>). A future start keeps the quest scheduled until then.</p>
    </div>
}

@code {
    [SupplyParameterFromForm(FormName = "post-quest")] private PostInput Post { get; set; } = new();
    [SupplyParameterFromQuery] private string? Tab { get; set; }

    private IReadOnlyList<Mission> _quests = [];
    private Dictionary<Guid, string> _codes = [];
    private Dictionary<ulong, string> _names = [];
    private IReadOnlyList<CurrencyView> _currencies = [];
    private bool _isManager;
    private string _zoneId = TimeZoneService.Utc;

    private string CurrentTab => Tab is "mine" or "history" ? Tab : "active";

    protected override async Task LoadAsync()
    {
        _isManager = await Auth.IsQuestManagerAsync(GuildId, UserId);
        _zoneId = await TimeZones.ResolveZoneIdAsync(GuildId, UserId);
        _codes = await Db.Currencies.Where(c => c.GuildId == GuildId).ToDictionaryAsync(c => c.Id, c => c.Code);
        _currencies = await CurrencyAdmin.ListAsync(GuildId);

        var query = Db.Missions.Include(m => m.Participants)
            .Where(m => m.GuildId == GuildId && m.Type == MissionType.Quest);

        query = CurrentTab switch
        {
            "history" => _isManager
                ? query.Where(m => m.Status == MissionStatus.Closed || m.Status == MissionStatus.Cancelled || m.Status == MissionStatus.Expired)
                : query.Where(m => (m.Status == MissionStatus.Closed || m.Status == MissionStatus.Cancelled || m.Status == MissionStatus.Expired)
                    && (m.OwnerId == UserId || m.Participants.Any(p => p.UserId == UserId))),
            "mine" => query.Where(m => m.OwnerId == UserId || m.Participants.Any(p => p.UserId == UserId)),
            _ => query.Where(m => m.Status == MissionStatus.Open || m.Status == MissionStatus.Scheduled || m.Status == MissionStatus.Disputed),
        };

        _quests = await query.OrderBy(m => m.ScheduledStart ?? m.CreatedAt).ToListAsync();

        var ids = _quests.SelectMany(m => m.Participants.Select(p => p.UserId)).Distinct().ToList();
        _names = await Db.Users.Where(u => ids.Contains(u.Id))
            .ToDictionaryAsync(u => u.Id, u => u.GlobalName ?? u.Username);
    }

    private async Task ActAsync()
    {
        var form = Http?.Request.Form;
        var id = form?["QuestId"].ToString() ?? "";
        var action = form?["Action"].ToString() ?? "";
        if (string.IsNullOrEmpty(id) || string.IsNullOrEmpty(action))
        {
            return;
        }

        CommandResult result;
        if (action.StartsWith("approve:") && ulong.TryParse(action[8..], out var approveId))
        {
            result = await Board.ApproveAsync(GuildId, id, approveId, UserId);
        }
        else if (action.StartsWith("reject:") && ulong.TryParse(action[7..], out var rejectId))
        {
            result = await Board.RejectAsync(GuildId, id, rejectId, UserId);
        }
        else
        {
            result = action switch
            {
                "submit" => await Board.SubmitAsync(GuildId, id, UserId),
                "confirm" => await Board.ConfirmAsync(GuildId, id, UserId),
                "cancel" => await Board.CancelAsync(GuildId, id, UserId),
                "dispute" => await Board.DisputeAsync(GuildId, id, UserId),
                "resolve-pay" => await Board.ArbitrateAsync(GuildId, id, true),
                "resolve-refund" => await Board.ArbitrateAsync(GuildId, id, false),
                _ => await Board.ClaimAsync(GuildId, id, UserId),
            };
        }

        Message = result.Message;
        await LoadAsync();
    }

    private async Task PostAsync()
    {
        var currency = Post.Currency ?? "POINTS";
        var kind = Post.Kind == "guild" ? QuestKind.Guild : QuestKind.Personal;
        var startsAt = await TimeZones.LocalToUtcAsync(GuildId, UserId, Post.StartsAt);
        var deadline = await TimeZones.LocalToUtcAsync(GuildId, UserId, Post.ExpiresAt);

        Message = (await Board.PostAsync(GuildId, UserId, kind, Post.Name ?? "", currency, Post.Amount, Post.Details ?? "", startsAt, deadline)).Message;
        Post = new PostInput();
        await LoadAsync();
    }

    /// <summary>The actions this viewer may take on a quest, given its state and their role.</summary>
    private IEnumerable<QuestAction> ActionsFor(Mission q)
    {
        var myPart = q.Participants.FirstOrDefault(p => p.UserId == UserId);
        var iAmOwner = q.OwnerId == UserId;
        var submitters = q.Participants.Where(p => p.Status == MissionParticipantStatus.Submitted).ToList();
        var isPersonal = q.Origin == MissionOrigin.Player;

        if (q.Status == MissionStatus.Open)
        {
            if (!iAmOwner && myPart is null)
            {
                yield return new("claim", "Claim", true);
            }

            if (myPart?.Status == MissionParticipantStatus.Claimed)
            {
                yield return new("submit", "Submit", true);
            }

            if (submitters.Count > 0 && isPersonal && iAmOwner)
            {
                yield return new("confirm", "Confirm & pay", true);
                yield return new("dispute", "Dispute", false);
            }
            else if (submitters.Count > 0 && !isPersonal && _isManager)
            {
                foreach (var s in submitters)
                {
                    yield return new($"approve:{s.UserId}", $"Approve {Name(s.UserId)}", true);
                    yield return new($"reject:{s.UserId}", $"Reject {Name(s.UserId)}", false);
                }
            }
        }

        if (q.Status is MissionStatus.Open or MissionStatus.Scheduled && submitters.Count == 0
            && ((isPersonal && iAmOwner) || (!isPersonal && _isManager)))
        {
            yield return new("cancel", "Cancel", false);
        }

        if (q.Status == MissionStatus.Disputed && isPersonal && _isManager)
        {
            yield return new("resolve-pay", "Pay completer", true);
            yield return new("resolve-refund", "Refund owner", false);
        }
    }

    private string Name(ulong userId) => _names.GetValueOrDefault(userId, $"member {userId}");

    private static string StatusClass(Mission q) => q.Status switch
    {
        MissionStatus.Open => "open",
        MissionStatus.Scheduled => "scheduled",
        MissionStatus.Disputed => "disputed",
        MissionStatus.Closed => "closed",
        MissionStatus.Cancelled => "cancelled",
        MissionStatus.Expired => "expired",
        _ => "open",
    };

    private string StatusLabel(Mission q) => q.Status switch
    {
        MissionStatus.Scheduled => "Scheduled",
        MissionStatus.Disputed => "Disputed",
        MissionStatus.Open when q.Participants.Any(p => p.Status is MissionParticipantStatus.Claimed or MissionParticipantStatus.Submitted) => "In progress",
        MissionStatus.Open => "Open",
        MissionStatus.Closed => "Completed",
        MissionStatus.Cancelled => "Cancelled",
        MissionStatus.Expired => "Expired",
        _ => q.Status.ToString(),
    };

    private string Local(DateTimeOffset? utc)
    {
        if (utc is not { } t)
        {
            return "—";
        }

        if (!TimeZoneService.IsValidZone(_zoneId))
        {
            return t.UtcDateTime.ToString("yyyy-MM-dd HH:mm");
        }

        var zone = TimeZoneInfo.FindSystemTimeZoneById(_zoneId);
        return TimeZoneInfo.ConvertTime(t, zone).ToString("yyyy-MM-dd HH:mm");
    }

    private sealed record QuestAction(string Value, string Label, bool Primary);

    public class PostInput
    {
        public string Kind { get; set; } = "personal";
        public string? Name { get; set; }
        public string? Details { get; set; }
        public long Amount { get; set; }
        public string? Currency { get; set; } = "POINTS";
        public DateTime? StartsAt { get; set; }
        public DateTime? ExpiresAt { get; set; }
    }
}
