@page "/guilds/{GuildIdRaw}/me"
@layout GuildLayout
@inherits GuildMemberComponentBase
@inject WebMemberService Members
@inject TimeZoneService TimeZones
@inject MusterDbContext Db
@inject Muster.Infrastructure.Connectors.CurrencyConnectorSyncService BalanceSync
@inject Muster.Infrastructure.Services.Currencies.ICurrencyReadService Reader
@inject Wolverine.IMessageBus Bus
@using Microsoft.EntityFrameworkCore
@using Muster.Contracts
@using Muster.Persistence
@using Muster.Persistence.Queries
@using Muster.Infrastructure.Services.Currencies
@using Muster.Infrastructure.Services.Platform
@using Muster.Infrastructure.Services.Web

<PageTitle>Wallet — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready && _detail is not null)
{
    <div class="page-head">
        <a class="back-link" href="/guilds/@GuildId">← Leaderboard</a>
        <h1>Wallet</h1>
        <p class="subtitle">@_detail.DisplayName</p>
    </div>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    <MemberPanel Detail="_detail" />

    <EditForm class="balance-sync-row" Model="this" FormName="sync-balances" OnValidSubmit="ForceSyncAsync">
        <button type="submit" class="btn btn-sm btn-ghost">Sync balances</button>
        <span class="subtitle">Pull your latest balances from connected economies (auto-refreshes every few minutes).</span>
    </EditForm>

    @if (_currencies.Count > 0)
    {
        <div class="panel glass">
            <h2>Filter history</h2>
            <EditForm class="form-grid" Model="this" FormName="wallet-filter" OnValidSubmit="ReloadAsync">
                <label>Currency
                    <InputSelect @bind-Value="HistoryCurrency">
                        <option value="">All currencies</option>
                        @foreach (var c in _currencies)
                        {
                            <option value="@c.Code">@c.Code — @c.Name</option>
                        }
                    </InputSelect>
                </label>
                <div class="btn-row"><button type="submit">Apply</button></div>
            </EditForm>
        </div>
    }

    @if (_spendable.Count > 0 && _recipients.Count > 0)
    {
        <div class="panel glass">
            <h2>Send currency</h2>
            <p class="subtitle">Transfer some of your own balance to another member.</p>
            <EditForm class="form-grid" Model="Send" FormName="wallet-send" OnValidSubmit="SendAsync">
                <input type="hidden" name="Send.Submitted" value="1" />
                <label>To
                    <InputSelect @bind-Value="Send.RecipientId">
                        <option value="0">— select —</option>
                        @foreach (var r in _recipients)
                        {
                            <option value="@r.UserId">@r.DisplayName</option>
                        }
                    </InputSelect>
                </label>
                <label>Currency
                    <InputSelect @bind-Value="Send.Currency">
                        @foreach (var c in _spendable)
                        {
                            <option value="@c.Code">@c.Code — @c.Name</option>
                        }
                    </InputSelect>
                </label>
                <label>Amount <InputNumber @bind-Value="Send.Amount" /></label>
                <label>Note <InputText @bind-Value="Send.Reason" /></label>
                <div class="btn-row"><button type="submit">Send</button></div>
            </EditForm>
        </div>
    }

    <div class="panel glass">
        <h2>Notifications</h2>
        <p class="subtitle">Get a private DM from the bot when another member sends you currency or staff award/adjust your balance.</p>
        <EditForm class="form-grid" Model="Notify" FormName="notify" OnValidSubmit="SaveNotifyAsync">
            <input type="hidden" name="Notify.Submitted" value="1" />
            <label class="check"><InputCheckbox @bind-Value="Notify.ReceiptsOn" /> DM me when I receive currency</label>
            <div class="btn-row"><button type="submit">Save</button></div>
        </EditForm>
    </div>

    <div class="panel glass">
        <h2>Time zone</h2>
        <p class="subtitle">Used to read the start/expiry dates you enter on the quest board. Leave blank to use the server's zone (<strong>@_guildZone</strong>).</p>
        <EditForm class="form-grid" Model="this" FormName="set-timezone" OnValidSubmit="SaveTimeZoneAsync">
            <label>Time zone
                <InputSelect @bind-Value="ZoneInput" id="tz-input">
                    <option value="">— use the server's zone (@_guildZone) —</option>
                    @foreach (var z in _zones)
                    {
                        <option value="@z.Id">@z.Display</option>
                    }
                </InputSelect>
            </label>
            <div class="btn-row">
                <button type="button" class="btn btn-ghost" onclick="musterUseBrowserTimeZone()">Use my browser zone</button>
                <button type="submit">Save</button>
            </div>
        </EditForm>
    </div>
}

@code {
    [SupplyParameterFromForm] public string? ZoneInput { get; set; }
    [SupplyParameterFromForm(FormName = "wallet-filter")] private string? HistoryCurrency { get; set; }
    [SupplyParameterFromForm(FormName = "wallet-send")] private SendInput Send { get; set; } = new();
    [SupplyParameterFromForm(FormName = "notify")] private NotifyInput Notify { get; set; } = new();

    private MemberDetailView? _detail;
    private IReadOnlyList<CurrencyInfo> _currencies = [];
    private IReadOnlyList<CurrencyInfo> _spendable = [];
    private IReadOnlyList<MemberOption> _recipients = [];
    private string _guildZone = TimeZoneService.Utc;

    private static readonly IReadOnlyList<(string Id, string Display)> _zones = TimeZoneService.GetKnownZones();

    protected override async Task LoadAsync()
    {
        // On-visit reconcile of any External/Hybrid balances, throttled to once per 5 minutes per wallet.
        await BalanceSync.SyncMemberDueAsync(GuildId, UserId, force: false);

        _currencies = await Reader.GetCurrenciesAsync(GuildId);
        _spendable = _currencies.Where(c => c.Spendable).ToList();
        _recipients = await Members.GetRecipientsAsync(GuildId, UserId);
        Send.Currency ??= _spendable.FirstOrDefault()?.Code;

        _detail = await Members.GetAsync(GuildId, UserId, currencyFilter: string.IsNullOrWhiteSpace(HistoryCurrency) ? null : HistoryCurrency);

        _guildZone = await Db.Guilds.Where(g => g.Id == GuildId).Select(g => g.TimeZoneId).FirstOrDefaultAsync() ?? TimeZoneService.Utc;
        // Prefill from the stored pref on GET only; on a form post the bound value already reflects the submission.
        ZoneInput ??= await Db.Users.Where(u => u.Id == UserId).Select(u => u.TimeZoneId).FirstOrDefaultAsync();
        if (Notify.Submitted is null)
        {
            Notify.ReceiptsOn = !await Db.CurrencyDmOptOutAsync(UserId);
        }
    }

    private Task ReloadAsync() => LoadAsync();

    private async Task SendAsync()
    {
        if (Send.RecipientId == 0)
        {
            Message = "Choose who to send to.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Send.Currency))
        {
            Message = "Choose a currency.";
            return;
        }

        if (Send.Amount <= 0)
        {
            Message = "Amount must be greater than zero.";
            return;
        }

        // Resolve the recipient's name now, before the form resets, so the confirmation reads cleanly.
        var toName = _recipients.FirstOrDefault(r => r.UserId == Send.RecipientId)?.DisplayName ?? $"member {Send.RecipientId}";
        var amount = Send.Amount;
        var code = Send.Currency!.ToUpperInvariant();
        var reason = string.IsNullOrWhiteSpace(Send.Reason) ? "Wallet transfer" : Send.Reason!.Trim();

        var result = await Bus.InvokeAsync<Result>(
            new TransferCurrency(GuildId, UserId, code, UserId, Send.RecipientId, amount, reason));

        Message = result.Ok
            ? $"Sent {amount:N0} {code} to {toName}."
            : result.Status switch
            {
                "InsufficientFunds" => "You don't have enough for that.",
                "CurrencyNotFound" => "That currency doesn't exist here.",
                "Forbidden" => "You're not allowed to do that.",
                var other => other,
            };

        if (result.Ok)
        {
            Send = new SendInput();
        }

        await LoadAsync();
    }

    private async Task ForceSyncAsync()
    {
        var synced = await BalanceSync.SyncMemberDueAsync(GuildId, UserId, force: true);
        Message = synced > 0 ? $"Synced {synced} balance(s) from connected economies." : "No connected balances to sync.";
        await LoadAsync();
    }

    private async Task SaveNotifyAsync()
    {
        await Db.SetCurrencyDmOptOutAsync(UserId, optOut: !Notify.ReceiptsOn);
        Message = Notify.ReceiptsOn ? "Currency receipts are on." : "Currency receipts are off.";
        await LoadAsync();
    }

    private async Task SaveTimeZoneAsync()
    {
        var (ok, error) = await TimeZones.SetUserZoneAsync(UserId, ZoneInput);
        Message = ok
            ? (string.IsNullOrWhiteSpace(ZoneInput) ? "Time zone cleared — using the server's zone." : $"Time zone set to {ZoneInput.Trim()}.")
            : error;
        await LoadAsync();
    }

    public class SendInput
    {
        public string? Submitted { get; set; }
        public ulong RecipientId { get; set; }
        public string? Currency { get; set; }
        public long Amount { get; set; }
        public string? Reason { get; set; }
    }

    public class NotifyInput
    {
        public string? Submitted { get; set; }
        public bool ReceiptsOn { get; set; }
    }
}
