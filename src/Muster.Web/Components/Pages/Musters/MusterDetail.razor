@page "/guilds/{GuildIdRaw}/guild/musters/{MusterId:guid}"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildAdminComponentBase
@inject IMusterReadService Reads
@inject Wolverine.IMessageBus Bus
@using Muster.Contracts
@using Muster.Domain.Enums
@using Muster.Infrastructure.Services.Membership
@using Muster.Infrastructure.Services.Musters

<PageTitle>Muster — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    <PageHeader Crumbs="@(new PageHeader.Crumb[] { new("Musters", MusterLinks.Musters(GuildId)), new(_heading) })"
                Subtitle="@(_m is null ? null : $"Posted {_m.Status.ToString().ToLowerInvariant()}")">
        <Toolbar>
            @if (_m is not null)
            {
                @if (_m.Status is MusterStatus.Open or MusterStatus.Locked)
                {
                    <button type="button" class="btn btn-sm btn-danger" disabled="@_busy" @onclick="CloseAsync">
                        <span class="material-symbols-outlined">stop_circle</span> Close
                    </button>
                }
                <button type="button" class="btn btn-sm btn-ghost" disabled="@_busy" @onclick="RemoveCardAsync">
                    <span class="material-symbols-outlined">delete_sweep</span> Remove Discord card
                </button>
            }
        </Toolbar>
    </PageHeader>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    @if (_m is null)
    {
        <div class="panel glass empty">Muster not found.</div>
    }
    else
    {
        <Accordion>
            <AccordionPane Title="Overview" Icon="info" Open="true" Summary="@OverviewSummary">
                @if (!string.IsNullOrWhiteSpace(_m.Prompt))
                {
                    <div class="muster-prompt">@Muster.Web.DiscordMarkdown.ToHtml(_m.Prompt)</div>
                }
                <dl class="kv">
                    <div><dt>Status</dt><dd>@StatusLabel(_m.Status)</dd></div>
                    <div><dt>Checked in</dt><dd>@_m.Participants.Count@(_m.Capacity is { } c ? $" / {c}" : "")</dd></div>
                    <div><dt>Reward</dt><dd>@RewardLabel(_m.Points, _m.Coins, _m.CoinCode)</dd></div>
                    @if (_m.MinCheckIns is { } min && min > 0)
                    {
                        <div><dt>Min to reward</dt><dd>@_m.Participants.Count / @min @(_m.Participants.Count >= min ? "✅ met" : "⚠️ not met")</dd></div>
                    }
                    <div><dt>Created</dt><dd><LocalTime Value="_m.CreatedAt" /> by @Name(_m.CreatedBy)</dd></div>
                    @if (_m.ExpiresAt is { } ex)
                    {
                        <div><dt>@(_m.Status is MusterStatus.Open or MusterStatus.Locked ? "Closes" : "Closed at")</dt><dd><LocalTime Value="ex" /></dd></div>
                    }
                </dl>
            </AccordionPane>

            <AccordionPane Title="@($"Participants ({_m.Participants.Count})")" Icon="group" Open="true">
                <div class="dg-scroll">
                    <table class="dg-table">
                        <thead><tr><th>Member</th><th>Via</th><th>Checked in</th><th></th></tr></thead>
                        <tbody>
                            @if (_m.Participants.Count == 0)
                            {
                                <tr class="dg-empty"><td colspan="4">No check-ins yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var p in _m.Participants)
                                {
                                    <tr>
                                        <td>@Name(p.UserId)</td>
                                        <td>@(p.Source == MusterParticipantSource.Admin ? "Added by staff" : "Button")</td>
                                        <td><LocalTime Value="p.CheckedInAt" /></td>
                                        <td class="dg-actions-col">
                                            <button type="button" class="icon-btn danger" title="Remove" disabled="@_busy" @onclick="() => RemoveAsync(p.UserId)"><span class="material-symbols-outlined">person_remove</span></button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="form-inline">
                    <input class="input" @bind="_addUserId" placeholder="Discord user id to add" />
                    <button type="button" disabled="@_busy" @onclick="AddAsync">Add participant</button>
                </div>
            </AccordionPane>

            <AccordionPane Title="@($"Linked sessions ({_m.Sessions.Count})")" Icon="link" Open="true" Summary="@LinkedSummary">
                @if (_m.Sessions.Count == 0)
                {
                    <p class="subtitle">Not linked to any session. Link one to gate its spendable-coin mint on check-in — points are never gated, and a session with no linked muster mints coins to everyone.</p>
                }
                else
                {
                    <ul class="list muster-links">
                        @foreach (var s in _m.Sessions)
                        {
                            <li>
                                <a href="@MusterLinks.SessionDetail(GuildId, s.SessionId)">@s.Name</a> <span class="subtitle">(@s.Status)</span>
                                <label class="subtitle">Coin gate:
                                    <select class="dg-select" value="@s.Gate" disabled="@_busy" @onchange="(e) => OnGateChangeAsync(s.SessionId, e)">
                                        <option value="@SessionCoinGate.None">None — mint to all</option>
                                        <option value="@SessionCoinGate.Any">Any — in any linked muster</option>
                                        <option value="@SessionCoinGate.All">All — in every linked muster</option>
                                    </select>
                                </label>
                                <button type="button" class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => UnlinkAsync(s.SessionId)">Unlink</button>
                            </li>
                        }
                    </ul>
                }
                <div class="form-inline">
                    <select class="dg-select" @bind="_linkSessionId">
                        <option value="">Select a session…</option>
                        @foreach (var s in _sessions)
                        {
                            <option value="@s.SessionId">@s.Name (@s.Status)</option>
                        }
                    </select>
                    <button type="button" disabled="@_busy" @onclick="LinkAsync">Link session</button>
                </div>
                <p class="subtitle">Linking defaults the session's coin gate to <strong>Any</strong>. Add more musters (e.g. mission rounds) and switch to <strong>All</strong> to require every one — under <strong>All</strong>, every linked muster is required, so one that nobody checked into blocks the coin (use <strong>Any</strong>, or don't link it, if that's not intended). A session with no muster linked at all mints to everyone.</p>
            </AccordionPane>
        </Accordion>
    }
}

<style>
    .muster-prompt { margin: 0 0 1rem; line-height: 1.5; }
    .muster-prompt > :first-child { margin-top: 0; }
    .muster-prompt > :last-child { margin-bottom: 0; }
    .muster-links li { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; padding: 0.35rem 0; }
</style>

@code {
    [Parameter] public Guid MusterId { get; set; }

    protected override GuildAccessTier RequiredAccess => GuildAccessTier.TrackingManager | GuildAccessTier.Officer;

    private MusterDetailView? _m;
    private IReadOnlyList<MusterLinkedSession> _sessions = [];
    private readonly Dictionary<ulong, string> _names = [];
    private bool _busy;
    private string _addUserId = "";
    private string? _linkSessionId;

    private string _heading = "Muster";

    protected override async Task LoadAsync()
    {
        _m = await Reads.GetDetailAsync(GuildId, MusterId);
        if (_m is null)
        {
            _heading = "Muster";
            return;
        }

        _heading = !string.IsNullOrWhiteSpace(_m.Title)
            ? _m.Title!
            : Muster.Web.DiscordMarkdown.ToSnippet(_m.Prompt, 60) is { Length: > 0 } snip ? snip : "Muster";

        _sessions = await Reads.ListLinkableSessionsAsync(GuildId);

        _names.Clear();
        foreach (var id in _m.Participants.Select(p => p.UserId).Append(_m.CreatedBy).Distinct())
        {
            _names[id] = await HumanizeAsync($"<@{id}>");
        }
    }

    private string OverviewSummary => _m is null ? "" : RewardLabel(_m.Points, _m.Coins, _m.CoinCode);

    private string LinkedSummary => _m is null || _m.Sessions.Count == 0
        ? "Not linked"
        : $"{_m.Sessions.Count} session{(_m.Sessions.Count == 1 ? "" : "s")}";

    private string Name(ulong userId) => _names.TryGetValue(userId, out var n) ? n : $"<@{userId}>";

    private static string RewardLabel(long points, long coins, string? coinCode)
    {
        var parts = new List<string>();
        if (points > 0) { parts.Add($"{points} pts"); }
        if (coins > 0) { parts.Add($"{coins} {coinCode ?? "coins"}"); }
        return parts.Count == 0 ? "Check-in only" : string.Join(" + ", parts);
    }

    private static string StatusLabel(MusterStatus s) => s switch
    {
        MusterStatus.Open => "🟢 Open",
        MusterStatus.Locked => "🔒 Locked — closes with session",
        MusterStatus.Closed => "✅ Closed",
        MusterStatus.Expired => "⌛ Expired",
        MusterStatus.Cancelled => "🚫 Cancelled",
        _ => s.ToString(),
    };

    private async Task CloseAsync() => await RunAsync(new CloseMuster(GuildId, UserId, MusterId), "Muster closed.");

    private async Task RemoveCardAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            // Page is access-gated (RequiredAccess); audit the action here, then ask the bot host (which owns the
            // gateway client) to delete the card. The muster data is untouched.
            await AuditAsync("muster.card.remove", $"muster:{MusterId}");
            await Bus.PublishAsync(new RemoveMusterCard(GuildId, MusterId));
            Message = "Removing the Discord card…";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(ulong userId) => await RunAsync(new RemoveMusterParticipant(GuildId, UserId, MusterId, userId), "Participant removed.");

    private async Task AddAsync()
    {
        if (!ulong.TryParse(_addUserId?.Trim(), out var userId))
        {
            Message = "Enter a numeric Discord user id.";
            return;
        }

        await RunAsync(new AddMusterParticipant(GuildId, UserId, MusterId, userId), "Participant added.");
        _addUserId = "";
    }

    private async Task LinkAsync()
    {
        if (!Guid.TryParse(_linkSessionId, out var sessionId))
        {
            Message = "Pick a session to link.";
            return;
        }

        // Default the session's coin gate to Any on link (the common "must check in" case); changeable below.
        var linked = await Bus.InvokeAsync<Result>(new LinkMusterToSession(GuildId, UserId, MusterId, sessionId));
        if (linked.Ok)
        {
            await Bus.InvokeAsync<Result>(new SetSessionCoinGate(GuildId, UserId, sessionId, SessionCoinGate.Any));
        }

        Message = linked.Ok ? "Session linked." : MusterStatusText.Friendly(linked.Status);
        _linkSessionId = null;
        await LoadAsync();
    }

    private async Task OnGateChangeAsync(Guid sessionId, ChangeEventArgs e)
    {
        if (!Enum.TryParse<SessionCoinGate>(e.Value as string, out var gate))
        {
            return;
        }

        await RunAsync(new SetSessionCoinGate(GuildId, UserId, sessionId, gate), "Coin gate updated.");
    }

    private async Task UnlinkAsync(Guid sessionId) => await RunAsync(new UnlinkMusterFromSession(GuildId, UserId, MusterId, sessionId), "Session unlinked.");

    private async Task RunAsync(IGuildCommand command, string okMessage)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Bus.InvokeAsync<Result>(command);
            Message = result.Ok ? okMessage : MusterStatusText.Friendly(result.Status);
        }
        finally
        {
            _busy = false;
            await LoadAsync();
        }
    }
}
