@page "/guilds/{GuildIdRaw}/guild/musters/{MusterId:guid}"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildAdminComponentBase
@implements IDisposable
@inject IMusterReadService Reads
@inject WebAdminService Admin
@inject Muster.Web.Live.IMusterUpdateNotifier Notifier
@inject Wolverine.IMessageBus Bus
@using Muster.Contracts
@using Muster.Domain.Enums
@using Muster.Infrastructure.Services.Membership
@using Muster.Infrastructure.Services.Musters
@using Muster.Infrastructure.Services.Web

<PageTitle>Muster — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    <PageHeader Crumbs="@(new PageHeader.Crumb[] { new("Musters", MusterLinks.Musters(GuildId)), new(_heading) })"
                Subtitle="@(_m is null ? null : StatusLabel(_m.Status))">
        <Toolbar>
            @if (_m is not null)
            {
                @if (_isParticipant && _m.Status == MusterStatus.Open)
                {
                    @if (YouCheckedIn)
                    {
                        <button type="button" class="btn btn-sm btn-ghost" disabled="@_busy" @onclick="CheckOutSelfAsync">
                            <span class="material-symbols-outlined">logout</span> Check out
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm" disabled="@_busy" @onclick="CheckInSelfAsync">
                            <span class="material-symbols-outlined">how_to_reg</span> Check in
                        </button>
                    }
                }
                @if (_canManage)
                {
                    @if (_m.Status == MusterStatus.Open)
                    {
                        <a class="btn btn-sm btn-ghost" href="@MusterLinks.MusterEdit(GuildId, MusterId)"><span class="material-symbols-outlined">edit</span> Edit</a>
                        <button type="button" class="btn btn-sm btn-ghost" disabled="@_busy" @onclick="LockAsync"><span class="material-symbols-outlined">rule</span> Lock for review</button>
                        <button type="button" class="btn btn-sm" disabled="@_busy" @onclick="CloseAsync"><span class="material-symbols-outlined">paid</span> Close &amp; pay</button>
                    }
                    else if (_m.Status == MusterStatus.Locked && _m.Sessions.Count == 0)
                    {
                        <button type="button" class="btn btn-sm" disabled="@_busy" @onclick="CloseAsync"><span class="material-symbols-outlined">paid</span> Approve &amp; pay</button>
                        <button type="button" class="btn btn-sm btn-danger" disabled="@_busy" @onclick="DiscardAsync"><span class="material-symbols-outlined">block</span> Discard</button>
                    }
                    else if (_m.Status == MusterStatus.Locked)
                    {
                        <button type="button" class="btn btn-sm btn-danger" disabled="@_busy" @onclick="CloseAsync"><span class="material-symbols-outlined">stop_circle</span> Close</button>
                    }
                    <button type="button" class="btn btn-sm btn-ghost" disabled="@_busy" @onclick="RemoveCardAsync"><span class="material-symbols-outlined">delete_sweep</span> Remove card</button>
                }
            }
        </Toolbar>
    </PageHeader>

    @if (Message is not null)
    {
        <p class="message">@Message</p>
    }

    @if (_m is null)
    {
        <div class="panel glass empty">Muster not found.</div>
    }
    else
    {
        <TabFrame ActiveId="@_tab" ActiveIdChanged="@(t => _tab = t)">
            <TabPane Id="overview" Label="Overview" Icon="info">
                @if (!string.IsNullOrWhiteSpace(_m.Prompt))
                {
                    <div class="muster-prompt">@Muster.Web.DiscordMarkdown.ToHtml(_m.Prompt)</div>
                }
                <div class="mf-grid">
                    <div class="mf"><span class="mf-k">Status</span><span class="mf-v">@StatusLabel(_m.Status)</span></div>
                    <div class="mf"><span class="mf-k">Checked in</span><span class="mf-v">@_m.Participants.Count@(_m.Capacity is { } c ? $" / {c}" : "")</span></div>
                    <div class="mf"><span class="mf-k">Reward</span><span class="mf-v">@RewardLabel(_m.Points, _m.Coins, _m.CoinCode)</span></div>
                    @if (_m.MinCheckIns is { } min && min > 0)
                    {
                        <div class="mf"><span class="mf-k">Min to reward</span><span class="mf-v">@_m.Participants.Count / @min @(_m.Participants.Count >= min ? "✅" : "⚠️")</span></div>
                    }
                    <div class="mf"><span class="mf-k">Created</span><span class="mf-v"><LocalTime Value="_m.CreatedAt" /> · @Name(_m.CreatedBy)</span></div>
                    @if (_m.ExpiresAt is { } ex)
                    {
                        <div class="mf"><span class="mf-k">@(_m.Status is MusterStatus.Open or MusterStatus.Locked ? "Closes" : "Closed at")</span><span class="mf-v"><LocalTime Value="ex" /></span></div>
                    }
                    <div class="mf"><span class="mf-k">Auto-close</span><span class="mf-v">@(_m.ResolveMode == MusterResolveMode.Review ? "Hold for review" : "Pay out")</span></div>
                </div>
            </TabPane>

            <TabPane Id="participants" Label="@($"Participants ({_m.Participants.Count})")" Icon="group">
                <div class="dg-frame">
                    <div class="dg-toolbar">
                        <div class="dg-filters">
                            <input type="search" class="dg-search" placeholder="Search member…" @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />
                        </div>
                        @if (_canManage && _m.Status == MusterStatus.Open)
                        {
                            <div class="dg-actions member-add">
                                <input type="search" class="dg-search" placeholder="Add a participant…" @bind="_addSearch" @bind:event="oninput" />
                                @if (_addSel is not null)
                                {
                                    <span class="member-chip">@_addSel.DisplayName <button type="button" class="member-chip-x" @onclick="() => _addSel = null">×</button></span>
                                    <button type="button" class="btn btn-sm" disabled="@_busy" @onclick="AddSelectedAsync"><span class="material-symbols-outlined">person_add</span> Add</button>
                                }
                                @if (_addSel is null && !string.IsNullOrWhiteSpace(_addSearch))
                                {
                                    <div class="member-results">
                                        @foreach (var opt in MemberMatches)
                                        {
                                            <button type="button" class="member-result" @onclick="() => Select(opt)">@opt.DisplayName</button>
                                        }
                                        @if (MemberMatches.Count == 0)
                                        {
                                            <span class="member-result empty">No members match.</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="dg-scroll">
                        <table class="dg-table">
                            <thead>
                                <tr>
                                    <th class="sortable" @onclick='() => SetSort("name")'>Member @Ind("name")</th>
                                    <th class="sortable" @onclick='() => SetSort("via")'>Via @Ind("via")</th>
                                    <th class="sortable" @onclick='() => SetSort("time")'>Checked in @Ind("time")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Filtered.Count == 0)
                                {
                                    <tr class="dg-empty"><td colspan="4">@(_m.Participants.Count == 0 ? "No check-ins yet." : "No members match your search.")</td></tr>
                                }
                                else
                                {
                                    @foreach (var p in Paged)
                                    {
                                        <tr>
                                            <td>@Name(p.UserId)</td>
                                            <td>@(p.Source == MusterParticipantSource.Admin ? "Added by staff" : "Button")</td>
                                            <td><LocalTime Value="p.CheckedInAt" /></td>
                                            <td class="dg-actions-col">
                                                @if (_canManage)
                                                {
                                                    <button type="button" class="icon-btn danger" title="Remove" disabled="@_busy" @onclick="() => RemoveAsync(p.UserId)"><span class="material-symbols-outlined">person_remove</span></button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="dg-footer">
                        <div class="dg-footer-left">
                            <div class="dg-pagesize">Rows
                                <select class="dg-select" value="@_pageSize" @onchange="OnPageSize">
                                    <option value="10">10</option><option value="25">25</option><option value="50">50</option>
                                </select>
                            </div>
                            <span class="dg-tz">@Filtered.Count of @_m.Participants.Count</span>
                        </div>
                        <div class="dg-pager">
                            <button type="button" class="btn btn-ghost btn-sm" disabled="@(CurrentPage <= 1)" @onclick="() => _page = CurrentPage - 1">← Prev</button>
                            <span>Page @CurrentPage of @TotalPages</span>
                            <button type="button" class="btn btn-ghost btn-sm" disabled="@(CurrentPage >= TotalPages)" @onclick="() => _page = CurrentPage + 1">Next →</button>
                        </div>
                    </div>
                </div>
            </TabPane>

            <TabPane Id="sessions" Label="@($"Linked sessions ({_m.Sessions.Count})")" Icon="link">
                @if (_m.Sessions.Count == 0)
                {
                    <p class="subtitle">Not linked to any session. Link one to gate its spendable-coin mint on check-in — points are never gated, and a session with no linked muster mints coins to everyone.</p>
                }
                else
                {
                    <ul class="list muster-links">
                        @foreach (var s in _m.Sessions)
                        {
                            <li>
                                <a href="@MusterLinks.SessionDetail(GuildId, s.SessionId)">@s.Name</a> <span class="subtitle">(@s.Status)</span>
                                @if (_isManager)
                                {
                                    <label class="subtitle">Coin gate:
                                        <select class="dg-select" value="@s.Gate" disabled="@_busy" @onchange="(e) => OnGateChangeAsync(s.SessionId, e)">
                                            <option value="@SessionCoinGate.None">None — mint to all</option>
                                            <option value="@SessionCoinGate.Any">Any — in any linked muster</option>
                                            <option value="@SessionCoinGate.All">All — in every linked muster</option>
                                        </select>
                                    </label>
                                    <button type="button" class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => UnlinkAsync(s.SessionId)">Unlink</button>
                                }
                                else
                                {
                                    <span class="subtitle">· gate @s.Gate</span>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (_isManager)
                {
                    <div class="form-inline">
                        <select class="dg-select" @bind="_linkSessionId">
                            <option value="">Select a session…</option>
                            @foreach (var s in _sessions)
                            {
                                <option value="@s.SessionId">@s.Name (@s.Status)</option>
                            }
                        </select>
                        <button type="button" disabled="@_busy" @onclick="LinkAsync">Link session</button>
                    </div>
                    <p class="subtitle">Linking defaults the session's coin gate to <strong>Any</strong>. Under <strong>All</strong>, every linked muster is required. A session with no muster linked mints to everyone.</p>
                }
                else
                {
                    <p class="subtitle">Session linking + coin gating are managed by tracking staff.</p>
                }
            </TabPane>
        </TabFrame>
    }
}

<style>
    .muster-prompt { margin: 0 0 1rem; line-height: 1.5; }
    .muster-prompt > :first-child { margin-top: 0; }
    .muster-prompt > :last-child { margin-bottom: 0; }

    /* Discord-style field grid: compact label/value cards. */
    .mf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.85rem 1.25rem; }
    .mf { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.6rem 0.75rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: color-mix(in srgb, var(--surface) 50%, transparent); }
    .mf-k { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
    .mf-v { font-size: 0.95rem; color: var(--text); }

    .muster-links li { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; padding: 0.35rem 0; }

    /* Member-add picker. */
    .member-add { position: relative; display: flex; align-items: center; gap: 0.5rem; }
    .member-results { position: absolute; top: 100%; right: 0; z-index: 20; margin-top: 4px; min-width: 14rem; max-height: 16rem; overflow: auto;
        background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); box-shadow: 0 8px 24px rgba(0,0,0,0.3); padding: 4px; }
    .member-result { display: block; width: 100%; text-align: left; border: 0; background: transparent; color: var(--text); padding: 0.4rem 0.55rem; border-radius: 6px; cursor: pointer; }
    .member-result:hover { background: color-mix(in srgb, var(--accent) 18%, transparent); }
    .member-result.empty { color: var(--text-muted); cursor: default; }
    .member-chip { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.25rem 0.5rem; border-radius: 999px; background: color-mix(in srgb, var(--accent) 18%, transparent); font-size: 0.85rem; }
    .member-chip-x { border: 0; background: transparent; color: inherit; cursor: pointer; font-size: 1rem; line-height: 1; }
</style>

@code {
    [Parameter] public Guid MusterId { get; set; }

    protected override GuildAccessTier RequiredAccess => GuildAccessTier.TrackingManager | GuildAccessTier.MusterCreator | GuildAccessTier.Officer;

    protected override async Task<bool> IsAuthorizedAsync(ulong guildId, ulong userId)
        => await base.IsAuthorizedAsync(guildId, userId) || await Auth.IsParticipantAsync(guildId, userId);

    private MusterDetailView? _m;
    private IReadOnlyList<MusterLinkedSession> _sessions = [];
    private IReadOnlyList<MemberOption> _memberOptions = [];
    private readonly Dictionary<ulong, string> _names = [];
    private bool _busy;
    private string? _linkSessionId;
    private string _tab = "overview";

    private bool _canManage;
    private bool _isManager;
    private bool _isParticipant;
    private bool YouCheckedIn => _m is not null && _m.Participants.Any(p => p.UserId == UserId);
    private string _heading = "Muster";

    // Participant grid state.
    private string _search = "";
    private string _sortKey = "time";
    private bool _descending = true;
    private int _page = 1;
    private int _pageSize = 25;

    // Add-member picker.
    private string _addSearch = "";
    private MemberOption? _addSel;

    protected override async Task LoadAsync()
    {
        _m = await Reads.GetDetailAsync(GuildId, MusterId);
        if (_m is null)
        {
            _heading = "Muster";
            return;
        }

        _heading = !string.IsNullOrWhiteSpace(_m.Title)
            ? _m.Title!
            : Muster.Web.DiscordMarkdown.ToSnippet(_m.Prompt, 60) is { Length: > 0 } snip ? snip : "Muster";

        _isManager = await Auth.IsTrackingManagerAsync(GuildId, UserId);
        _canManage = await Auth.CanManageMusterAsync(GuildId, UserId, _m.CreatedBy);
        _isParticipant = await Auth.IsParticipantAsync(GuildId, UserId);

        if (_canManage)
        {
            _sessions = await Reads.ListLinkableSessionsAsync(GuildId);
            _memberOptions = await Admin.GetParticipantMembersAsync(GuildId);
        }

        _names.Clear();
        foreach (var id in _m.Participants.Select(p => p.UserId).Append(_m.CreatedBy).Distinct())
        {
            _names[id] = await HumanizeAsync($"<@{id}>");
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Notifier.Updated += OnMusterChanged;
        }
    }

    // Live: a check-in from Discord/web/API publishes MusterChanged → re-fetch this muster.
    private void OnMusterChanged(MusterChanged change)
    {
        if (State != AccessState.Ready || change.MusterId != MusterId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => Notifier.Updated -= OnMusterChanged;

    private string Name(ulong userId) => _names.TryGetValue(userId, out var n) ? n : $"<@{userId}>";

    // ---- Participant grid ----
    private IReadOnlyList<MusterParticipantView> Filtered
    {
        get
        {
            if (_m is null) { return []; }
            IEnumerable<MusterParticipantView> q = _m.Participants;

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(p => Name(p.UserId).Contains(s, StringComparison.OrdinalIgnoreCase));
            }

            Func<MusterParticipantView, IComparable> key = _sortKey switch
            {
                "name" => p => Name(p.UserId),
                "via" => p => (int)p.Source,
                _ => p => p.CheckedInAt,
            };
            q = _descending ? q.OrderByDescending(key) : q.OrderBy(key);
            return q.ToList();
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)_pageSize));
    private int CurrentPage => Math.Clamp(_page, 1, TotalPages);
    private IReadOnlyList<MusterParticipantView> Paged => Filtered.Skip((CurrentPage - 1) * _pageSize).Take(_pageSize).ToList();

    private void ResetPage() => _page = 1;
    private void OnPageSize(ChangeEventArgs e) { _pageSize = int.TryParse(e.Value as string, out var v) ? v : 25; _page = 1; }
    private void SetSort(string col) { _descending = _sortKey == col ? !_descending : col == "time"; _sortKey = col; _page = 1; }
    private string Ind(string col) => _sortKey == col ? (_descending ? "▼" : "▲") : "";

    // ---- Add-member picker ----
    private IReadOnlyList<MemberOption> MemberMatches
    {
        get
        {
            var s = _addSearch.Trim();
            var onRoster = _m?.Participants.Select(p => p.UserId).ToHashSet() ?? [];
            return _memberOptions
                .Where(o => !onRoster.Contains(o.UserId) && o.DisplayName.Contains(s, StringComparison.OrdinalIgnoreCase))
                .Take(8).ToList();
        }
    }

    private void Select(MemberOption opt) { _addSel = opt; _addSearch = ""; }

    private async Task AddSelectedAsync()
    {
        if (_addSel is not { } sel) { return; }
        var picked = sel;
        _addSel = null;
        await RunAsync(new AddMusterParticipant(GuildId, UserId, MusterId, picked.UserId), $"Added {picked.DisplayName}.");
    }

    private static string RewardLabel(long points, long coins, string? coinCode)
    {
        var parts = new List<string>();
        if (points > 0) { parts.Add($"{points} pts"); }
        if (coins > 0) { parts.Add($"{coins} {coinCode ?? "coins"}"); }
        return parts.Count == 0 ? "Check-in only" : string.Join(" + ", parts);
    }

    private string StatusLabel(MusterStatus s) => s switch
    {
        MusterStatus.Open => "🟢 Open",
        MusterStatus.Locked => (_m?.Sessions.Count ?? 0) > 0 ? "🔒 Locked — closes with session" : "🔍 Pending review",
        MusterStatus.Closed => "✅ Closed",
        MusterStatus.Expired => "⌛ Expired",
        MusterStatus.Cancelled => "🚫 Cancelled",
        _ => s.ToString(),
    };

    private async Task CheckInSelfAsync() => await RunAsync(new CheckInMuster(GuildId, UserId, MusterId), "Checked in.");
    private async Task CheckOutSelfAsync() => await RunAsync(new CheckOutMuster(GuildId, UserId, MusterId), "Checked out.");
    private async Task CloseAsync() => await RunAsync(new CloseMuster(GuildId, UserId, MusterId), "Muster closed.");
    private async Task LockAsync() => await RunAsync(new LockMuster(GuildId, UserId, MusterId), "Locked for review.");
    private async Task DiscardAsync() => await RunAsync(new CancelMuster(GuildId, UserId, MusterId), "Muster discarded.");
    private async Task RemoveAsync(ulong userId) => await RunAsync(new RemoveMusterParticipant(GuildId, UserId, MusterId, userId), "Participant removed.");

    private async Task RemoveCardAsync()
    {
        if (_busy) { return; }
        _busy = true;
        try
        {
            await AuditAsync("muster.card.remove", $"muster:{MusterId}");
            await Bus.PublishAsync(new RemoveMusterCard(GuildId, MusterId));
            Message = "Removing the Discord card…";
        }
        finally { _busy = false; }
    }

    private async Task LinkAsync()
    {
        if (!Guid.TryParse(_linkSessionId, out var sessionId))
        {
            Message = "Pick a session to link.";
            return;
        }

        var linked = await Bus.InvokeAsync<Result>(new LinkMusterToSession(GuildId, UserId, MusterId, sessionId));
        if (linked.Ok)
        {
            await Bus.InvokeAsync<Result>(new SetSessionCoinGate(GuildId, UserId, sessionId, SessionCoinGate.Any));
        }

        Message = linked.Ok ? "Session linked." : MusterStatusText.Friendly(linked.Status);
        _linkSessionId = null;
        await LoadAsync();
    }

    private async Task OnGateChangeAsync(Guid sessionId, ChangeEventArgs e)
    {
        if (Enum.TryParse<SessionCoinGate>(e.Value as string, out var gate))
        {
            await RunAsync(new SetSessionCoinGate(GuildId, UserId, sessionId, gate), "Coin gate updated.");
        }
    }

    private async Task UnlinkAsync(Guid sessionId) => await RunAsync(new UnlinkMusterFromSession(GuildId, UserId, MusterId, sessionId), "Session unlinked.");

    private async Task RunAsync(IGuildCommand command, string okMessage)
    {
        if (_busy) { return; }
        _busy = true;
        try
        {
            var result = await Bus.InvokeAsync<Result>(command);
            Message = result.Ok ? okMessage : MusterStatusText.Friendly(result.Status);
        }
        finally
        {
            _busy = false;
            await LoadAsync();
        }
    }
}
