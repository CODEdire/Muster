        public int MinutesPerCoin { get; set; }
        public int? MaxSessionHours { get; set; }
        public int? ActivityRetentionDays { get; set; }
        public int? MinTrackedSeconds { get; set; }
        public MultiplierStacking Stacking { get; set; }
        public decimal? Cap { get; set; }
        public int StartBonus { get; set; }
        public int EndBonus { get; set; }
        public int StartWindow { get; set; } = 5;
        public int EndWindow { get; set; } = 5;
        public bool MultiplyBonuses { get; set; }

        // Guild default guards, decomposed per lane (Bg = background, Se = manual session, Ev = scheduled event).
        public bool BgMuted { get; set; } public bool BgDeafened { get; set; } public bool BgAlone { get; set; }
        public bool SeMuted { get; set; } public bool SeDeafened { get; set; } public bool SeAlone { get; set; }
        public bool EvMuted { get; set; } public bool EvDeafened { get; set; } public bool EvAlone { get; set; }
    }

