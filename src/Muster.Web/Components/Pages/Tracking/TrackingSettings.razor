        public GuardLaneEdit Session { get; set; } = new();
        public GuardLaneEdit Event { get; set; } = new();
    }

    public class GuardLaneEdit
    {
        public bool Inherit { get; set; } = true;
        public bool Muted { get; set; }
        public bool Deafened { get; set; }
        public bool Alone { get; set; }

        public static GuardLaneEdit From(AfkGuards? g) => g is null
            ? new GuardLaneEdit { Inherit = true }
            : new GuardLaneEdit { Inherit = false, Muted = g.Value.Unmuted(), Deafened = g.Value.Undeafened(), Alone = g.Value.NotAlone() };

        public AfkGuards? ToGuards() => Inherit ? null : AfkGuardsExtensions.Compose(Muted, Deafened, Alone);
    }
