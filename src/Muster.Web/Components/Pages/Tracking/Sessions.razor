@page "/guilds/{GuildIdRaw}/guild/tracking/sessions"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildMemberComponentBase
@implements IDisposable
@inject IServiceScopeFactory Scopes
@inject ISessionUpdateNotifier Notifier
@using Microsoft.EntityFrameworkCore
@using Muster.Domain.Enums
@using Muster.Persistence
@using Muster.Persistence.Queries
@using Muster.Infrastructure.Services.Tracking
@using Muster.Infrastructure.Services.Membership
@using Muster.Infrastructure.Services.Platform

<PageTitle>Sessions — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready)
{
    <div class="page-head">
        <h1>Sessions</h1>
        <p class="subtitle">Live operations, voice participation@(_isStaff ? ", and history" : "").</p>
    </div>

    @if (_present)
    {
        <div class="panel banner-row banner-warn" role="status">
            <span class="material-symbols-outlined banner-icon">notifications_active</span>
            <div class="banner-text">
                <strong>You're being tracked in a live session.</strong>
                <span class="banner-why">An admin is running a tracked session in a voice channel you're in, so your voice time counts toward participation rewards.</span>
            </div>
            <a class="btn btn-sm btn-ghost" href="/guilds/@GuildId/settings#privacy">Privacy settings</a>
        </div>
    }

    @* Shared folder-tab frame: each tab declares its own body; the frame shows only the active one. *@
    <TabFrame ActiveId="@CurrentTab" ActiveIdChanged="OnTab">
        <TabPane Id="sessions" Label="Sessions" Icon="schedule">
            <div class="dg-toolbar">
                <div class="dg-filters">
                    @if (_isStaff)
                    {
                        <div class="seg" role="group" aria-label="Status filter">
                            <button type="button" class="@(StatusFilter == SessionStatusFilter.Active ? "active" : "")" @onclick="() => OnStatus(SessionStatusFilter.Active)">Active</button>
                            <button type="button" class="@(StatusFilter == SessionStatusFilter.Ended ? "active" : "")" @onclick="() => OnStatus(SessionStatusFilter.Ended)">History</button>
                            <button type="button" class="@(StatusFilter == SessionStatusFilter.All ? "active" : "")" @onclick="() => OnStatus(SessionStatusFilter.All)">All</button>
                        </div>
                    }
                    <input type="search" class="dg-search" placeholder="Search name…" @bind="_searchBox" @bind:event="oninput" @bind:after="DebouncedSearchAsync" />
                    <select class="dg-select" value="@(Source ?? "")" @onchange="OnSource">
                        <option value="">Any source</option>
                        <option value="manual">Manual</option>
                        <option value="event">Scheduled event</option>
                    </select>
                    @if (_loading)
                    {
                        <span class="dg-loading" aria-hidden="true"></span>
                    }
                    @if (_sessionFactor > 1)
                    {
                        <span class="mult-badge" title="A session reward multiplier is active now">⚡ @Mult(_sessionFactor)× active</span>
                    }
                </div>
                @if (_isStaff)
                {
                    <div class="dg-actions">
                        <a class="btn btn-sm" href="@MusterLinks.SessionNew(GuildId)">
                            <span class="material-symbols-outlined">add_circle</span> Start session
                        </a>
                        <a class="btn btn-ghost btn-sm" href="/guilds/@GuildId/participation/export.csv">
                            <span class="material-symbols-outlined">download</span> Export CSV
                        </a>
                    </div>
                }
            </div>

            @if (Message is not null)
            {
                <p class="message dg-message">@Message</p>
            }

            <div class="dg-scroll">
                <table class="dg-table">
                    <thead>
                        <tr>
                            <th class="sortable" @onclick='() => SetSort("name")'>Name @Ind("name")</th>
                            <th class="sortable" @onclick='() => SetSort("status")'>Status @Ind("status")</th>
                            <th>Source</th>
                            <th>Channel</th>
                            <th class="sortable" @onclick='() => SetSort("started")'>Started @Ind("started")</th>
                            <th class="sortable" @onclick='() => SetSort("ended")'>Ended @Ind("ended")</th>
                            <th class="num sortable" @onclick='() => SetSort("attendees")'>Attendees @Ind("attendees")</th>
                            <th class="num sortable" title="In voice now (earning or paused)" @onclick='() => SetSort("present")'>In voice @Ind("present")</th>
                            <th class="num sortable" @onclick='() => SetSort("minutes")'>Minutes @Ind("minutes")</th>
                            <th class="dg-actions-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_grid is null || _grid.Items.Count == 0)
                        {
                            <tr class="dg-empty"><td colspan="10">@(_grid is null ? "Loading…" : "No sessions match these filters.")</td></tr>
                        }
                        else
                        {
                            @foreach (var s in _grid.Items)
                            {
                                <tr>
                                    <td><a href="@MusterLinks.SessionDetail(GuildId, s.Id)">@s.Name</a></td>
                                    <td>
                                        <span class="status-dot @(s.Active ? "is-active" : "is-ended")"></span>
                                        @(s.Active ? "Active" : "Ended")
                                    </td>
                                    <td>@Src(s.Source)</td>
                                    <td><ChannelLabel Id="s.VoiceChannelId" Name="@s.VoiceChannelName" /></td>
                                    <td><LocalTime Value="s.StartedAt" Zone="@_zoneId" /></td>
                                    <td><LocalTime Value="s.EndedAt" Zone="@_zoneId" /></td>
                                    <td class="num">@s.Attendees</td>
                                    <td class="num">@(s.Active ? s.InVoice.ToString() : "—")</td>
                                    <td class="num">@s.TotalMinutes</td>
                                    <td class="dg-actions-col">
                                        <div class="dg-row-actions">
                                            <a class="icon-btn" title="View session" aria-label="View session" href="@MusterLinks.SessionDetail(GuildId, s.Id)">
                                                <span class="material-symbols-outlined">visibility</span>
                                            </a>
                                            @if (_isStaff && s.Active)
                                            {
                                                <button type="button" class="icon-btn danger" title="End session" aria-label="End session"
                                                        disabled="@(_ending == s.Id)" @onclick="() => EndAsync(s.Id)">
                                                    <span class="material-symbols-outlined">stop_circle</span>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="dg-footer">
                <div class="dg-footer-left">
                    <div class="dg-pagesize">
                        Rows
                        <select class="dg-select" value="@SizeNum" @onchange="OnSize">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <span class="dg-tz">times in <LocalTime ShowZone="true" Zone="@_zoneId" /></span>
                </div>
                <div class="dg-pager">
                    <button type="button" class="btn btn-ghost btn-sm" disabled="@(PageNum <= 1)" @onclick="Prev">← Prev</button>
                    <span>Page @PageNum of @TotalPages · @(_grid?.Total ?? 0) total</span>
                    <button type="button" class="btn btn-ghost btn-sm" disabled="@(PageNum >= TotalPages)" @onclick="Next">Next →</button>
                </div>
            </div>
        </TabPane>

        <TabPane Id="leaderboard" Label="Leaderboard" Icon="leaderboard">
            <div class="dg-toolbar">
                <div class="dg-filters">
                    @if (_seasonActive)
                    {
                        <div class="seg" role="group" aria-label="Leaderboard range">
                            <button type="button" class="@(!_lbAllTime ? "active" : "")" @onclick="() => SetLeaderboardBasis(false)">Season</button>
                            <button type="button" class="@(_lbAllTime ? "active" : "")" @onclick="() => SetLeaderboardBasis(true)">All-time</button>
                        </div>
                    }
                    <input type="search" class="dg-search" placeholder="Find member…" @bind="_lbSearch" @bind:event="oninput" @bind:after="DebouncedLeaderboardSearchAsync" />
                </div>
            </div>

            <div class="dg-scroll">
                @if (_lbResult is null || _lbResult.Items.Count == 0)
                {
                    <p class="empty">@(_lbResult is null ? "Loading…" : "No voice activity matches.")</p>
                }
                else
                {
                    <table class="dg-table lb-table">
                        <thead><tr><th class="num lb-rank-col">#</th><th>Member</th><th>Voice time</th></tr></thead>
                        <tbody>
                            @foreach (var row in _lbResult.Items)
                            {
                                <tr class="@(row.UserId == UserId ? "lb-me" : null)">
                                    <td class="num lb-rank">@Medal(row.Rank)</td>
                                    <td><UserChip Name="@row.Name" AvatarUrl="@row.AvatarUrl" Href="@(_isStaff ? MusterLinks.MemberDetail(GuildId, row.UserId) : null)" /></td>
                                    <td><div class="lb-bar" style="--lb-pct:@(row.BarPercent)%"><span>@Dur(row.VoiceMinutes)</span></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @* Keep the viewer visible: a pinned row outside the grid when they're not on the current page. *@
            @if (_meRank > 0 && (_lbResult is null || !_lbResult.Items.Any(r => r.UserId == UserId)))
            {
                <div class="lb-self">
                    <span class="lb-rank num">@_meRank</span>
                    <span class="lb-you">You</span>
                    <span class="lb-self-time">@Dur(_meMinutes)</span>
                </div>
            }

            <div class="dg-footer">
                <span class="dg-tz">@(_lbResult?.Total ?? 0) ranked</span>
                <div class="dg-pager">
                    <button type="button" class="btn btn-ghost btn-sm" disabled="@(LbPage <= 1)" @onclick="LbPrev">← Prev</button>
                    <span>Page @LbPage of @LbTotalPages</span>
                    <button type="button" class="btn btn-ghost btn-sm" disabled="@(LbPage >= LbTotalPages)" @onclick="LbNext">Next →</button>
                </div>
            </div>
        </TabPane>

        @if (_isStaff && _hasBackground)
        {
            <TabPane Id="background" Label="Background" Icon="sensors">
                <div class="dg-toolbar">
                    <div class="dg-filters">
                        <input type="search" class="dg-search" placeholder="Find member…" @bind="_bgSearch" @bind:event="oninput" />
                        @if (_bgFactor > 1)
                        {
                            <span class="mult-badge" title="A background reward multiplier is active now">⚡ @Mult(_bgFactor)× active</span>
                        }
                    </div>
                    <div class="dg-actions">
                        <button type="button" class="icon-btn" title="Refresh" aria-label="Refresh" @onclick="LoadBackgroundAsync">
                            <span class="material-symbols-outlined">refresh</span>
                        </button>
                    </div>
                </div>

                @{ var channels = FilteredBackground(); var present = channels.Sum(c => c.Members.Count); }
                @if (channels.Count > 0)
                {
                    <div class="dg-subhead">
                        <span><strong>@present</strong> present across <strong>@channels.Count</strong> channel@(channels.Count == 1 ? "" : "s")</span>
                    </div>
                }

                <div class="dg-scroll">
                    @if (channels.Count == 0)
                    {
                        <p class="empty">
                            @(_background.Count == 0
                                ? "No one is in a monitored voice channel right now."
                                : "No present member matches that search.")
                            <br />
                            Background tracking runs continuously on channels set to Stats or Reward — configure them on
                            <a href="@MusterLinks.TrackingSettings(GuildId)">Tracking settings</a>.
                        </p>
                    }
                    else
                    {
                        @foreach (var c in channels)
                        {
                            var collapsed = _bgCollapsed.Contains(c.ChannelId);
                            <div class="bg-card">
                                <div class="bg-card-head" role="button" tabindex="0" @onclick="() => ToggleChannel(c.ChannelId)">
                                    <span class="material-symbols-outlined bg-chevron">@(collapsed ? "chevron_right" : "expand_more")</span>
                                    <ChannelLabel Id="c.ChannelId" Name="@c.ChannelName" />
                                    <span class="badge @(c.Mode == TrackedChannelMode.Reward ? "bg-reward" : "bg-stats")">@ModeLabel(c.Mode)</span>
                                    @if (c.Mode == TrackedChannelMode.Reward)
                                    {
                                        <span class="bg-rate">@c.PointsPerMinute pts/min</span>
                                    }
                                    <span class="bg-count">@c.Members.Count present</span>
                                </div>
                                @if (!collapsed)
                                {
                                    <div class="bg-members">
                                        @foreach (var m in c.Members)
                                        {
                                            var (dot, label) = BgStatus(c.Mode, m.Earning);
                                            <div class="bg-member @(m.UserId == UserId ? "lb-me" : null)">
                                                <span class="status-dot @dot" title="@label"></span>
                                                <UserChip Name="@m.Name" AvatarUrl="@m.AvatarUrl" Href="@(_isStaff ? MusterLinks.MemberDetail(GuildId, m.UserId) : null)" />
                                                <span class="bg-member-meta">
                                                    @label · @Dur(m.MinutesToday) today@(m.PointsToday > 0 ? $" · {m.PointsToday} pts" : "")
                                                    @if (m.PresentSince is not null)
                                                    {
                                                        <text> · here since <LocalTime Value="m.PresentSince" Zone="@_zoneId" Pattern="h:mm tt" /></text>
                                                    }
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                <p class="dg-note">Live snapshot of who's present right now — use Refresh to update.</p>
            </TabPane>
        }
    </TabFrame>
}

@code {
    // URL is the source of truth: control changes navigate (updating the query), which re-runs
    // OnParametersSetAsync and reloads. That makes every view shareable/linkable and back-button friendly.
    [SupplyParameterFromQuery] public string? Tab { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Source { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public bool? Desc { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public int? Size { get; set; }

    private bool _isStaff;
    private bool _present;
    private bool _hasBackground;
    private bool _loading;
    private Guid? _ending;
    private string? _appliedKey;
    private string _zoneId = TimeZoneService.Utc;
    private decimal _sessionFactor = 1m;   // active Sessions-scope multiplier (>1 → show the ⚡ badge)
    private decimal _bgFactor = 1m;         // active BackgroundVoice-scope multiplier

    private const int SearchDebounceMs = 350;
    private string? _searchBox;                       // live input value, debounced into the Search query param
    private CancellationTokenSource? _searchDebounce;

    private PagedResult<SessionGridRow>? _grid;
    private IReadOnlyList<BackgroundChannelView> _background = [];
    private string? _bgSearch;
    private readonly HashSet<ulong> _bgCollapsed = [];   // channels the admin has collapsed (by channel id; survives refresh)

    // Leaderboard tab state.
    private const int LbPageSize = 25;
    private PagedResult<VoiceLeaderboardRow>? _lbResult;
    private bool _seasonActive;     // a season is open → the Season/All-time toggle is offered
    private bool _lbAllTime;        // toggle: show all-time instead of the active season
    private string? _lbSearch;
    private int _lbPage = 1;
    private CancellationTokenSource? _lbSearchDebounce;
    private int _meRank;            // viewer's own rank in the current basis (0 = unranked)
    private int _meMinutes;

    private int LbPage => _lbResult?.Page ?? _lbPage;
    private int LbTotalPages => _lbResult?.TotalPages ?? 1;

    // Effective state (query value → typed, with defaults). Non-staff only ever see Active.
    private string CurrentTab => Tab is "leaderboard" or "background" ? Tab : "sessions";
    private SessionStatusFilter StatusFilter => !_isStaff ? SessionStatusFilter.Active : Status switch
    {
        "history" => SessionStatusFilter.Ended,
        "all" => SessionStatusFilter.All,
        _ => SessionStatusFilter.Active,
    };
    private TrackingSessionSource? SourceFilter => Source switch
    {
        "manual" => TrackingSessionSource.Manual,
        "event" => TrackingSessionSource.DiscordScheduledEvent,
        _ => null,
    };
    private string SortKey => string.IsNullOrWhiteSpace(Sort) ? "started" : Sort;
    private bool DescDir => Desc ?? true;
    private int PageNum => Page is > 0 ? Page.Value : 1;
    private int SizeNum => Size is 10 or 25 or 50 or 100 ? Size.Value : 25;
    private int TotalPages => _grid?.TotalPages ?? 1;

    // One-time gate setup (auth + banners); the grid itself loads from the query in OnParametersSetAsync.
    protected override async Task LoadAsync()
    {
        await using var scope = Scopes.CreateAsyncScope();
        var sp = scope.ServiceProvider;
        var auth = sp.GetRequiredService<GuildAuthorizationService>();
        var adminRead = sp.GetRequiredService<Muster.Infrastructure.Services.Web.WebAdminService>();
        var participation = sp.GetRequiredService<ParticipationReadService>();

        _zoneId = await sp.GetRequiredService<TimeZoneService>().ResolveZoneIdAsync(GuildId, UserId);

        var mult = await sp.GetRequiredService<RewardMultiplierService>().LoadAsync(GuildId);
        var now = DateTimeOffset.UtcNow;
        _sessionFactor = mult.Factor(MultiplierScope.Sessions, now);
        _bgFactor = mult.Factor(MultiplierScope.BackgroundVoice, now);

        // Staff = admin OR any management role that has a stake in sessions. Tracking manager runs them;
        // legacy Officer kept for back-compat. The file lives under Tracking/ for routing/nav cohesion only —
        // base class is GuildMemberComponentBase since the read-side roster is open to any member.
        // IsTrackingManagerAsync already covers Admin + the legacy Officer/EventOfficer umbrellas.
        _isStaff = await auth.IsTrackingManagerAsync(GuildId, UserId);
        _hasBackground = _isStaff && await adminRead.HasActiveBackgroundTrackingAsync(GuildId);
        _present = await participation.IsMemberPresentInLiveSessionAsync(GuildId, UserId);
    }

    // Fires on first render (after auth) and on every query change. Reload only when the effective view changed.
    protected override async Task OnParametersSetAsync()
    {
        if (State != AccessState.Ready)
        {
            return;
        }

        // Keep the box in sync with the query (initial load + external/url changes); harmless mid-type since
        // OnParametersSetAsync only runs on navigation, and our debounced search navigates to this same value.
        _searchBox = Search;

        var key = $"{CurrentTab}|{StatusFilter}|{Search}|{Source}|{SortKey}|{DescDir}|{PageNum}|{SizeNum}";
        if (key == _appliedKey)
        {
            return;
        }

        _appliedKey = key;
        await ReloadCurrentAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Notifier.Updated += OnSessionChanged;
        }
    }

    // A live change anywhere in this guild refreshes the current data view (no URL change).
    private void OnSessionChanged(SessionAttendanceChanged change)
    {
        if (State != AccessState.Ready || change.GuildId != GuildId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await ReloadCurrentAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadCurrentAsync()
    {
        switch (CurrentTab)
        {
            case "leaderboard": await LoadLeaderboardAsync(); break;
            case "background" when _isStaff: await LoadBackgroundAsync(); break;
            default: await ReloadSessionsAsync(); break;
        }
    }

    private async Task ReloadSessionsAsync()
    {
        _loading = true;
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            _grid = await scope.ServiceProvider.GetRequiredService<ParticipationReadService>()
                .SessionsPageAsync(GuildId, StatusFilter, Search, SourceFilter, SortKey, DescDir, PageNum, SizeNum);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadLeaderboardAsync()
    {
        await using var scope = Scopes.CreateAsyncScope();
        var sp = scope.ServiceProvider;
        var read = sp.GetRequiredService<ParticipationReadService>();

        _seasonActive = await read.HasActiveSeasonAsync(GuildId);
        // No season → only all-time exists (force it); otherwise honor the toggle.
        bool? seasonal = _seasonActive ? !_lbAllTime : false;

        _lbResult = await read.VoiceLeaderboardPageAsync(GuildId, seasonal, _lbSearch, _lbPage, LbPageSize);
        var me = await read.MemberVoiceRankAsync(GuildId, UserId, seasonal);
        _meRank = me.Rank;
        _meMinutes = me.Minutes;
    }

    private async Task SetLeaderboardBasis(bool allTime)
    {
        _lbAllTime = allTime;
        _lbPage = 1;
        await LoadLeaderboardAsync();
    }

    private async Task DebouncedLeaderboardSearchAsync()
    {
        _lbSearchDebounce?.Cancel();
        var cts = _lbSearchDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchDebounceMs, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (!cts.IsCancellationRequested)
        {
            _lbPage = 1;
            await LoadLeaderboardAsync();
            StateHasChanged();
        }
    }

    private async Task LbPrev()
    {
        if (LbPage > 1)
        {
            _lbPage = LbPage - 1;
            await LoadLeaderboardAsync();
        }
    }

    private async Task LbNext()
    {
        if (LbPage < LbTotalPages)
        {
            _lbPage = LbPage + 1;
            await LoadLeaderboardAsync();
        }
    }

    private async Task LoadBackgroundAsync()
    {
        await using var scope = Scopes.CreateAsyncScope();
        _background = await scope.ServiceProvider.GetRequiredService<ParticipationReadService>().BackgroundNowAsync(GuildId);
    }

    // Client-side member filter over the (small) live snapshot — channels with no matching members drop out.
    private IReadOnlyList<BackgroundChannelView> FilteredBackground()
    {
        if (string.IsNullOrWhiteSpace(_bgSearch))
        {
            return _background;
        }

        var q = _bgSearch.Trim();
        return _background
            .Select(c => c with { Members = c.Members.Where(m => m.Name.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList() })
            .Where(c => c.Members.Count > 0)
            .ToList();
    }

    private void ToggleChannel(ulong channelId)
    {
        if (!_bgCollapsed.Add(channelId))
        {
            _bgCollapsed.Remove(channelId);
        }
    }

    private static string ModeLabel(TrackedChannelMode mode) => mode == TrackedChannelMode.Reward ? "Reward" : "Stats";

    // Per-member status: green = earning reward; amber = present but paused (reward channel, not eligible);
    // blue = a stats-only channel (tracked, never pays).
    private static (string Dot, string Label) BgStatus(TrackedChannelMode mode, bool earning) => mode switch
    {
        TrackedChannelMode.Reward when earning => ("is-active", "earning"),
        TrackedChannelMode.Reward => ("is-paused", "paused"),
        _ => ("is-stats", "stats"),
    };

    // ---- Control handlers: each rewrites the query; defaults are omitted to keep links clean. ----

    private void OnTab(string tab) => Apply(("tab", tab == "sessions" ? null : tab));

    private void OnStatus(SessionStatusFilter status)
    {
        var token = status switch { SessionStatusFilter.Ended => "history", SessionStatusFilter.All => "all", _ => (string?)null };
        Apply(("status", token), ("page", null));
    }

    // Filter-as-you-type: each keystroke updates _searchBox; we wait for a typing pause, then navigate
    // (replace:true so a search doesn't bury the page in back-button history).
    private async Task DebouncedSearchAsync()
    {
        _searchDebounce?.Cancel();
        var cts = _searchDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchDebounceMs, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return; // superseded by a later keystroke
        }

        if (!cts.IsCancellationRequested)
        {
            Apply(replace: true, ("search", _searchBox), ("page", null));
        }
    }

    private void OnSource(ChangeEventArgs e) => Apply(("source", e.Value as string), ("page", null));

    private void OnSize(ChangeEventArgs e)
    {
        var size = int.TryParse(e.Value as string, out var v) ? v : 25;
        Apply(("size", size == 25 ? (int?)null : size), ("page", null));
    }

    private void SetSort(string column)
    {
        var desc = SortKey == column ? !DescDir : true; // re-clicking the active column flips direction
        Apply(
            ("sort", column == "started" ? null : column),
            ("desc", desc ? (bool?)null : false),
            ("page", null));
    }

    private void Prev() { if (PageNum > 1) Apply(("page", PageNum - 1 == 1 ? (int?)null : PageNum - 1)); }

    private void Next() { if (PageNum < TotalPages) Apply(("page", PageNum + 1)); }

    private void Apply(params (string Key, object? Value)[] changes) => Apply(replace: false, changes);

    private void Apply(bool replace, params (string Key, object? Value)[] changes)
    {
        var dict = new Dictionary<string, object?>();
        foreach (var (key, value) in changes)
        {
            dict[key] = value is string s && string.IsNullOrWhiteSpace(s) ? null : value;
        }

        Nav.NavigateTo(Nav.GetUriWithQueryParameters(dict), forceLoad: false, replace: replace);
    }

    private async Task EndAsync(Guid sessionId)
    {
        if (_ending is not null || !_isStaff)
        {
            return;
        }

        _ending = sessionId;
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            var sp = scope.ServiceProvider;

            // The command service does the auth check, snapshots metadata, closes, and returns the snapshot so we
            // can audit + render confirmation without ever touching MusterDbContext from the UI.
            var result = await sp.GetRequiredService<Muster.Infrastructure.Commands.Tracking.TrackingCommandService>()
                .StopAsync(GuildId, UserId, sessionId);

            if (result.IsError)
            {
                Message = result.Message;
                return;
            }

            var info = result.Value!;
            await sp.GetRequiredService<AuditService>().RecordSessionStoppedAsync(
                GuildId, UserId, info.Id, info.Name, info.VoiceChannelId, info.VoiceChannelName);

            Message = "Session ended and attendance awarded.";

            // If the session was gated by a muster, report how the coin landed (earned vs skipped for no check-in).
            var gate = await sp.GetRequiredService<Muster.Infrastructure.Services.Musters.IMusterReadService>()
                .SessionGateSummaryAsync(GuildId, sessionId);
            if (gate is { HasGate: true })
            {
                Message += $" Coin: {gate.CoinEligible}/{gate.Attendees} attendee(s) earned it, {gate.Skipped} skipped (not checked in).";
            }
        }
        finally
        {
            _ending = null;
            await ReloadSessionsAsync();
        }
    }

    public void Dispose()
    {
        Notifier.Updated -= OnSessionChanged;
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _lbSearchDebounce?.Cancel();
        _lbSearchDebounce?.Dispose();
    }

    private static string Src(TrackingSessionSource s) => s == TrackingSessionSource.DiscordScheduledEvent ? "Scheduled event" : "Manual";

    private static string Dur(int minutes)
    {
        var h = minutes / 60;
        var m = minutes % 60;
        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }

    private static string Medal(int rank) => rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => rank.ToString() };

    private static string Mult(decimal factor) => factor.ToString("0.##");

    private string Ind(string column) => SortKey == column ? (DescDir ? "▼" : "▲") : "";
}
