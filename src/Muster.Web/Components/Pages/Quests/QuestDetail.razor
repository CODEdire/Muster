@page "/guilds/{GuildIdRaw}/quests/{QuestId}"
@layout GuildLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits GuildMemberComponentBase
@implements IDisposable
@inject IServiceScopeFactory Scopes
@inject IQuestAuthorizer Authorizer
@inject Muster.Web.Live.IQuestUpdateNotifier Notifier
@using Muster.Contracts
@using Muster.Domain
@using Muster.Domain.Entities
@using Muster.Domain.Enums
@using Muster.Infrastructure.Commands
@using Muster.Infrastructure.Services.Platform
@using Muster.Infrastructure.Services.Quests

<PageTitle>@(_quest?.Name ?? "Quest") — Muster</PageTitle>

@if (State == AccessState.Forbidden)
{
    <div class="panel glass empty">You don't have access to this server.</div>
}
else if (State == AccessState.Ready && !_gate.CanEnable)
{
    <FeatureGateNotice Verdict="_gate" Feature="Quests" />
}
else if (State == AccessState.Ready)
{
    <TopProgress Active="@(_loading || _acting)" />

    @if (Message is not null)
    {
        <div class="notice" role="status">
            <span class="material-symbols-outlined notice-icon">info</span>
            <span class="notice-text">@Message</span>
            <button type="button" class="icon-btn notice-close" title="Dismiss" aria-label="Dismiss" @onclick="() => Message = null"><span class="material-symbols-outlined">close</span></button>
        </div>
    }

    @if (_quest is null)
    {
        <div class="panel glass empty">Quest not found. <a href="/guilds/@GuildId/quests">Back to quests</a></div>
    }
    else
    {
        var q = _quest;
        var iAmOwner = q.OwnerId == UserId;
        // Prefer an active/decided row over a Released (abandoned) one so a re-claim leaves the old slot inert.
        var myPart = q.Participants.FirstOrDefault(p => p.UserId == UserId && p.Status != QuestParticipantStatus.Released)
            ?? q.Participants.FirstOrDefault(p => p.UserId == UserId);
        var hasSubmitter = q.Participants.Any(p => p.Status == QuestParticipantStatus.Submitted);
        var isPersonal = q.Origin == QuestOrigin.Player;
        var completed = q.Participants.Count(p => p.Status == QuestParticipantStatus.Approved);

        <PageHeader Crumbs="@(new PageHeader.Crumb[] { new("Quests", $"/guilds/{GuildId}/quests"), new(q.Name) })" />

        <header class="sess-head full-bleed">
            <div class="sess-title">
                @if (q.Tier != QuestTier.None)
                {
                    <span class="tier-badge tier-@q.Tier" title="Difficulty @q.Tier · +@q.BonusPoints bonus points">@q.Tier</span>
                }
                <h1>@q.Name</h1>
                <span class="chip @(isPersonal ? "chip-player" : "chip-quest")">@(isPersonal ? "Player" : "Guild")</span>
                <span class="chip @StatusClass(q.Status)">@StatusLabel(q.Status)</span>
            </div>

            <div class="sess-meta">
                <span>
                    <span class="material-symbols-outlined">@(isPersonal ? "person" : "shield")</span>
                    @if (isPersonal)
                    {
                        <text>issued by </text><UserChip Name="@q.OwnerName" AvatarUrl="@q.OwnerAvatar" Href="@(_isStaff ? MusterLinks.MemberDetail(GuildId, q.OwnerId) : null)" />
                    }
                    else
                    {
                        <text>Guild-issued</text>
                    }
                </span>
                <span><span class="material-symbols-outlined">groups</span>@completed / @q.Capacity completed</span>
                <span><span class="material-symbols-outlined">event_available</span>posted <LocalTime Value="q.CreatedAt" /></span>
                @if (q.ScheduledStart is not null)
                {
                    <span><span class="material-symbols-outlined">schedule</span>opens <LocalTime Value="q.ScheduledStart" /></span>
                }
                <span><span class="material-symbols-outlined">timer</span>closes <LocalTime Value="q.Deadline" Empty="no expiry" /></span>
            </div>
        </header>

        @* Reward + quest-level actions strip — sits between the header's bottom border and the detail panels. *@
        // A Released slot (abandoned / idle-timeout) doesn't bar a re-claim — only an active claim or a final verdict
        // (Approved/Rejected) does, matching the server's ClaimAsync rule.
        var canClaim = q.Status == QuestStatus.Open
            && !q.Participants.Any(p => p.UserId == UserId && p.Status is QuestParticipantStatus.Claimed
                or QuestParticipantStatus.Submitted or QuestParticipantStatus.RevisionRequested
                or QuestParticipantStatus.Approved or QuestParticipantStatus.Rejected)
            && (!isPersonal || !iAmOwner || _settings.AllowSelfParticipation);
        var canIntake = CanIntake(q);
        var canFinalize = CanFinalize(q);
        var canArbitrate = CanArbitrate(q, iAmOwner, myPart);
        var canCancel = CanCancel(q);
        var canEdit = q.Status is QuestStatus.Open or QuestStatus.Scheduled or QuestStatus.PendingApproval
            && !q.Participants.Any(p => p.Status is QuestParticipantStatus.Claimed or QuestParticipantStatus.Submitted
                or QuestParticipantStatus.RevisionRequested or QuestParticipantStatus.Approved)
            && Can(QuestPermission.Edit);
        var hasToolbar = canClaim || canIntake || canFinalize || canArbitrate || canCancel || canEdit;
        <div class="quest-strip">
            <div class="quest-strip-reward">
                <span class="qc-reward @(q.RewardCode.Equals("POINTS", StringComparison.OrdinalIgnoreCase) ? "reward-points" : "reward-coin")">
                    +@q.RewardAmount @q.RewardCode
                    @if (isPersonal)
                    {
                        <span class="material-symbols-outlined esc-lock" title="Reward held in escrow">lock</span>
                    }
                </span>
                @if (q.BonusPoints > 0)
                {
                    <span class="subtitle">+@q.BonusPoints pts bonus</span>
                }
            </div>
            @if (hasToolbar)
            {
                <div class="quest-strip-actions">
                    @if (canIntake)
                    {
                        <select class="tier-select" value="@_intakeTier" @onchange="e => _intakeTier = Enum.TryParse<QuestTier>(e.Value as string, out var t) ? t : QuestTier.None">
                            <option value="@QuestTier.None">No tier (0 pts)</option>
                            @foreach (var t in _tiers)
                            {
                                <option value="@t">@t (@_settings.PointsForTier(t) pts)</option>
                            }
                        </select>
                        @if (_settings.FinalApprovalMode == FinalApprovalMode.ApproverChoice)
                        {
                            <label class="checkbox"><input type="checkbox" checked="@_intakeFinal" @onchange="e => _intakeFinal = e.Value is true" /> final sign-off</label>
                        }
                        <button type="button" class="btn btn-sm" disabled="@_acting" @onclick='() => ActAsync("accept", null)'>@if (IsSpinning("accept")) { @Spinner() } else { <span class="material-symbols-outlined">thumb_up</span> } Accept &amp; open</button>
                        <button type="button" class="btn btn-sm btn-danger" disabled="@_acting" @onclick='() => ActAsync("reject-intake", null)'>@if (IsSpinning("reject-intake")) { @Spinner() } else { <span class="material-symbols-outlined">thumb_down</span> } Reject intake</button>
                    }
                    @if (canFinalize)
                    {
                        <button type="button" class="btn btn-sm" disabled="@_acting" @onclick='() => ActAsync("finalize-pay", null)'>@if (IsSpinning("finalize-pay")) { @Spinner() } else { <span class="material-symbols-outlined">paid</span> } Pay completer</button>
                        <button type="button" class="btn btn-sm btn-warn" disabled="@_acting" @onclick='() => ActAsync("finalize-refund", null)'>@if (IsSpinning("finalize-refund")) { @Spinner() } else { <span class="material-symbols-outlined">undo</span> } Refund owner</button>
                    }
                    @if (canArbitrate)
                    {
                        <button type="button" class="btn btn-sm" disabled="@_acting" @onclick='() => ActAsync("resolve-pay", null)'>@if (IsSpinning("resolve-pay")) { @Spinner() } else { <span class="material-symbols-outlined">paid</span> } Pay completer</button>
                        <button type="button" class="btn btn-sm btn-warn" disabled="@_acting" @onclick='() => ActAsync("resolve-refund", null)'>@if (IsSpinning("resolve-refund")) { @Spinner() } else { <span class="material-symbols-outlined">undo</span> } Refund owner</button>
                    }
                    @if (canClaim)
                    {
                        <button type="button" class="btn btn-sm" disabled="@_acting" @onclick='() => ActAsync("claim", null)'>@if (IsSpinning("claim")) { @Spinner() } else { <span class="material-symbols-outlined">add_task</span> } Claim</button>
                    }
                    @if (canEdit)
                    {
                        <a class="btn btn-sm btn-warn" href="/guilds/@GuildId/quests/@q.Id/edit"><span class="material-symbols-outlined">edit</span> Edit</a>
                    }
                    @if (canCancel)
                    {
                        <button type="button" class="btn btn-sm btn-danger" disabled="@_acting" @onclick='() => ActAsync("cancel", null)'>@if (IsSpinning("cancel")) { @Spinner() } else { <span class="material-symbols-outlined">delete</span> } Cancel</button>
                    }
                </div>
            }
        </div>

        @if (q.Status == QuestStatus.Disputed && q.DisputedByName is { } dn)
        {
            <div class="notice notice-warn" role="status">
                <span class="material-symbols-outlined notice-icon">gavel</span>
                <span class="notice-text">
                    Disputed by <b>@dn</b> — awaiting manager arbitration.
                    @if (!string.IsNullOrWhiteSpace(q.DisputeReason))
                    {
                        <br /><span class="muted">Reason: @q.DisputeReason</span>
                    }
                </span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(q.Description))
        {
            <article class="panel glass quest-desc-card @(q.Tier != QuestTier.None ? $"tier-accent tier-edge-{q.Tier}" : "")">
                <div class="detail-desc markdown">@DiscordMarkdown.ToHtml(q.Description)</div>
            </article>
        }

        @if (q.Participants.Count > 0)
        {
            <section class="panel glass">
                <div class="panel-head"><h2>Participants</h2><span class="subtitle">@q.Participants.Count total</span></div>
                <ul class="participant-list">
                    @foreach (var p in q.Participants)
                    {
                        var pid = p.UserId;
                        var isMine = p.UserId == UserId;
                        var canReview = _isManager && !isPersonal && q.Status == QuestStatus.Open && p.Status == QuestParticipantStatus.Submitted;
                        var canReopen = _isManager && !isPersonal && q.Status == QuestStatus.Open && p.Status == QuestParticipantStatus.Rejected;
                        var canRelease = _isManager && q.Status == QuestStatus.Open && !isMine
                            && p.Status is QuestParticipantStatus.Claimed or QuestParticipantStatus.Submitted or QuestParticipantStatus.RevisionRequested;
                        var canSubmit = isMine && q.Status == QuestStatus.Open
                            && p.Status is QuestParticipantStatus.Claimed or QuestParticipantStatus.RevisionRequested;
                        var canAbandon = isMine && q.Status == QuestStatus.Open
                            && p.Status is QuestParticipantStatus.Claimed or QuestParticipantStatus.Submitted or QuestParticipantStatus.RevisionRequested;
                        var canOwnerReview = isPersonal && iAmOwner && q.Status == QuestStatus.Open
                            && p.Status == QuestParticipantStatus.Submitted;
                        <li class="p-row @(p.UserId == UserId ? "lb-me" : null)">
                            <span class="p-identity">
                                <UserChip Name="@p.Name" AvatarUrl="@p.AvatarUrl" Href="@(_isStaff ? MusterLinks.MemberDetail(GuildId, p.UserId) : null)" />
                                <span class="chip @ParticipantChip(p.Status)">@ParticipantLabel(p.Status)</span>
                                @if (p.ReviewedByName is { } rb)
                                {
                                    <span class="roster-by">reviewed by @rb</span>
                                }
                            </span>

                            @if (p.Note is { Length: > 0 } note)
                            {
                                <span class="p-note p-note-self">“@note”</span>
                            }
                            @if (p.ReviewNote is { Length: > 0 } rn)
                            {
                                <span class="p-note p-note-review"><span class="material-symbols-outlined">subdirectory_arrow_right</span>@rn</span>
                            }

                            @if (canSubmit || canAbandon || canOwnerReview || canReview || canReopen || canRelease)
                            {
                                <span class="p-actions">
                                    @* My own claim: optional note (for submit), then Submit/Resubmit + Abandon. *@
                                    @if (canSubmit)
                                    {
                                        <input class="note-input p-note-input" placeholder="submission note (optional)" value="@_questNote" @oninput="e => _questNote = e.Value as string ?? string.Empty" />
                                        <button type="button" title="@(p.Status == QuestParticipantStatus.RevisionRequested ? "Resubmit" : "Submit")" aria-label="Submit" disabled="@_acting" class="icon-btn primary" @onclick='() => ActAsync("submit", null)'><span class="material-symbols-outlined @(IsSpinning("submit") ? "spin" : null)">@(IsSpinning("submit") ? "progress_activity" : "send")</span></button>
                                    }
                                    @if (canAbandon)
                                    {
                                        <button type="button" title="Abandon this claim" aria-label="Abandon" disabled="@_acting" class="icon-btn warn" @onclick='() => ActAsync("abandon", null)'><span class="material-symbols-outlined @(IsSpinning("abandon") ? "spin" : null)">@(IsSpinning("abandon") ? "progress_activity" : "exit_to_app")</span></button>
                                    }

                                    @* Personal-quest owner reviewing this submitter. *@
                                    @if (canOwnerReview)
                                    {
                                        <input class="note-input p-note-input" placeholder="note to taker (optional)" value="@_questNote" @oninput="e => _questNote = e.Value as string ?? string.Empty" />
                                        <button type="button" title="Confirm &amp; pay" aria-label="Confirm and pay" disabled="@_acting" class="icon-btn success" @onclick='() => ActAsync("confirm", null)'><span class="material-symbols-outlined @(IsSpinning("confirm") ? "spin" : null)">@(IsSpinning("confirm") ? "progress_activity" : "paid")</span></button>
                                        <button type="button" title="Request revision" aria-label="Request revision" disabled="@_acting" class="icon-btn warn" @onclick='() => ActAsync("revise", null)'><span class="material-symbols-outlined @(IsSpinning("revise") ? "spin" : null)">@(IsSpinning("revise") ? "progress_activity" : "rate_review")</span></button>
                                        <button type="button" title="Dispute" aria-label="Dispute" disabled="@_acting" class="icon-btn danger" @onclick='() => ActAsync("dispute", null)'><span class="material-symbols-outlined @(IsSpinning("dispute") ? "spin" : null)">@(IsSpinning("dispute") ? "progress_activity" : "gavel")</span></button>
                                    }

                                    @* Guild-quest manager review on a submitter. *@
                                    @if (canReview)
                                    {
                                        <input class="note-input p-note-input" placeholder="feedback (optional)"
                                               value="@_participantNotes.GetValueOrDefault(pid, "")"
                                               @oninput="e => _participantNotes[pid] = e.Value as string ?? string.Empty" />
                                        <button type="button" title="Approve" aria-label="Approve" disabled="@_acting" class="icon-btn success" @onclick='() => ActAsync($"approve:{pid}", pid)'><span class="material-symbols-outlined @(IsSpinning($"approve:{pid}") ? "spin" : null)">@(IsSpinning($"approve:{pid}") ? "progress_activity" : "thumb_up")</span></button>
                                        <button type="button" title="Request revision" aria-label="Request revision" disabled="@_acting" class="icon-btn warn" @onclick='() => ActAsync($"revise:{pid}", pid)'><span class="material-symbols-outlined @(IsSpinning($"revise:{pid}") ? "spin" : null)">@(IsSpinning($"revise:{pid}") ? "progress_activity" : "rate_review")</span></button>
                                        <button type="button" title="Reject" aria-label="Reject" disabled="@_acting" class="icon-btn danger" @onclick='() => ActAsync($"reject:{pid}", pid)'><span class="material-symbols-outlined @(IsSpinning($"reject:{pid}") ? "spin" : null)">@(IsSpinning($"reject:{pid}") ? "progress_activity" : "thumb_down")</span></button>
                                    }
                                    @if (canReopen)
                                    {
                                        <button type="button" title="Reopen for review" aria-label="Reopen" disabled="@_acting" class="icon-btn" @onclick='() => ActAsync($"reopen:{pid}", pid)'><span class="material-symbols-outlined @(IsSpinning($"reopen:{pid}") ? "spin" : null)">@(IsSpinning($"reopen:{pid}") ? "progress_activity" : "replay")</span></button>
                                    }
                                    @if (canRelease)
                                    {
                                        <button type="button" title="Release this claim" aria-label="Release" disabled="@_acting" class="icon-btn warn" @onclick='() => ActAsync($"release:{pid}", pid)'><span class="material-symbols-outlined @(IsSpinning($"release:{pid}") ? "spin" : null)">@(IsSpinning($"release:{pid}") ? "progress_activity" : "person_remove")</span></button>
                                    }
                                </span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    }
}

@code {
    // Must stay in the .razor — uses Razor template syntax, which a code-behind (.razor.cs) can't express.
    private RenderFragment Spinner() => @<span class="material-symbols-outlined spin">progress_activity</span>;
}
