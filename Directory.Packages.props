<Project>

  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.3.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.Sql" Version="13.3.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="13.3.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.KeyVault" Version="13.3.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppConfiguration" Version="13.3.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="13.3.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.3.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.3.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.SignalR" Version="13.3.5" />
    <!-- Aspire client integrations: pull secrets from KV + dynamic config from AC + DP key blob client. -->
    <PackageVersion Include="Aspire.Azure.Security.KeyVault" Version="13.3.5" />
    <PackageVersion Include="Aspire.Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="13.3.5" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.3.5" />
    <!-- Third-party: emulator UI sidecar (peek/send/receive) by Andrew Poole. Run-mode-only. -->
    <PackageVersion Include="AJP.Aspire.Hosting.AsbEmulatorUi" Version="1.0.24" />
    <PackageVersion Include="Aspire.Hosting.DevTunnels" Version="13.3.5" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.3.5" />
  </ItemGroup>

  <ItemGroup Label="ServiceDefaults">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <!-- Azure Monitor OTEL exporter — fed by APPLICATIONINSIGHTS_CONNECTION_STRING in publish. -->
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup Label="Feature management">
    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.8" />
    <!-- Azure-backed Data Protection: blob storage for the key ring + Key Vault key to wrap them at rest. -->
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.4.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup Label="Messaging (Wolverine)">
    <PackageVersion Include="WolverineFx" Version="6.0.1" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.0.1" />
    <PackageVersion Include="WolverineFx.Http" Version="6.0.1" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.0.1" />
    <PackageVersion Include="WolverineFx.SqlServer" Version="6.0.1" />
    <PackageVersion Include="WolverineFx.AzureServiceBus" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup Label="Discord (NetCord)">
    <PackageVersion Include="NetCord" Version="1.0.0-alpha.490" />
    <PackageVersion Include="NetCord.Hosting" Version="1.0.0-alpha.490" />
    <PackageVersion Include="NetCord.Hosting.Services" Version="1.0.0-alpha.490" />
    <PackageVersion Include="NetCord.Services" Version="1.0.0-alpha.490" />
  </ItemGroup>

  <ItemGroup Label="Web / Auth">
    <PackageVersion Include="AspNet.Security.OAuth.Discord" Version="10.0.0" />
    <PackageVersion Include="Markdig" Version="0.41.3" />
    <!-- Azure SignalR Service backplane for the Blazor interactive circuit (production scale-out; UAT runs in-process). -->
    <PackageVersion Include="Microsoft.Azure.SignalR" Version="1.33.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.12.0" />
  </ItemGroup>

</Project>
